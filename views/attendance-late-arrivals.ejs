<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Late Arrivals | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>
<body>
    <% if (viewMode === 'admin') { %>
    <nav class="nav-bar">
        <a href="<%= viewMode === 'admin' ? '/admin' : '/staff' %>" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128101; Staff Directory</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/attendance" class="nav-btn primary">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
    </nav>
    <% } else { %>
    <nav class="nav-bar">
        <a href="/staff" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/attendance" class="nav-btn primary">&#128203; Attendance</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="admin">
            <button class="nav-btn" style="cursor:pointer;">&#128274; Admin View</button>
        </form>
    </nav>
    <% } %>

    <div class="container-lg">
        <header class="page-header">
            <a href="/attendance?date=<%= date %>" class="back-link">&#8592; Attendance</a>
            <span class="pipe-sep">|</span>
            <div>
                <h1>&#9888; Late Arrivals &amp; Departures</h1>
                <p>Campers marked absent this morning. Check them in when they arrive.</p>
            </div>
            <a href="/attendance/dismissal-archive?date=<%= date %>" class="btn btn-small" style="margin-left:auto; background:#f1f5f9;">&#128203; Daily Log</a>
        </header>

        <div class="date-bar">
            <label for="datePicker">Date:</label>
            <input type="date" id="datePicker" value="<%= date %>"
                   onchange="window.location='/attendance/late-arrivals?date='+this.value">
        </div>

        <div class="late-card table-scroll">
            <div class="empty-state" id="emptyState" style="<%= roster.length > 0 ? 'display:none;' : '' %>">
                <span style="font-size: 2.5rem;">&#10003;</span>
                <p style="font-weight: 600; margin-top: 10px;">No late arrivals for this date.</p>
                <p style="font-size: 0.875rem;">All campers marked absent this morning have checked in, or no morning attendance has been taken yet.</p>
            </div>
            <% if (roster.length > 0) { %>
                <table class="late-table" id="lateTable">
                    <thead>
                        <tr>
                            <th>Camper</th>
                            <th>Group</th>
                            <th>Schedule</th>
                            <th style="text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% roster.forEach(function(c) {
                            const isLate = c.AttendanceStatus === 'late';
                        %>
                        <tr class="late-row<%= isLate ? ' arrived' : '' %>"
                            data-status="<%= c.AttendanceStatus %>"
                            data-checkin="<%= isLate && c.CheckInTime ? c.CheckInTime : '' %>">
                            <td>
                                <a href="/search?name=<%= encodeURIComponent(c.FirstName+' '+c.LastName) %>"
                                   class="camper-name-link">
                                    <%= c.FirstName %> <%= c.LastName %>
                                </a>
                            </td>
                            <td><span class="tag <%= c.HomeGroupColor %>"><%= c.HomeGroupColor %></span></td>
                            <td>
                                <div class="sched-mini">
                                    <% c.schedule.forEach(function(s) { %>
                                        <span class="sched-pill">P<%= s.PeriodNumber %>: <%= s.ActivityName %></span>
                                    <% }); %>
                                    <% if (c.schedule.length === 0) { %>
                                        <span style="color:var(--text-muted); font-size:0.8rem;">No schedule</span>
                                    <% } %>
                                </div>
                            </td>
                            <td style="text-align:right;">
                                <% if (isLate) { %>
                                    <span style="color:#15803d; font-weight:600; font-size:0.875rem;">&#10003; Arrived</span>
                                <% } else { %>
                                    <form action="/attendance/check-in" method="POST" style="display:inline;">
                                        <input type="hidden" name="date" value="<%= date %>">
                                        <input type="hidden" name="camperId" value="<%= c.CamperID %>">
                                        <button type="submit" class="btn-checkin">&#10003; Check In</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>

        <script>
        (function () {
            // Period end cutoffs in minutes from midnight EDT (UTC-4, summer)
            // A "late" row is hidden once the period it was checked into has ended for all groups.
            // Boundaries: block 1 ends 10:35, blocks 2/3 end 13:00, block 4 ends 14:40, rest end 16:05
            var CUTOFFS = [635, 780, 880, 965]; // 10:35, 13:00, 14:40, 16:05

            function edtMinsNow() {
                var d = new Date();
                return (d.getUTCHours() * 60 + d.getUTCMinutes() - 240 + 1440) % 1440;
            }

            function checkInEDTMins(checkInStr) {
                // checkInStr is SQLite CURRENT_TIMESTAMP: "YYYY-MM-DD HH:MM:SS" in UTC
                if (!checkInStr) return null;
                var parts = checkInStr.match(/(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2})/);
                if (!parts) return null;
                var utcH = parseInt(parts[4], 10);
                var utcM = parseInt(parts[5], 10);
                return (utcH * 60 + utcM - 240 + 1440) % 1440;
            }

            function periodEndFor(checkInMins) {
                for (var i = 0; i < CUTOFFS.length; i++) {
                    if (checkInMins < CUTOFFS[i]) return CUTOFFS[i];
                }
                return CUTOFFS[CUTOFFS.length - 1];
            }

            function applyVisibility() {
                var nowMins = edtMinsNow();
                var rows = document.querySelectorAll('tr.late-row.arrived');
                var anyVisible = document.querySelectorAll('tr.late-row:not(.arrived)').length > 0;

                rows.forEach(function (row) {
                    var checkIn = checkInEDTMins(row.dataset.checkin);
                    if (checkIn === null) return;
                    var endMins = periodEndFor(checkIn);
                    if (nowMins >= endMins) {
                        row.style.display = 'none';
                    } else {
                        anyVisible = true;
                    }
                });

                var empty = document.getElementById('emptyState');
                if (empty) empty.style.display = anyVisible ? 'none' : '';

                var table = document.getElementById('lateTable');
                if (table) {
                    var visibleRows = table.querySelectorAll('tr.late-row:not([style*="display: none"]):not([style*="display:none"])');
                    if (visibleRows.length === 0 && empty) empty.style.display = '';
                }
            }

            applyVisibility();
            setInterval(applyVisibility, 30000);
        })();
        </script>

        <% if (dismissed && dismissed.length > 0) { %>
        <h2 style="margin:32px 0 12px; font-size:1.1rem;">&#128663; Early Dismissals</h2>
        <div class="late-card table-scroll">
            <table class="late-table">
                <thead>
                    <tr>
                        <th>Camper</th>
                        <th>Group</th>
                        <th>Time</th>
                        <th>Notes</th>
                        <th>Dismissed By</th>
                        <th style="text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% dismissed.forEach(function(d) { %>
                    <tr>
                        <td><a href="/search?name=<%= encodeURIComponent(d.FirstName+' '+d.LastName) %>" class="camper-name-link"><%= d.FirstName %> <%= d.LastName %></a></td>
                        <td><span class="tag <%= d.HomeGroupColor %>"><%= d.HomeGroupColor %></span></td>
                        <td><%= d.DismissalTime || '—' %></td>
                        <td style="color:var(--text-muted); font-size:0.85rem;"><%= d.Notes || '' %></td>
                        <td style="font-size:0.85rem;"><%= d.MarkedBy || '—' %></td>
                        <td style="text-align:right;">
                            <form action="/attendance/dismissal-undo" method="POST" style="display:inline;"
                                  onsubmit="return confirm('Check <%= d.FirstName %> <%= d.LastName %> back in?')">
                                <input type="hidden" name="date" value="<%= date %>">
                                <input type="hidden" name="camperId" value="<%= d.CamperID %>">
                                <button type="submit" class="btn-checkin" style="background:#dcfce7; color:#15803d; border-color:#86efac;">&#8617; Back In</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>
    </div>
</body>
</html>
