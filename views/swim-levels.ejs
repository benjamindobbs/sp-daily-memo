<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Swim Levels | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>
<body>

    <nav class="nav-bar">
        <a href="/admin" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/swim-levels" class="nav-btn primary">&#127946; Swim Levels</a>
        <a href="/swim-scheduling" class="nav-btn">&#127946; Swim Scheduling</a>
    </nav>

    <div class="container-md">

        <div class="page-header" style="margin-bottom: 20px;">
            <div>
                <h1 style="margin:0;">Swim Levels</h1>
                <p class="text-muted" style="margin:4px 0 0;">Campers enrolled in Rec Swim or Swim Lessons — <strong><%= weekLabel %></strong>. Editing here only changes the level starting this week; earlier weeks keep whatever was recorded at the time.</p>
            </div>
        </div>

        <% if (message) { %>
            <div class="alert" style="<%= message.includes('saved') ? '' : 'background:#fee2e2; color:#991b1b; border-color:#fca5a5;' %>">
                <%= message.replace(/\+/g, ' ') %>
            </div>
        <% } %>

        <div class="card" style="margin-bottom: 16px;">
            <input type="text" id="swimmerSearch" placeholder="&#128269; Filter by name..." onkeyup="filterSwimmers()"
                style="width:100%; padding:10px 12px; border:1px solid var(--border-color); border-radius:8px; font-family:inherit; font-size:0.9rem; box-sizing:border-box;">
        </div>

        <% const totalCampers = groups.reduce((n, g) => n + g.campers.length, 0); %>
        <% if (totalCampers === 0) { %>
            <p class="card" style="text-align:center; color:var(--text-muted);">No campers enrolled in Rec Swim or Swim Lessons this week.</p>
        <% } %>

        <% groups.forEach(function(g) { %>
        <div class="card swim-group" style="padding:0; overflow:hidden; margin-bottom:16px;">
            <div style="padding:10px 14px; background:#f8fafc; border-bottom:2px solid var(--border-color); font-weight:700; font-size:0.85rem;">
                <%= g.activityName %> <span style="color:var(--text-muted); font-weight:600;">— Period <%= g.period %></span>
                <span style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">(<%= g.campers.length %>)</span>
            </div>
            <table style="width:100%; border-collapse:collapse; font-size:0.88rem;">
                <thead>
                    <tr style="border-bottom:1px solid var(--border-color);">
                        <th style="text-align:left; padding:8px 14px; font-size:0.72rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Camper</th>
                        <th style="text-align:left; padding:8px 14px; font-size:0.72rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Current Level</th>
                        <th style="text-align:left; padding:8px 14px; font-size:0.72rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Set Level</th>
                    </tr>
                </thead>
                <tbody>
                    <% g.campers.forEach(function(r) { %>
                    <tr class="swimmer-row" data-name="<%= (r.FirstName + ' ' + r.LastName).toLowerCase() %>" style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:8px 14px; font-weight:600;"><%= r.FirstName %> <%= r.LastName %></td>
                        <td style="padding:8px 14px;">
                            <% if (r.level) { %>
                                <span style="background:#dbeafe; color:#1e40af; border-radius:12px; padding:2px 10px; font-size:0.8rem; font-weight:700;"><%= r.level %></span>
                                <% if (r.testedThisWeek) { %>
                                    <span style="font-size:0.72rem; color:var(--text-muted); margin-left:4px;">tested this week</span>
                                <% } %>
                            <% } else { %>
                                <span style="background:#fef3c7; color:#92400e; border-radius:12px; padding:2px 10px; font-size:0.78rem; font-weight:700;">Not yet tested</span>
                            <% } %>
                        </td>
                        <td style="padding:8px 14px;">
                            <form action="/swim-levels/update" method="POST" style="display:flex; gap:6px; align-items:center;">
                                <input type="hidden" name="camperId" value="<%= r.CamperID %>">
                                <input type="hidden" name="weekNumber" value="<%= week %>">
                                <select name="subLevel" style="padding:4px 6px; border:1px solid var(--border-color); border-radius:6px; font-size:0.82rem;">
                                    <option value="" <%= !r.subLevel ? 'selected' : '' %>>—</option>
                                    <option value="Low" <%= r.subLevel === 'Low' ? 'selected' : '' %>>Low</option>
                                    <option value="High" <%= r.subLevel === 'High' ? 'selected' : '' %>>High</option>
                                </select>
                                <select name="levelNumber" required style="padding:4px 6px; border:1px solid var(--border-color); border-radius:6px; font-size:0.82rem;">
                                    <option value="">Level</option>
                                    <% [1,2,3,4,5,6].forEach(function(n) { %>
                                        <option value="<%= n %>" <%= r.levelNumber === n ? 'selected' : '' %>><%= n %></option>
                                    <% }); %>
                                </select>
                                <button type="submit" class="btn btn-small" style="background:#f1f5f9; font-size:0.78rem;">Save</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% }); %>

    </div>

    <script>
        function filterSwimmers() {
            const query = document.getElementById('swimmerSearch').value.toLowerCase();
            document.querySelectorAll('.swim-group').forEach(function(group) {
                let anyVisible = false;
                group.querySelectorAll('.swimmer-row').forEach(function(row) {
                    const match = row.dataset.name.includes(query);
                    row.style.display = match ? '' : 'none';
                    if (match) anyVisible = true;
                });
                group.style.display = anyVisible ? '' : 'none';
            });
        }
    </script>
</body>
</html>
