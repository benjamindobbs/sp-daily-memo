<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPLIT Scheduling | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
    <style>
        .period-details { border: 1px solid var(--border-color); border-radius: 12px; margin-bottom: 16px; overflow: hidden; background: white; box-shadow: var(--shadow); }
        .period-summary { display: flex; align-items: center; gap: 12px; padding: 14px 20px; cursor: pointer; user-select: none; list-style: none; flex-wrap: wrap; }
        .period-summary::-webkit-details-marker { display: none; }
        .period-label { font-size: 1rem; font-weight: 700; color: var(--text); flex-shrink: 0; }
        .period-body { padding: 16px 20px 20px; border-top: 1px solid var(--border-color); }
        .offering-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
        .offering-card { border: 1px solid var(--border-color); border-radius: 10px; padding: 14px; background: #fafafa; }
        .offering-name { font-weight: 700; font-size: 0.95rem; margin-bottom: 4px; }
        .enrollment-pill { display: inline-block; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; background: #f1f5f9; color: var(--text-muted); margin-bottom: 10px; }
        .split-slots-label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 5px; display: flex; align-items: center; gap: 8px; }
        .count-input { width: 56px; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.85rem; font-family: inherit; text-align: center; }
        .slot-dropdowns { display: flex; flex-direction: column; gap: 5px; margin-top: 6px; }
        .person-select { width: 100%; padding: 5px 8px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.82rem; font-family: inherit; background: white; }
        .context-row { margin-top: 10px; padding-top: 10px; border-top: 1px solid #f1f5f9; font-size: 0.78rem; color: var(--text-muted); line-height: 1.5; }
        .context-row strong { color: var(--text); }
        .no-offerings { text-align: center; padding: 60px 20px; color: var(--text-muted); }
        .side-heading { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: var(--text-muted); margin: 0 0 10px; padding-bottom: 6px; border-bottom: 1px solid #f1f5f9; }

        /* ── Random Picker ── */
        .draw-bar {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }
        .draw-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 18px;
            border-radius: 20px;
            border: none;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(99,102,241,0.35);
            transition: transform 0.1s, box-shadow 0.1s;
        }
        .draw-btn:active { transform: scale(0.96); }
        .draw-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .draw-remaining {
            font-size: 0.78rem;
            color: var(--text-muted);
            font-weight: 600;
        }
        .draw-ticket {
            display: none;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            border-radius: 12px;
            background: #fef9c3;
            border: 2px solid #fde047;
            font-size: 1.25rem;
            font-weight: 800;
            color: #78350f;
            white-space: nowrap;
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .draw-ticket.spinning {
            background: #f1f5f9;
            border-color: #cbd5e1;
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 700;
        }
        .draw-ticket.landed {
            display: inline-flex;
            transform: scale(1.06);
            box-shadow: 0 4px 16px rgba(234,179,8,0.3);
            animation: pop 0.25s ease-out;
        }
        @keyframes pop {
            0%   { transform: scale(0.85); opacity: 0.4; }
            70%  { transform: scale(1.1); }
            100% { transform: scale(1.06); opacity: 1; }
        }

        /* ── Sport Wheel ── */
        .sport-wheel-card {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px 24px;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
        }
        .sport-wheel-title {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--text-muted);
            margin-bottom: 14px;
        }
        .sport-wheel-layout {
            display: flex;
            gap: 24px;
            align-items: flex-start;
            flex-wrap: wrap;
        }
        .sport-wheel-list-col { flex: 1 1 220px; }
        .sport-wheel-list-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.4px;
            margin-bottom: 6px;
        }
        .sport-wheel-textarea {
            width: 100%;
            min-height: 110px;
            padding: 8px 10px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 0.85rem;
            font-family: inherit;
            resize: vertical;
            box-sizing: border-box;
            line-height: 1.6;
        }
        .sport-wheel-textarea:focus { outline: none; border-color: #f59e0b; box-shadow: 0 0 0 2px rgba(245,158,11,0.15); }
        .sport-wheel-spin-col {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            padding-top: 24px;
        }
        .spin-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 18px;
            border-radius: 20px;
            border: none;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(245,158,11,0.35);
            transition: transform 0.1s, box-shadow 0.1s;
            white-space: nowrap;
        }
        .spin-btn:hover { box-shadow: 0 4px 14px rgba(245,158,11,0.45); }
        .spin-btn:active { transform: scale(0.96); }
        .spin-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .spin-result {
            display: none;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            border-radius: 12px;
            background: #fffbeb;
            border: 2px solid #fbbf24;
            font-size: 1.25rem;
            font-weight: 800;
            color: #92400e;
            white-space: nowrap;
        }
        .spin-result.spinning {
            display: inline-flex;
            background: #f1f5f9;
            border-color: #cbd5e1;
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 700;
        }
        .spin-result.landed {
            display: inline-flex;
            transform: scale(1.06);
            box-shadow: 0 4px 16px rgba(251,191,36,0.35);
            animation: pop 0.25s ease-out;
        }
    </style>
</head>
<body>

    <nav class="nav-bar">
        <a href="/admin" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128101; Staff Directory</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/split-scheduling" class="nav-btn primary">&#127820; SPLIT Scheduling</a>
        <a href="/settings" class="nav-btn">&#9881;&#65039; Settings</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
    </nav>

    <div class="container-xl">

        <div class="page-header" style="margin-bottom: 16px;">
            <div>
                <h1 style="margin:0;">SPLIT Scheduling</h1>
                <p class="text-muted" style="margin:4px 0 0;">Assign SPLIT campers to Red / Carolina classes for the active week. Periods 1, 2, 4, 5, and 6.</p>
            </div>
        </div>

        <% if (alertMessage) { %>
            <div class="alert"><%= alertMessage %></div>
        <% } %>

        <!-- ── SPLIT Sport Wheel ─────────────────────────────────── -->
        <div class="sport-wheel-card">
            <div class="sport-wheel-title" style="display:flex;align-items:center;justify-content:space-between;cursor:pointer;" onclick="toggleWheel()">
                <span>&#127919; SPLIT Sport Wheel</span>
                <span id="wheelToggleIcon" style="font-size:0.8rem;font-weight:700;color:var(--text-muted);">&#9650;</span>
            </div>
            <div id="wheelBody" class="sport-wheel-layout">
                <div class="sport-wheel-list-col">
                    <div class="sport-wheel-list-label">Sports &amp; Games <span style="font-weight:400;text-transform:none;letter-spacing:0;">(one per line)</span></div>
                    <textarea id="sportWheelList" class="sport-wheel-textarea"
                              placeholder="Kickball&#10;Ultimate Frisbee&#10;Capture the Flag&#10;Four Square&#10;Dodgeball"
                              oninput="saveWheelList()"></textarea>
                </div>
                <div class="sport-wheel-spin-col">
                    <button class="spin-btn" id="spinBtn" onclick="spinWheel()">&#127919; Spin the Wheel</button>
                    <span class="spin-result" id="spinResult"></span>
                </div>
            </div>
        </div>

        <% if (offerings.length === 0) { %>
            <div class="no-offerings">
                <div style="font-size:3rem; margin-bottom:12px;">&#128197;</div>
                <h3 style="margin:0 0 8px;">No offerings loaded for the active week</h3>
                <p style="margin:0;">Upload a weekly offerings CSV via <a href="/counselor-scheduling">Counselor Scheduling</a> first.</p>
            </div>
        <% } else if (splitCampers.length === 0) { %>
            <div class="no-offerings">
                <div style="font-size:3rem; margin-bottom:12px;">&#128100;</div>
                <h3 style="margin:0 0 8px;">No SPLIT campers found</h3>
                <p style="margin:0;">Upload campers with HomeGroupColor = SPLIT to use this page.</p>
            </div>
        <% } else { %>

        <div style="margin-bottom: 20px;">
            <button id="saveBtn" class="btn btn-primary" onclick="saveAssignments()">Save Assignments</button>
            <span class="text-muted" style="font-size:0.82rem; margin-left:12px;"><%= splitCampers.length %> SPLIT camper<%= splitCampers.length !== 1 ? 's' : '' %></span>
            <span id="saveStatus" style="font-size:0.82rem; margin-left:12px; color:var(--text-muted);"></span>
        </div>

        <%
        const PERIODS = [1, 2, 4, 5, 6];
        const PERIOD_LABELS = {
            1: 'Period 1 — Enrichment AM',
            2: 'Period 2 — Enrichment AM',
            4: 'Period 4 — Sports PM',
            5: 'Period 5 — Sports PM',
            6: 'Period 6 — Sports PM'
        };
        %>

        <% PERIODS.forEach(function(p) {
            const pOffs = offerings.filter(o => o.PeriodNumber === p);
            if (pOffs.length === 0) return;
            const sides = ['Enrichment', 'Sports'].filter(side => pOffs.some(o => o.SideOfCamp === side));
        %>
        <details class="period-details" open>
            <summary class="period-summary">
                <span class="period-label"><%= PERIOD_LABELS[p] || ('Period ' + p) %></span>
                <span class="text-muted" style="font-size:0.78rem;"><%= pOffs.length %> class<%= pOffs.length !== 1 ? 'es' : '' %></span>
            </summary>
            <div class="period-body">
                <div class="draw-bar">
                    <button class="draw-btn" onclick="pickRandom(<%= p %>)" id="draw-btn-<%= p %>">&#127922; Draw a Name</button>
                    <span class="draw-remaining" id="draw-remaining-<%= p %>"></span>
                    <span class="draw-ticket" id="draw-ticket-<%= p %>"></span>
                </div>
                <% sides.forEach(function(side) {
                    const sideOffs = pOffs.filter(o => o.SideOfCamp === side);
                %>
                <p class="side-heading"><%- side === 'Enrichment' ? '&#127912; Enrichment' : '&#9917; Sports' %></p>
                <div class="offering-grid">
                <% sideOffs.forEach(function(act) {
                    const key = p + '|' + act.ActivityName;
                    const enrollment = enrollmentMap[key] || 0;
                    const defaultSlots = Math.max(1, Math.ceil(enrollment / 8));
                    const existing = assignedByKey[key] || [];
                    const instrs = instructorMap[key] || [];
                    const couns = counselorMap[key] || [];
                %>
                    <div class="offering-card" data-period="<%= p %>" data-activity="<%= act.ActivityName %>">
                        <div class="offering-name"><%= act.ActivityName %></div>
                        <span class="enrollment-pill"><%= enrollment %> enrolled &rarr; <%= defaultSlots %> SPLIT slot<%= defaultSlots !== 1 ? 's' : '' %></span>

                        <div class="split-slots-label">
                            SPLIT Slots
                            <input type="number" class="count-input" min="0" max="<%= splitCampers.length %>"
                                   value="<%= Math.max(existing.length, defaultSlots) %>"
                                   oninput="handleSlotCount(this)">
                        </div>
                        <div class="slot-dropdowns">
                            <%
                            const slotCount = Math.max(existing.length, defaultSlots);
                            for (let i = 0; i < slotCount; i++) {
                                const assignedId = existing[i] || '';
                            %>
                            <select class="person-select split-slot" data-period="<%= p %>" data-activity="<%= act.ActivityName %>">
                                <option value="">— Unassigned —</option>
                                <% splitCampers.forEach(function(sc) { %>
                                <option value="<%= sc.CamperID %>" <%= (parseInt(assignedId) === sc.CamperID) ? 'selected' : '' %>>
                                    <%= sc.LastName %>, <%= sc.FirstName %>
                                </option>
                                <% }); %>
                            </select>
                            <% } %>
                        </div>

                        <% if (instrs.length > 0 || couns.length > 0) { %>
                        <div class="context-row">
                            <% if (instrs.length > 0) { %>
                            <div><strong>Instructor:</strong> <%= instrs.join(', ') %></div>
                            <% } %>
                            <% if (couns.length > 0) { %>
                            <div><strong>Counselors:</strong> <%= couns.join(', ') %></div>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                <% }); %>
                </div>
                <% }); %>
            </div>
        </details>
        <% }); %>

        <% } %>
    </div>

    <script>
        const SPLIT_CAMPERS = <%- JSON.stringify(splitCampers) %>;

        function handleSlotCount(input) {
            const card = input.closest('.offering-card');
            const container = card.querySelector('.slot-dropdowns');
            const period = parseInt(card.dataset.period);
            const activity = card.dataset.activity;
            const target = Math.max(0, parseInt(input.value) || 0);
            const current = container.querySelectorAll('.split-slot').length;

            if (target > current) {
                for (let i = current; i < target; i++) {
                    const sel = document.createElement('select');
                    sel.className = 'person-select split-slot';
                    sel.dataset.period = period;
                    sel.dataset.activity = activity;
                    sel.innerHTML = '<option value="">— Unassigned —</option>' +
                        SPLIT_CAMPERS.map(sc => `<option value="${sc.CamperID}">${sc.LastName}, ${sc.FirstName}</option>`).join('');
                    container.appendChild(sel);
                }
            } else {
                const slots = container.querySelectorAll('.split-slot');
                for (let i = slots.length - 1; i >= target; i--) slots[i].remove();
            }
        }

        function getUnassignedForPeriod(period) {
            const assigned = new Set();
            document.querySelectorAll(`.split-slot[data-period="${period}"]`).forEach(sel => {
                const v = parseInt(sel.value);
                if (v) assigned.add(v);
            });
            return SPLIT_CAMPERS.filter(sc => !assigned.has(sc.CamperID));
        }

        function updateRemaining(period) {
            const remaining = getUnassignedForPeriod(period);
            const el = document.getElementById(`draw-remaining-${period}`);
            if (el) el.textContent = `${remaining.length} remaining`;
        }

        function pickRandom(period) {
            const pool = getUnassignedForPeriod(period);
            const btn    = document.getElementById(`draw-btn-${period}`);
            const ticket = document.getElementById(`draw-ticket-${period}`);
            const remEl  = document.getElementById(`draw-remaining-${period}`);

            if (pool.length === 0) {
                ticket.className = 'draw-ticket landed';
                ticket.textContent = '🎉 Everyone has a class!';
                ticket.style.display = 'inline-flex';
                return;
            }

            const winner = pool[Math.floor(Math.random() * pool.length)];
            const winnerName = `${winner.FirstName} ${winner.LastName}`;

            btn.disabled = true;
            ticket.className = 'draw-ticket spinning';
            ticket.style.display = 'inline-flex';
            ticket.textContent = '…';

            // Slot-machine: start fast, decelerate, land
            const TOTAL_MS  = 2200;
            const START_INT = 55;
            const END_INT   = 220;

            let elapsed = 0;
            let interval = START_INT;
            let step = null;

            function tick() {
                // Pick a random name from the pool to flash (not always the winner)
                const flash = pool[Math.floor(Math.random() * pool.length)];
                ticket.textContent = `${flash.FirstName} ${flash.LastName}`;

                elapsed += interval;
                // Ease interval outward (slow down)
                const progress = Math.min(elapsed / TOTAL_MS, 1);
                interval = START_INT + (END_INT - START_INT) * (progress * progress);

                if (elapsed >= TOTAL_MS) {
                    clearTimeout(step);
                    // Land on the winner
                    ticket.className = 'draw-ticket landed';
                    ticket.textContent = `⭐ ${winnerName}`;
                    if (remEl) remEl.textContent = `${pool.length} remaining`;
                    btn.disabled = false;
                } else {
                    step = setTimeout(tick, interval);
                }
            }

            step = setTimeout(tick, interval);
        }

        // Keep remaining counts fresh whenever any slot changes
        document.addEventListener('change', e => {
            if (e.target.classList.contains('split-slot')) {
                const period = parseInt(e.target.dataset.period);
                updateRemaining(period);
            }
        });

        // Initialize remaining counts on load
        [1, 2, 4, 5, 6].forEach(p => {
            if (document.getElementById(`draw-remaining-${p}`)) updateRemaining(p);
        });

        // ── Sport Wheel ──────────────────────────────────────────────
        (function() {
            const STORAGE_KEY = 'splitSportWheelList';
            const ta = document.getElementById('sportWheelList');
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved != null) ta.value = saved;

            window.saveWheelList = function() {
                localStorage.setItem(STORAGE_KEY, ta.value);
            };

            const body = document.getElementById('wheelBody');
            const icon = document.getElementById('wheelToggleIcon');
            if (localStorage.getItem('splitWheelCollapsed') === '1') {
                body.style.display = 'none';
                icon.innerHTML = '&#9660;';
            }
            window.toggleWheel = function() {
                const collapsed = body.style.display === 'none';
                body.style.display = collapsed ? '' : 'none';
                icon.innerHTML = collapsed ? '&#9650;' : '&#9660;';
                localStorage.setItem('splitWheelCollapsed', collapsed ? '0' : '1');
            };

            window.spinWheel = function() {
                const items = ta.value.split('\n').map(s => s.trim()).filter(Boolean);
                if (items.length === 0) {
                    ta.focus();
                    ta.style.borderColor = '#ef4444';
                    setTimeout(() => { ta.style.borderColor = ''; }, 1200);
                    return;
                }

                const winner = items[Math.floor(Math.random() * items.length)];
                const btn    = document.getElementById('spinBtn');
                const result = document.getElementById('spinResult');

                btn.disabled = true;
                result.className = 'spin-result spinning';
                result.textContent = '…';

                const TOTAL_MS  = 2200;
                const START_INT = 55;
                const END_INT   = 220;
                let elapsed  = 0;
                let interval = START_INT;
                let step     = null;

                function tick() {
                    result.textContent = items[Math.floor(Math.random() * items.length)];
                    elapsed += interval;
                    const progress = Math.min(elapsed / TOTAL_MS, 1);
                    interval = START_INT + (END_INT - START_INT) * (progress * progress);
                    if (elapsed >= TOTAL_MS) {
                        clearTimeout(step);
                        result.className = 'spin-result landed';
                        result.textContent = '⭐ ' + winner;
                        btn.disabled = false;
                    } else {
                        step = setTimeout(tick, interval);
                    }
                }

                step = setTimeout(tick, interval);
            };
        })();

        async function saveAssignments() {
            const btn = document.getElementById('saveBtn');
            const status = document.getElementById('saveStatus');
            btn.disabled = true;
            status.textContent = 'Saving…';

            const assignments = [];
            document.querySelectorAll('.split-slot').forEach(sel => {
                const camperID = parseInt(sel.value);
                const periodNumber = parseInt(sel.dataset.period);
                const activityName = sel.dataset.activity;
                if (camperID && periodNumber && activityName) {
                    assignments.push({ camperID, periodNumber, activityName });
                }
            });

            try {
                const resp = await fetch('/save-split-assignments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ assignments })
                });
                const data = await resp.json();
                if (data.ok) {
                    status.textContent = '✓ Saved';
                    status.style.color = 'var(--success, #16a34a)';
                } else {
                    status.textContent = 'Error: ' + (data.error || 'Unknown');
                    status.style.color = '#dc2626';
                }
            } catch (e) {
                status.textContent = 'Network error';
                status.style.color = '#dc2626';
            }
            btn.disabled = false;
            setTimeout(() => { status.textContent = ''; }, 4000);
        }
    </script>
</body>
</html>
