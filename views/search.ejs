<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Camper Search | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>

<body>

    <% if (viewMode === 'admin') { %>
    <nav class="nav-bar">
        <a href="<%= viewMode === 'admin' ? '/admin' : '/staff' %>" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn primary">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128101; Staff Directory</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
    </nav>
    <% } else { %>
    <nav class="nav-bar">
        <a href="/staff" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn primary">&#128269; Camper Lookup</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="admin">
            <button class="nav-btn" style="cursor:pointer;">&#128274; Admin View</button>
        </form>
    </nav>
    <% } %>

    <div class="container">
        <div class="search-header">
            <h1 style="margin:0;">Camper Lookup</h1>
            <p style="color: var(--text-muted);">Find schedules, bus routes, and counselor assignments.</p>

            <div class="search-bar-container">
                <input type="text" id="camperSearch" class="search-input"
                    placeholder="Type a name (e.g. 'Alex' or 'Smith')..." onkeyup="applyFilters()">
                <button class="btn action-btn" onclick="clearAllFilters()">Clear</button>
            </div>
        </div>

        <div class="filter-bar" style="margin-bottom:8px;">
            <label for="groupFilter">Group:</label>
            <select id="groupFilter" class="filter-dropdown" onchange="applyFilters()">
                <option value="all">All Groups</option>
                <option value="Red">Red</option>
                <option value="Carolina">Carolina</option>
                <option value="Green">Green</option>
                <option value="Navy">Navy</option>
                <option value="LilPlace">Li'l Place</option>
                <option value="KinderPlace">Kinder Place</option>
                <option value="SPLIT">SPLIT</option>
            </select>
            <button type="button" id="moreFiltersBtn" onclick="toggleMoreFilters()"
                style="margin-left:8px; padding:6px 12px; border:1px solid var(--border); background:transparent; border-radius:6px; cursor:pointer; font-size:0.85rem; color:var(--text-muted);">
                + More Filters
            </button>
        </div>
        <div id="moreFiltersRow" style="display:none; margin-bottom:16px;" class="filter-bar">
            <label for="busFilter">Bus:</label>
            <select id="busFilter" class="filter-dropdown" onchange="applyFilters()">
                <option value="all">All Buses</option>
                <option value="__riders__">Bus Riders</option>
            </select>
            <label for="extFilter">Extended Hours:</label>
            <select id="extFilter" class="filter-dropdown" onchange="applyFilters()">
                <option value="all">All</option>
                <option value="any">Any Extended</option>
                <option value="AM">AM Extended</option>
                <option value="PM">PM Extended</option>
                <option value="Both">AM + PM</option>
            </select>
        </div>

        <div class="table-scroll">
        <table class="search-table mc">
            <thead>
                <tr>
                    <th>Camper</th>
                    <th>Grade</th>
                    <th>Group</th>
                    <th>Counselor</th>
                    <th>Bus / Extended</th>
                    <th>Lunch</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <% if (typeof camper !=='undefined' && camper.length> 0) { %>
                <% camper.forEach(function(c) { %>
                    <tbody class="camper-group staff-item mc-card"
                        data-name="<%= (c.FirstName + ' ' + c.LastName).toLowerCase() %>"
                        data-group="<%= c.HomeGroupColor || '' %>"
                        data-bus="<%= (c.BusRoute && c.BusRoute.toLowerCase() !== 'null') ? c.BusRoute : '' %>"
                        data-extended="<%= (c.ExtendedHours && c.ExtendedHours.toLowerCase() !== 'null') ? c.ExtendedHours : '' %>"
                        data-href="/camper/<%= c.CamperID %>">
                        <tr class="main-info-row">
                            <td class="mc-title">
                                <div style="font-weight: 700; color: #1e293b;">
                                    <%= c.FirstName %> <%= c.LastName %>
                                </div>
                            </td>
                            <td class="mc-hide"><%= c.Grade %></td>
                            <td>
                                <span class="tag <%= c.HomeGroupColor %>"><%= c.HomeGroupColor %></span>
                            </td>
                            <td>
                                <% if (c.HomeGroupCounselorIDResolved) { %>
                                    <a href="/counselor-profile/<%= c.HomeGroupCounselorIDResolved %>" class="counselor-link">
                                        &#128100; <%= c.HomeCounselorName %>
                                    </a>
                                <% } else { %>
                                    <span class="text-muted" style="font-style: italic;">Unassigned</span>
                                <% } %>
                            </td>
                            <td>
                                <div style="font-size: 0.85rem; display: flex; flex-direction: column; gap: 2px;">
                                    <span>&#128652; <% var _b = c.BusRoute; var _bn = parseFloat(_b); %><%= (_b && _b.toLowerCase() !== 'null') ? (isNaN(_bn) ? _b : Math.round(_bn)) : 'Parent' %></span>
                                    <span class="text-muted" style="font-size: 0.75rem;">&#9200; Ext: <%= c.ExtendedHours || 'No' %></span>
                                </div>
                            </td>
                            <td>
                                <% if (c.CampLunch === 'Yes') { %>
                                    <span class="lunch-yes">&#127857; YES</span>
                                <% } else if (c.CampLunch === 'Allergy') { %>
                                    <span style="color:#b45309; font-size:0.82rem; font-weight:600;">&#9888; Allergy</span>
                                <% } else { %>
                                    <span class="text-muted" style="font-size: 0.75rem;">Packed</span>
                                <% } %>
                            </td>
                            <td class="text-right mc-hide">
                                <a href="/camper/<%= c.CamperID %>" class="action-btn">View Profile</a>
                            </td>
                        </tr>
                        <tr class="schedule-row">
                            <td colspan="7">
                                <div class="mini-schedule">
                                    <%
                                    // Red/Carolina: periods 1,2,4,5,6 (no P3). SPLIT: periods 1,2,5,6 with P3=SPLIT Sport.
                                    const isSplit = c.HomeGroupColor === 'SPLIT';
                                    const isRC = c.HomeGroupColor === 'Red' || c.HomeGroupColor === 'Carolina';
                                    const slots = isSplit
                                        ? [c.P1, c.P2, 'SPLIT Sport', c.P5, c.P6]
                                        : isRC
                                            ? [c.P1, c.P2, c.P4, c.P5, c.P6]
                                            : [c.P1, c.P2, c.P3, c.P4, c.P5];
                                    %>
                                    <% slots.forEach(function(activity, i) { %>
                                        <div class="period-box">
                                            <strong>P<%= i+1 %></strong>
                                            <span><%= activity || '---' %></span>
                                        </div>
                                    <% }) %>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                    <% }) %>
                        <% } else { %>
                            <tbody>
                                <tr>
                                    <td colspan="7" style="text-align: center; padding: 40px;" class="text-muted">No campers found matching your search.</td>
                                </tr>
                            </tbody>
                            <% } %>
        </table>
        </div>

        <% if (viewMode === 'admin') { %>
        <footer class="admin-footer">
            <div class="admin-footer-inner">
                <div>
                    <h4 style="margin:0; color: #991b1b;">Data Management</h4>
                    <p style="margin:0; font-size: 0.8rem; color: #b91c1c;">Clear all camper records for a new session.</p>
                </div>
                <form action="/clear-campers" method="POST"
                    onsubmit="return confirm('EXTREME WARNING: This wipes the entire database of campers. Proceed?');">
                    <button type="submit" class="danger-btn">Clear Database</button>
                </form>
            </div>
        </footer>
        <% } %>
    </div>

    <script>
        function populateBusFilter() {
            const routes = new Set();
            document.querySelectorAll('.camper-group[data-bus]').forEach(g => {
                const b = g.dataset.bus;
                if (b) routes.add(b);
            });
            const sel = document.getElementById('busFilter');
            [...routes].sort((a, b) => a.localeCompare(b, undefined, { numeric: true })).forEach(r => {
                sel.appendChild(new Option('Bus ' + r, r));
            });
        }

        function toggleMoreFilters() {
            const row = document.getElementById('moreFiltersRow');
            const btn = document.getElementById('moreFiltersBtn');
            const showing = row.style.display !== 'none';
            if (showing) {
                row.style.display = 'none';
                btn.textContent = '+ More Filters';
                document.getElementById('busFilter').value = 'all';
                document.getElementById('extFilter').value = 'all';
                applyFilters();
            } else {
                row.style.display = '';
                btn.textContent = '− Fewer Filters';
            }
        }

        function applyFilters() {
            const nameVal  = document.getElementById('camperSearch').value.trim().toLowerCase();
            const groupVal = document.getElementById('groupFilter').value;
            const moreOpen = document.getElementById('moreFiltersRow').style.display !== 'none';
            const busVal   = moreOpen ? document.getElementById('busFilter').value : 'all';
            const extVal   = moreOpen ? document.getElementById('extFilter').value : 'all';

            document.querySelectorAll('.camper-group').forEach(group => {
                const nameMatch  = !nameVal  || group.dataset.name.includes(nameVal);
                const groupMatch = groupVal === 'all' || group.dataset.group === groupVal;
                const bus        = group.dataset.bus || '';
                const busMatch   = busVal === 'all' || (busVal === '__riders__' ? !!bus : bus === busVal);
                const ext        = group.dataset.extended || '';
                let extMatch     = extVal === 'all';
                if (!extMatch) {
                    if (extVal === 'any') extMatch = !!ext;
                    else extMatch = ext === extVal;
                }
                group.classList.toggle('filter-hidden', !(nameMatch && groupMatch && busMatch && extMatch));
            });
        }

        function runCamperSearch() { applyFilters(); }

        function clearAllFilters() {
            document.getElementById('camperSearch').value = '';
            document.getElementById('groupFilter').value  = 'all';
            document.getElementById('busFilter').value    = 'all';
            document.getElementById('extFilter').value    = 'all';
            const row = document.getElementById('moreFiltersRow');
            const btn = document.getElementById('moreFiltersBtn');
            row.style.display = 'none';
            btn.textContent = '+ More Filters';
            applyFilters();
            document.getElementById('camperSearch').focus();
        }

        document.addEventListener('DOMContentLoaded', () => {
            populateBusFilter();
            document.querySelectorAll('.mc-card[data-href]').forEach(card => {
                card.addEventListener('click', e => {
                    if (!e.target.closest('a')) location.href = card.dataset.href;
                });
            });
        });
    </script>
</body>

</html>