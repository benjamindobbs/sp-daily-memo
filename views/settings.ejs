<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings & Data Management | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>

<body>

    <nav class="nav-bar">
        <a href="<%= viewMode === 'admin' ? '/admin' : '/staff' %>" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Schedule</a>
        <a href="/settings" class="nav-btn primary">&#9881;&#65039; Settings</a>
        <a href="/faculty-summer" class="nav-btn">&#128197; Full Summer</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
    </nav>

    <div class="container">
        <h1>System Settings</h1>

        <% if (alertMessage) { %>
            <div class="alert"><%= alertMessage %></div>
        <% } %>

        <% if (confirmWeek) { %>
        <div style="background:#fef9c3; border:1px solid #fde047; border-radius:8px; padding:12px 16px; margin-bottom:18px; font-size:0.875rem;">
            &#9888; Week <%= confirmWeek %> already has <%= weekCount %> counselor records. Re-upload the same file with Week <%= confirmWeek %> selected to confirm replacement.
        </div>
        <% } %>
        <% if (confirmOfferWeek) { %>
        <div style="background:#fef9c3; border:1px solid #fde047; border-radius:8px; padding:12px 16px; margin-bottom:18px; font-size:0.875rem;">
            &#9888; Week <%= confirmOfferWeek %> already has <%= offerCount %> offering records. Re-upload the same file with Week <%= confirmOfferWeek %> selected to confirm replacement.
        </div>
        <% } %>

        <div class="card" style="margin-bottom:24px;">
            <h2 style="margin:0 0 16px;">Session Management</h2>
            <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                <thead>
                    <tr style="border-bottom:2px solid var(--border-color);">
                        <th style="text-align:left; padding:6px 10px;">Week</th>
                        <th style="text-align:left; padding:6px 10px;">Label</th>
                        <th style="text-align:left; padding:6px 10px;">Start Date</th>
                        <th style="text-align:center; padding:6px 10px;">Counselors</th>
                        <th style="text-align:center; padding:6px 10px;">Offerings</th>
                        <th style="text-align:left; padding:6px 10px;">Status</th>
                        <th style="text-align:left; padding:6px 10px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                <% sessions.forEach(s => { %>
                <tr style="border-bottom:1px solid var(--border-color);">
                    <td style="padding:8px 10px; font-weight:700;">W<%= s.weekNumber %></td>
                    <td style="padding:8px 10px;">
                        <form action="/update-session-label" method="POST" style="display:flex; gap:6px; align-items:center;">
                            <input type="hidden" name="weekNumber" value="<%= s.weekNumber %>">
                            <input type="text" name="label" value="<%= s.label %>" style="width:110px; padding:4px 6px; border:1px solid var(--border-color); border-radius:4px; font-size:0.82rem;">
                            <input type="date" name="startDate" value="<%= s.startDate || '' %>" style="padding:4px 6px; border:1px solid var(--border-color); border-radius:4px; font-size:0.82rem;">
                            <button type="submit" style="background:none; border:none; cursor:pointer; font-size:1rem;" title="Save label">&#128190;</button>
                        </form>
                    </td>
                    <td style="padding:8px 10px; color:var(--text-muted); font-size:0.8rem;"><%= s.startDate || '—' %></td>
                    <td style="padding:8px 10px; text-align:center;">
                        <span style="background:#f1f5f9; border-radius:12px; padding:2px 10px; font-size:0.78rem;"><%= s.counselorCount %></span>
                    </td>
                    <td style="padding:8px 10px; text-align:center;">
                        <span style="background:#f1f5f9; border-radius:12px; padding:2px 10px; font-size:0.78rem;"><%= s.offeringCount %></span>
                    </td>
                    <td style="padding:8px 10px;">
                        <% if (s.isActive) { %>
                            <span style="background:#dcfce7; color:#166534; border-radius:12px; padding:2px 10px; font-size:0.75rem; font-weight:700;">Active</span>
                        <% } %>
                        <% if (s.isReleased) { %>
                            <span style="background:#dbeafe; color:#1e40af; border-radius:12px; padding:2px 10px; font-size:0.75rem; font-weight:700; margin-left:4px;">Released</span>
                        <% } %>
                        <% if (s.isPrepTarget) { %>
                            <span style="background:#fef9c3; color:#92400e; border-radius:12px; padding:2px 10px; font-size:0.75rem; font-weight:700; margin-left:4px;">Prep Target</span>
                        <% } %>
                    </td>
                    <td style="padding:8px 10px; display:flex; gap:6px; flex-wrap:wrap;">
                        <% if (!s.isActive) { %>
                        <form action="/set-active-week" method="POST">
                            <input type="hidden" name="weekNumber" value="<%= s.weekNumber %>">
                            <button type="submit" class="btn btn-small" style="background:#f1f5f9; font-size:0.75rem;">Set Active</button>
                        </form>
                        <% } %>
                        <form action="/set-released-week" method="POST">
                            <input type="hidden" name="weekNumber" value="<%= s.weekNumber %>">
                            <button type="submit" class="btn btn-small" style="background:<%= s.isReleased ? '#dbeafe' : '#f1f5f9' %>; font-size:0.75rem;"><%= s.isReleased ? 'Unrelease' : 'Release' %></button>
                        </form>
                        <form action="/set-prep-week" method="POST" title="<%= s.isPrepTarget ? 'Click to unset — uploads will use active week' : 'Set as target week for roster and instructor uploads' %>">
                            <input type="hidden" name="weekNumber" value="<%= s.weekNumber %>">
                            <button type="submit" class="btn btn-small" style="background:<%= s.isPrepTarget ? '#fef9c3' : '#f1f5f9' %>; color:<%= s.isPrepTarget ? '#92400e' : '' %>; font-size:0.75rem;"><%= s.isPrepTarget ? 'Unset Prep' : 'Set Prep' %></button>
                        </form>
                        <form action="/clear-counselor-week" method="POST" onsubmit="return confirm('Clear all Week <%= s.weekNumber %> counselor data?');">
                            <input type="hidden" name="weekNumber" value="<%= s.weekNumber %>">
                            <button type="submit" class="btn btn-small" style="background:#fef2f2; color:#991b1b; font-size:0.75rem;" <%= s.counselorCount === 0 ? 'disabled' : '' %>>Clear</button>
                        </form>
                        <form action="/sync-offerings-from-schedule" method="POST" onsubmit="return confirm('Sync activities and offerings for Week <%= s.weekNumber %> from imported schedule? This will replace existing offerings.');">
                            <input type="hidden" name="weekNumber" value="<%= s.weekNumber %>">
                            <button type="submit" class="btn btn-small" style="background:#f0fdf4; color:#166534; font-size:0.75rem;">Sync</button>
                        </form>
                    </td>
                </tr>
                <% }); %>
                </tbody>
            </table>
            </div>
        </div>

                <div class="settings-grid">

                    <section class="settings-card">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px; margin-bottom:14px;">
                            <div>
                                <h2 style="margin:0 0 4px;">&#127934; Activity Manager</h2>
                                <p class="text-muted" style="margin:0; font-size:0.85rem;">Manage group restrictions and capacity.</p>
                            </div>
                            <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                                <% if (activeWeek) { %>
                                <form action="/sync-activity-groups" method="POST"
                                      onsubmit="return confirm('Sync AllowedGroups from the active week schedule? This will overwrite all current group settings and period exceptions.');">
                                    <button type="submit" class="btn btn-small"
                                        style="background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; font-size:0.75rem;">
                                        &#128260; Sync Groups from W<%= activeWeek %>
                                    </button>
                                </form>
                                <% } %>
                                <form action="/clear-activities" method="POST"
                                    onsubmit="return confirm('Delete ALL activities? This cannot be undone.');">
                                    <button type="submit" class="settings-link-btn" style="font-size:0.75rem;">&#128465;&#65039; Clear All</button>
                                </form>
                            </div>
                        </div>

                        <form action="/add-activity" method="POST" class="inline-form" style="margin-bottom: 8px; flex-wrap: wrap;">
                            <input type="text" name="activityName" placeholder="Activity name" required style="flex: 2; min-width: 120px;">
                            <select name="side" style="flex: 1; min-width: 100px;">
                                <option value="Enrichment">Enrichment</option>
                                <option value="Sports">Sports</option>
                            </select>
                            <select name="allowedGroups" style="flex: 1; min-width: 120px;">
                                <option value="">All Groups</option>
                                <option value="Red">Red</option>
                                <option value="Carolina">Carolina</option>
                                <option value="Red-Carolina">Red-Carolina</option>
                                <option value="Green-Navy">Green-Navy</option>
                            </select>
                            <button type="submit" class="btn primary btn-small">Add Activity</button>
                        </form>

                        <form action="/add-activity-period-group" method="POST" class="inline-form" style="flex-wrap: wrap; margin-bottom: 14px;">
                            <select name="activityName" required style="flex: 2; min-width: 140px; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem;">
                                <option value="">-- Activity --</option>
                                <% activities.forEach(act => { %>
                                    <option value="<%= act.Name %>"><%= act.Name %></option>
                                <% }) %>
                            </select>
                            <select name="periodNumber" required style="flex: 1; min-width: 80px; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem;">
                                <option value="">-- Period --</option>
                                <% [1,2,3,4,5,6].forEach(p => { %>
                                    <option value="<%= p %>">P<%= p %></option>
                                <% }) %>
                            </select>
                            <select name="allowedGroups" required style="flex: 1; min-width: 120px; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem;">
                                <option value="">-- Groups --</option>
                                <option value="Red">Red</option>
                                <option value="Carolina">Carolina</option>
                                <option value="Red-Carolina">Red-Carolina</option>
                                <option value="Green-Navy">Green-Navy</option>
                            </select>
                            <button type="submit" class="btn btn-small" style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe;">Add Exception</button>
                        </form>

                        <div style="margin-bottom: 10px; display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                            <input type="text" id="activitySearch" onkeyup="filterActivities()"
                                placeholder="&#128269; Filter activity list..."
                                style="flex:1; min-width:160px; padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem;">
                            <% if (activeWeek) { %>
                            <button type="button" id="inactiveToggle" onclick="toggleInactive(this)"
                                style="font-size:0.75rem; padding:5px 12px; border:1px solid #cbd5e1; border-radius:20px; background:#f8fafc; cursor:pointer; white-space:nowrap; color:#64748b;">
                                Show all activities
                            </button>
                            <span style="font-size:0.75rem; color:var(--text-muted);">Showing W<%= activeWeek %> only</span>
                            <% } %>
                        </div>

                        <%
                        const periodExMap = {};
                        periodOverrides.forEach(function(ov) {
                            if (!periodExMap[ov.ActivityName]) periodExMap[ov.ActivityName] = [];
                            periodExMap[ov.ActivityName].push(ov);
                        });
                        %>
                        <div class="activity-table-scroll" style="overflow-y: auto; border: 1px solid #f1f5f9; border-radius: 8px;">
                            <table id="activityTable" class="settings-table activity-table">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Side</th>
                                        <th>Period</th>
                                        <th>Allowed Groups / Max</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% activities.forEach(function(act) {
                                        const isActive = activeActivityNames && activeActivityNames.has(act.Name);
                                        const exceptions = periodExMap[act.Name] || [];
                                    %>
                                        <tr class="activity-row <%= act.SideOfCamp === 'Sports' ? 'row-sports' : 'row-enrichment' %> <%= (!isActive && activeWeek) ? 'activity-inactive' : '' %>"
                                            data-active="<%= isActive ? 'true' : 'false' %>">
                                            <td class="act-name">
                                                <strong><%= act.Name %></strong>
                                                <% if (!isActive && activeWeek) { %>
                                                <span style="font-size:0.7rem; color:#94a3b8; font-weight:400; display:block;">(not in W<%= activeWeek %>)</span>
                                                <% } %>
                                            </td>
                                            <td><%= act.SideOfCamp %></td>
                                            <td style="font-size:0.8rem; color:var(--text-muted); white-space:nowrap;">
                                                <% if (exceptions.length === 0) { %>
                                                    All
                                                <% } else { %>
                                                    <%= exceptions.map(function(e) { return 'P' + e.PeriodNumber; }).join(' · ') %>
                                                <% } %>
                                            </td>
                                            <td>
                                                <form action="/update-activity" method="POST"
                                                    style="display: flex; align-items: center; gap: 5px; flex-wrap: wrap; margin-bottom:<%= exceptions.length > 0 ? '5px' : '0' %>;">
                                                    <input type="hidden" name="activityName" value="<%= act.Name %>">
                                                    <select name="allowedGroups"
                                                        style="padding: 4px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 0.8rem;">
                                                        <option value="" <%= !act.AllowedGroups ? 'selected' : '' %>>All</option>
                                                        <option value="Red" <%= act.AllowedGroups === 'Red' ? 'selected' : '' %>>Red</option>
                                                        <option value="Carolina" <%= act.AllowedGroups === 'Carolina' ? 'selected' : '' %>>Carolina</option>
                                                        <option value="Red-Carolina" <%= act.AllowedGroups === 'Red-Carolina' ? 'selected' : '' %>>Red-Carolina</option>
                                                        <option value="Green-Navy" <%= act.AllowedGroups === 'Green-Navy' ? 'selected' : '' %>>Green-Navy</option>
                                                    </select>
                                                    <input type="number" name="maxCapacity"
                                                        value="<%= act.MaxCapacity %>"
                                                        style="width: 55px; padding: 4px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 0.85rem;"
                                                        title="Max Capacity">
                                                    <button type="submit" title="Save"
                                                        style="background: none; border: none; cursor: pointer; font-size: 1rem; padding: 0;">
                                                        &#128190;
                                                    </button>
                                                </form>
                                                <% if (exceptions.length > 0) { %>
                                                <div style="display:flex; flex-wrap:wrap; gap:4px;">
                                                    <% exceptions.forEach(function(ex) { %>
                                                    <span style="background:#f1f5f9; border:1px solid #e2e8f0; border-radius:8px; padding:2px 7px; font-size:0.73rem; display:inline-flex; align-items:center; gap:3px;">
                                                        P<%= ex.PeriodNumber %>: <strong><%= ex.AllowedGroups %></strong>
                                                        <form action="/delete-activity-period-group" method="POST" style="margin:0; display:inline;">
                                                            <input type="hidden" name="activityName" value="<%= act.Name %>">
                                                            <input type="hidden" name="periodNumber" value="<%= ex.PeriodNumber %>">
                                                            <button type="submit" style="background:none; border:none; cursor:pointer; padding:0 0 0 2px; font-size:0.8rem; line-height:1; color:#94a3b8;" title="Remove">×</button>
                                                        </form>
                                                    </span>
                                                    <% }) %>
                                                </div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <form action="/delete-activity/<%= encodeURIComponent(act.Name) %>"
                                                    method="POST" onsubmit="return confirm('Delete activity?');">
                                                    <button type="submit"
                                                        style="background:none; border:none; cursor:pointer;">&#128465;&#65039;</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <style>
                        .activity-inactive { display: none; }
                        .activity-table-scroll { max-height: 180vh; }
                        @media (max-width: 768px) { .activity-table-scroll { max-height: 50vh; } }
                    </style>
                    <script>
                        let showAllActivities = false;

                        function filterActivities() {
                            const filter = document.getElementById('activitySearch').value.toLowerCase();
                            document.querySelectorAll('.activity-row').forEach(row => {
                                const inactive = row.dataset.active === 'false' && !showAllActivities;
                                const nameMatch = row.querySelector('.act-name').textContent.toLowerCase().includes(filter);
                                row.style.display = (inactive || !nameMatch) ? 'none' : '';
                            });
                        }

                        function toggleInactive(btn) {
                            showAllActivities = !showAllActivities;
                            btn.textContent = showAllActivities ? 'Hide inactive' : 'Show all activities';
                            filterActivities();
                        }

                        // Apply initial hide on load
                        filterActivities();
                    </script>

                    <div style="display: flex; flex-direction: column; gap: 30px;">
                        <section class="settings-card">
                            <h2>CSV Data Imports</h2>

                            <div class="upload-section"
                                style="margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid #eee;">
                                <h4 style="margin-bottom: 5px;">All Staff (Counselors, Leaders, Faculty)</h4>
                                <p class="text-muted" style="font-size: 0.75rem; margin-bottom: 10px;">
                                    Export the staff roster from camp management. Required columns: <strong>Name</strong> (Last, First), <strong>Positions</strong>, <strong>Camp</strong>.
                                    Handles all roles: Counselor, Swim Counselor, Faculty, Unit Leader, Sports Leader, Director, and more.
                                    Home group color is assigned via the Schedule Builder — not imported here.
                                </p>
                                <form action="/upload-counselors" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 10px;">
                                    <input type="file" name="file" accept=".csv" required style="font-size: 0.85rem;">
                                    <button type="submit" class="btn primary btn-small" style="width: fit-content;">Import Staff</button>
                                </form>
                                <form action="/clear-counselors" method="POST" onsubmit="return confirm('Delete ALL counselors and staff?');" style="margin-top: 5px;">
                                    <button type="submit" class="settings-link-btn">&#128465;&#65039; Clear All Staff</button>
                                </form>
                            </div>

                            <div class="upload-section"
                                style="margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid #eee;">
                                <h4 style="margin-bottom: 5px;">Instructor Schedules</h4>
                                <p class="text-muted" style="font-size: 0.75rem; margin-bottom: 10px;">
                                    Uploads instructor schedules to the selected week. Required columns: <strong>FirstName, LastName, P1—P6, L1—L6</strong> (locations optional).
                                    Unknown names are automatically added as Instructors.
                                    <% if (prepTargetWeek) { %><strong style="color:#92400e;">Prep target: W<%= prepTargetWeek %></strong><% } %>
                                </p>
                                <form action="/upload-instructors" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 10px;">
                                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                                        <label style="font-size:0.8rem; font-weight:600;">Target Week:</label>
                                        <select name="weekNumber" style="font-size:0.82rem; padding:3px 6px; border:1px solid var(--border-color); border-radius:4px;">
                                            <% sessions.forEach(s => { %>
                                            <option value="<%= s.weekNumber %>" <%= (prepTargetWeek ? s.weekNumber === prepTargetWeek : s.isActive) ? 'selected' : '' %>>
                                                W<%= s.weekNumber %><%= s.label ? ' — ' + s.label : '' %><%= s.isActive ? ' (Active)' : '' %><%= s.isPrepTarget ? ' (Prep)' : '' %>
                                            </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div style="display:flex; gap:8px; align-items:center;">
                                        <input type="file" name="file" accept=".csv" required style="font-size: 0.85rem;">
                                        <button type="submit" class="btn primary btn-small" style="width: fit-content;">Import Instructor Schedules</button>
                                    </div>
                                </form>
                                <form action="/clear-staff" method="POST" onsubmit="return confirm('Delete all instructor and unit leader records?');" style="margin-top: 5px;">
                                    <button type="submit" class="settings-link-btn">&#128465;&#65039; Clear Instructor &amp; Leader Data</button>
                                </form>
                            </div>

                            <div class="upload-section">
                                <h4>Camper Roster (ACR-005)</h4>
                                <p class="text-muted" style="font-size: 0.75rem; margin-bottom: 10px;">
                                    Export the <strong>ACR-005</strong> report from camp management (any week).
                                    Creates and updates campers: name, color group, lunch, shirt size.
                                    Homegroup assignments are written to the selected week.
                                    <% if (prepTargetWeek) { %><strong style="color:#92400e;">Prep target: W<%= prepTargetWeek %></strong><% } %>
                                </p>
                                <form action="/upload-campers" method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:8px;">
                                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                                        <label style="font-size:0.8rem; font-weight:600;">Homegroup Week:</label>
                                        <select name="weekNumber" style="font-size:0.82rem; padding:3px 6px; border:1px solid var(--border-color); border-radius:4px;">
                                            <% sessions.forEach(s => { %>
                                            <option value="<%= s.weekNumber %>" <%= (prepTargetWeek ? s.weekNumber === prepTargetWeek : s.isActive) ? 'selected' : '' %>>
                                                W<%= s.weekNumber %><%= s.label ? ' — ' + s.label : '' %><%= s.isActive ? ' (Active)' : '' %><%= s.isPrepTarget ? ' (Prep)' : '' %>
                                            </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div style="display:flex; gap:8px; align-items:center;">
                                        <input type="file" name="file" accept=".csv" required style="font-size:0.82rem;">
                                        <button type="submit" class="btn primary btn-small">Import Roster</button>
                                    </div>
                                </form>
                            </div>

                            <div class="upload-section">
                                <h4>Master Camper Schedule (ACR-255)</h4>
                                <p class="text-muted" style="font-size: 0.75rem; margin-bottom: 10px;">
                                    Export the <strong>Master Camper Schedule (ACR-255)</strong> report from camp management.
                                    Enriches existing campers with grade, bus route, extended hours, and activity schedule.
                                    <% if (prepTargetWeek) { %><strong style="color:#92400e;">Prep target: W<%= prepTargetWeek %></strong><% } %>
                                </p>
                                <form action="/upload-campers-schedule" method="POST" enctype="multipart/form-data">
                                    <input type="file" name="file" accept=".csv" required>
                                    <button type="submit" class="btn primary btn-small">Import Schedule</button>
                                </form>

                                <form action="/clear-campers" method="POST" onsubmit="return confirm('Delete ALL campers?');" style="margin-top: 10px;">
                                    <button type="submit" class="settings-link-btn">&#128465;&#65039; Clear All Campers</button>
                                </form>
                            </div>

                            <div class="upload-section">
                                <h4>AM Bus Attendance (ACR-132)</h4>
                                <p class="text-muted" style="font-size: 0.75rem; margin-bottom: 10px;">
                                    Export <strong>ACR-132 (AM Bus Attendance)</strong>. Sets each camper's bus route and
                                    AM ride flag directly from the report's bus sections. Run after the roster import.
                                    <% if (prepTargetWeek) { %><strong style="color:#92400e;">Prep target: W<%= prepTargetWeek %></strong><% } %>
                                </p>
                                <form action="/upload-bus-am" method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:8px;">
                                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                                        <label style="font-size:0.8rem; font-weight:600;">Target Week:</label>
                                        <select name="weekNumber" style="font-size:0.82rem; padding:3px 6px; border:1px solid var(--border-color); border-radius:4px;">
                                            <% sessions.forEach(s => { %>
                                            <option value="<%= s.weekNumber %>" <%= (prepTargetWeek ? s.weekNumber === prepTargetWeek : s.isActive) ? 'selected' : '' %>>
                                                W<%= s.weekNumber %><%= s.label ? ' — ' + s.label : '' %><%= s.isActive ? ' (Active)' : '' %><%= s.isPrepTarget ? ' (Prep)' : '' %>
                                            </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div style="display:flex; gap:8px; align-items:center;">
                                        <input type="file" name="file" accept=".csv" required style="font-size:0.82rem;">
                                        <button type="submit" class="btn primary btn-small">Import AM Bus</button>
                                    </div>
                                </form>
                            </div>

                            <div class="upload-section">
                                <h4>PM Bus Attendance (ACR-133)</h4>
                                <p class="text-muted" style="font-size: 0.75rem; margin-bottom: 10px;">
                                    Export <strong>ACR-133 (PM Bus Attendance)</strong>. Sets each camper's bus route and
                                    PM ride flag directly from the report's bus sections. Run after the roster import.
                                    <% if (prepTargetWeek) { %><strong style="color:#92400e;">Prep target: W<%= prepTargetWeek %></strong><% } %>
                                </p>
                                <form action="/upload-bus-pm" method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:8px;">
                                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                                        <label style="font-size:0.8rem; font-weight:600;">Target Week:</label>
                                        <select name="weekNumber" style="font-size:0.82rem; padding:3px 6px; border:1px solid var(--border-color); border-radius:4px;">
                                            <% sessions.forEach(s => { %>
                                            <option value="<%= s.weekNumber %>" <%= (prepTargetWeek ? s.weekNumber === prepTargetWeek : s.isActive) ? 'selected' : '' %>>
                                                W<%= s.weekNumber %><%= s.label ? ' — ' + s.label : '' %><%= s.isActive ? ' (Active)' : '' %><%= s.isPrepTarget ? ' (Prep)' : '' %>
                                            </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div style="display:flex; gap:8px; align-items:center;">
                                        <input type="file" name="file" accept=".csv" required style="font-size:0.82rem;">
                                        <button type="submit" class="btn primary btn-small">Import PM Bus</button>
                                    </div>
                                </form>
                            </div>
                        </section>

                    </div>
                </div>

        <div class="card" style="margin-top:24px;">
            <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:8px; margin-bottom:16px;">
                <h2 style="margin:0;">&#128196; Documents</h2>
                <a href="/docs" target="_blank" style="font-size:0.82rem; color:var(--primary);">Preview doc hub &#8599;</a>
            </div>
            <style>.doc-cell-center { grid-column: 2; }</style>
            <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:14px;">
                <% docs.forEach(function(doc, i) {
                    const hasFile = pdfExists[doc.slug];
                    const isLastAlone = (i === docs.length - 1) && (docs.length % 3 === 1);
                %>
                <div class="<%= isLastAlone ? 'doc-cell-center' : '' %>" style="border:1px solid var(--border-color); border-radius:8px; padding:12px 14px; display:flex; flex-direction:column; gap:6px;">
                    <h4 style="margin:0; font-size:0.82rem; font-weight:700; line-height:1.3;"><%= doc.icon %> <%= doc.label %></h4>
                    <% if (hasFile) { %>
                        <p style="font-size:0.75rem; color:#16a34a; margin:0;">&#10003; Uploaded &mdash; <a href="/pdf/<%= doc.slug %>" target="_blank">View</a></p>
                    <% } else { %>
                        <p style="font-size:0.75rem; color:var(--text-muted); margin:0; font-style:italic;">Not uploaded yet.</p>
                    <% } %>
                    <form action="/upload-pdf/<%= doc.slug %>" method="POST" enctype="multipart/form-data" style="margin-top:auto;">
                        <input type="file" name="file" accept=".pdf,application/pdf" required style="font-size:0.72rem; display:block; width:100%; margin-bottom:5px;">
                        <button type="submit" class="btn primary btn-small" style="width:100%;">Upload PDF</button>
                    </form>
                </div>
                <% }); %>
            </div>
        </div>

        <div class="card" style="margin-top:24px;">
            <h2 style="margin:0 0 16px;">&#128424; Print Reports</h2>
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <a href="/reports/attendance-rosters" target="_blank" class="btn primary">Attendance Rosters</a>
                <a href="/reports/name-cards" target="_blank" class="btn">Camper Name Cards</a>
            </div>
        </div>

        <div class="card" style="margin-top:24px;">
            <h2 style="margin:0 0 16px;">&#128100; Add Staff Member</h2>
            <form action="/create-staff" method="POST">
                <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">First Name *</label>
                        <input type="text" name="firstName" required placeholder="First" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:110px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Last Name *</label>
                        <input type="text" name="lastName" required placeholder="Last" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:110px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Role</label>
                        <select name="staffRole" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <option value="Counselor">Counselor</option>
                            <option value="Swim Counselor">Swim Counselor</option>
                            <option value="Unit Leader">Unit Leader</option>
                            <option value="Sports Leader">Sports Leader</option>
                            <option value="Instructor">Instructor</option>
                        </select>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Home Group Color</label>
                        <select name="homeGroupColor" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <option value="">— None —</option>
                            <option value="Red">Red</option>
                            <option value="Carolina">Carolina</option>
                            <option value="Green">Green</option>
                            <option value="Navy">Navy</option>
                            <option value="LilPlace">LilPlace</option>
                            <option value="KinderPlace">KinderPlace</option>
                            <option value="SPLIT">SPLIT</option>
                            <option value="SPRC">SPRC</option>
                            <option value="Swim">Swim</option>
                        </select>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Schedule Type</label>
                        <select name="scheduleType" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <option value="">— Auto —</option>
                            <option value="All Sports">All Sports</option>
                            <option value="All Enrichment">All Enrichment</option>
                            <option value="AM Sports / PM Enrichment">AM Sports / PM Enrichment</option>
                            <option value="AM Enrichment / PM Sports">AM Enrichment / PM Sports</option>
                        </select>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Bus Route</label>
                        <input type="text" name="busRoute" placeholder="Optional" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:90px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Extended Hours</label>
                        <select name="extendedHours" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <option value="">— None —</option>
                            <option value="AM">AM</option>
                            <option value="PM">PM</option>
                            <option value="Both">Both</option>
                        </select>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Phone</label>
                        <input type="text" name="phone" placeholder="Optional" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:110px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Email</label>
                        <input type="text" name="email" placeholder="Optional" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:140px;">
                    </div>
                    <button type="submit" class="btn btn-primary" style="padding:7px 18px; white-space:nowrap;">Add Staff</button>
                </div>
            </form>
        </div>

        <div class="card" style="margin-top:24px;">
            <h2 style="margin:0 0 4px;">&#127978; Add Camper</h2>
            <form action="/create-camper" method="POST">
                <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">First Name *</label>
                        <input type="text" name="firstName" required placeholder="First" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:110px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Last Name *</label>
                        <input type="text" name="lastName" required placeholder="Last" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:110px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Grade</label>
                        <input type="number" name="grade" placeholder="0" min="0" max="12" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; width:70px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Home Group Color</label>
                        <select name="homeGroupColor" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <option value="">— None —</option>
                            <option value="Red">Red</option>
                            <option value="Carolina">Carolina</option>
                            <option value="Green">Green</option>
                            <option value="Navy">Navy</option>
                            <option value="LilPlace">LilPlace</option>
                            <option value="KinderPlace">KinderPlace</option>
                            <option value="SPLIT">SPLIT</option>
                            <option value="SPRC">SPRC</option>
                        </select>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Bus Route</label>
                        <input type="text" name="busRoute" placeholder="Optional" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:90px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Extended Hours</label>
                        <select name="extendedHours" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <option value="">— None —</option>
                            <option value="AM">AM</option>
                            <option value="PM">PM</option>
                            <option value="Both">Both</option>
                        </select>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Camp Lunch</label>
                        <select name="campLunch" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Shirt Size</label>
                        <input type="text" name="shirtSize" placeholder="Optional" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:80px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Week *</label>
                        <select name="weekNumber" required style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <% sessions.forEach(s => { %>
                            <option value="<%= s.weekNumber %>"
                                <%= (prepTargetWeek ? s.weekNumber === prepTargetWeek : s.isActive) ? 'selected' : '' %>>
                                <%= s.label %><%= s.isActive ? ' (Active)' : '' %><%= s.weekNumber === prepTargetWeek ? ' (Prep)' : '' %>
                            </option>
                            <% }) %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary" style="padding:7px 18px; white-space:nowrap;">Add Camper &amp; Assign Classes</button>
                </div>
            </form>
        </div>

        <div class="card" style="margin-top:24px;">
            <h2 style="margin:0 0 4px;">&#128197; Create Blank Class</h2>
            <p style="margin:0 0 16px; font-size:0.82rem; color:var(--text-muted);">Adds a class to a week's offerings. No campers are added to the roster.</p>
            <form action="/create-blank-class" method="POST">
                <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Class Name *</label>
                        <input type="text" name="activityName" required placeholder="e.g. Free Swim" style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem; min-width:180px;">
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Period *</label>
                        <select name="periodNumber" required style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <option value="">— Select —</option>
                            <% [1,2,3,4,5,6].forEach(p => { %>
                                <option value="<%= p %>">Period <%= p %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Side of Camp *</label>
                        <select name="sideOfCamp" required style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <option value="">— Select —</option>
                            <option value="Enrichment">Enrichment</option>
                            <option value="Sports">Sports</option>
                        </select>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:4px;">
                        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted);">Week *</label>
                        <select name="weekNumber" required style="padding:7px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.875rem;">
                            <% sessions.forEach(s => { %>
                            <option value="<%= s.weekNumber %>"
                                <%= (prepTargetWeek ? s.weekNumber === prepTargetWeek : s.isActive) ? 'selected' : '' %>>
                                <%= s.label %><%= s.isActive ? ' (Active)' : '' %><%= s.weekNumber === prepTargetWeek ? ' (Prep)' : '' %>
                            </option>
                            <% }) %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary" style="padding:7px 18px; white-space:nowrap;">Create Class</button>
                </div>
            </form>
        </div>

        <!-- ═══════════════════════════════════════ CAMP MAP BUILDINGS ═══ -->
        <div class="card" id="map" style="margin-top:28px;">
            <h2 style="margin-top:0;">&#128205; Camp Map Buildings</h2>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:14px;">
                Pin coordinates are pixel positions on your map image with [0,0] at the top-left corner.
                Building names must match the <strong>Location</strong> values set on classes.
            </p>

            <% if (typeof usedLocations !== 'undefined' && usedLocations.length > 0) { %>
            <details style="margin-bottom:14px; font-size:0.82rem;">
                <summary style="cursor:pointer; color:var(--primary); font-weight:600;">Location values in use by schedule</summary>
                <div style="margin-top:8px; display:flex; flex-wrap:wrap; gap:6px;">
                    <% usedLocations.forEach(loc => { %>
                    <span style="background:#f1f5f9; border-radius:6px; padding:2px 9px; font-size:0.78rem;"><%= loc %></span>
                    <% }) %>
                </div>
            </details>
            <% } %>

            <% if (typeof buildings !== 'undefined' && buildings.length > 0) { %>
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem; margin-bottom:16px;">
                <thead>
                    <tr style="border-bottom:2px solid var(--border-color);">
                        <th style="text-align:left; padding:6px 10px; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Building Name</th>
                        <th style="text-align:left; padding:6px 10px; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Map</th>
                        <th style="text-align:center; padding:6px 10px; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">X</th>
                        <th style="text-align:center; padding:6px 10px; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Y</th>
                        <th style="padding:6px 10px;"></th>
                    </tr>
                </thead>
                <tbody>
                <% buildings.forEach(b => { %>
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:7px 10px; font-weight:600;"><%= b.name %></td>
                        <td style="padding:7px 10px; color:var(--text-muted); text-transform:capitalize;"><%= b.map %></td>
                        <td style="padding:7px 10px; text-align:center; color:var(--text-muted);"><%= b.x %></td>
                        <td style="padding:7px 10px; text-align:center; color:var(--text-muted);"><%= b.y %></td>
                        <td style="padding:7px 10px; text-align:right;">
                            <form action="/admin/delete-building-coord" method="POST" style="display:inline;" onsubmit="return confirm('Delete <%= b.name %>?')">
                                <input type="hidden" name="id" value="<%= b.id %>">
                                <button type="submit" class="btn btn-small" style="background:#fee2e2; color:#b91c1c; border-color:#fca5a5;">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
            <% } else { %>
            <p style="color:var(--text-muted); font-style:italic; font-size:0.85rem; margin-bottom:14px;">No buildings added yet.</p>
            <% } %>

            <form action="/admin/building-coord" method="POST">
                <h4 style="margin:0 0 10px;">Add / Update Building</h4>
                <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end;">
                    <div>
                        <label style="font-size:0.78rem; font-weight:700; display:block; margin-bottom:3px;">Building Name</label>
                        <input type="text" name="name" placeholder="e.g. Tennis Courts" required
                            style="width:200px; padding:6px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.85rem; font-family:inherit;">
                    </div>
                    <div>
                        <label style="font-size:0.78rem; font-weight:700; display:block; margin-bottom:3px;">Map</label>
                        <select name="map" required style="padding:6px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.85rem; font-family:inherit;">
                            <option value="enrichment">Enrichment</option>
                            <option value="sports">Sports</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size:0.78rem; font-weight:700; display:block; margin-bottom:3px;">X (px)</label>
                        <input type="number" name="x" placeholder="0" required min="0"
                            style="width:90px; padding:6px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.85rem; font-family:inherit;">
                    </div>
                    <div>
                        <label style="font-size:0.78rem; font-weight:700; display:block; margin-bottom:3px;">Y (px)</label>
                        <input type="number" name="y" placeholder="0" required min="0"
                            style="width:90px; padding:6px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.85rem; font-family:inherit;">
                    </div>
                    <button type="submit" class="btn btn-primary" style="padding:7px 18px;">Save Building</button>
                </div>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:8px 0 0;">If the name + map combination already exists, coordinates will be updated.</p>
            </form>
        </div>

    </div>

</body>

</html>