<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Audit Roster | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
    <style>
        .audit-section { margin-bottom: 32px; }
        .audit-section h2 { font-size: 1.1rem; font-weight: 700; margin: 0 0 12px; }
        .flag-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
        .flag-table th { text-align: left; padding: 8px 12px; background: #f8fafc; border-bottom: 2px solid var(--border); font-weight: 600; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
        .flag-table td { padding: 9px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
        .flag-table tr:last-child td { border-bottom: none; }
        .flag-badge { display: inline-block; padding: 2px 8px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }
        .flag-warn  { background: #fef3c7; color: #92400e; }
        .flag-error { background: #fee2e2; color: #991b1b; }
        .all-clear  { display: flex; align-items: center; gap: 8px; color: #16a34a; font-weight: 600; font-size: 0.9rem; padding: 12px 16px; background: #f0fdf4; border-radius: 8px; border: 1px solid #bbf7d0; }
        .audit-meta { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 24px; }
        .count-pill { font-size: 0.75rem; font-weight: 700; background: #fee2e2; color: #991b1b; border-radius: 9999px; padding: 1px 7px; margin-left: 6px; vertical-align: middle; }
        .count-ok   { background: #dcfce7; color: #166534; }
    </style>
</head>
<body>

<nav class="nav-bar">
    <a href="/admin" class="nav-btn">&#127968; Hub</a>
    <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
    <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
    <a href="/counselor-directory" class="nav-btn">&#128100; Counselors</a>
    <a href="/staff-lookup" class="nav-btn">&#128101; Staff Lookup</a>
    <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
    <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
    <form action="/choose-view" method="POST" style="margin-left:auto;">
        <input type="hidden" name="view" value="staff">
        <button class="nav-btn" style="cursor:pointer;">Staff View</button>
    </form>
</nav>

<div class="container">
    <div style="display:flex; align-items:baseline; gap:12px; margin-bottom:6px;">
        <h1 style="margin:0;">Audit Roster</h1>
    </div>
    <p class="audit-meta">
        Checking data integrity for
        <strong><%= activeSession ? activeSession.label : 'Week ' + (activeSession?.weekNumber ?? '—') %></strong>.
        Flags identify missing or mismatched data that should be resolved before the week begins.
        Li'l Place, Kinder Place, and SPLIT campers are excluded from camper checks.
    </p>

    <%/* ── Camper Flags ── */%>
    <div class="audit-section">
        <h2>
            Camper Flags
            <% const totalCamperFlags = noCounselor.length + missingSchedule.length; %>
            <% if (totalCamperFlags > 0) { %>
                <span class="count-pill"><%= totalCamperFlags %> issue<%= totalCamperFlags !== 1 ? 's' : '' %></span>
            <% } else { %>
                <span class="count-pill count-ok">All clear</span>
            <% } %>
        </h2>

        <%/* No counselor assigned */%>
        <div class="card" style="margin-bottom:16px; padding:0; overflow:hidden;">
            <div style="padding:12px 16px; border-bottom:1px solid var(--border); font-weight:600; font-size:0.9rem; display:flex; align-items:center; gap:8px;">
                No Assigned Counselor
                <% if (noCounselor.length > 0) { %>
                    <span class="count-pill"><%= noCounselor.length %></span>
                <% } %>
            </div>
            <% if (noCounselor.length === 0) { %>
                <div style="padding:12px 16px;">
                    <div class="all-clear">&#10003; All campers have a home counselor assigned.</div>
                </div>
            <% } else { %>
                <table class="flag-table">
                    <thead>
                        <tr>
                            <th>Camper</th>
                            <th>Group</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% noCounselor.forEach(c => { %>
                        <tr>
                            <td><strong><%= c.FirstName %> <%= c.LastName %></strong></td>
                            <td><span class="tag <%= c.HomeGroupColor %>"><%= c.HomeGroupColor %></span></td>
                            <td class="text-right"><a href="/camper/<%= c.CamperID %>" class="action-btn">View Profile</a></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>

        <%/* Missing schedule entries */%>
        <div class="card" style="padding:0; overflow:hidden;">
            <div style="padding:12px 16px; border-bottom:1px solid var(--border); font-weight:600; font-size:0.9rem; display:flex; align-items:center; gap:8px;">
                Incomplete Schedule <small style="font-weight:400; color:var(--text-muted);">(fewer than 5 classes)</small>
                <% if (missingSchedule.length > 0) { %>
                    <span class="count-pill"><%= missingSchedule.length %></span>
                <% } %>
            </div>
            <% if (missingSchedule.length === 0) { %>
                <div style="padding:12px 16px;">
                    <div class="all-clear">&#10003; All campers have a full schedule.</div>
                </div>
            <% } else { %>
                <table class="flag-table">
                    <thead>
                        <tr>
                            <th>Camper</th>
                            <th>Group</th>
                            <th>Classes Found</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% missingSchedule.forEach(c => { %>
                        <tr>
                            <td><strong><%= c.FirstName %> <%= c.LastName %></strong></td>
                            <td><span class="tag <%= c.HomeGroupColor %>"><%= c.HomeGroupColor %></span></td>
                            <td>
                                <span class="flag-badge flag-error"><%= c.classCount %> / 5</span>
                            </td>
                            <td class="text-right"><a href="/camper/<%= c.CamperID %>" class="action-btn">View Profile</a></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>

    <%/* ── Counselor Flags ── */%>
    <div class="audit-section">
        <h2>
            Counselor Flags
            <% if (counselorMismatch.length > 0) { %>
                <span class="count-pill"><%= counselorMismatch.length %> issue<%= counselorMismatch.length !== 1 ? 's' : '' %></span>
            <% } else { %>
                <span class="count-pill count-ok">All clear</span>
            <% } %>
        </h2>

        <div class="card" style="padding:0; overflow:hidden;">
            <div style="padding:12px 16px; border-bottom:1px solid var(--border); font-weight:600; font-size:0.9rem; display:flex; align-items:center; gap:8px;">
                Class Count Mismatch
                <% if (counselorMismatch.length > 0) { %>
                    <span class="count-pill"><%= counselorMismatch.length %></span>
                <% } %>
            </div>
            <% if (counselorMismatch.length === 0) { %>
                <div style="padding:12px 16px;">
                    <div class="all-clear">&#10003; All counselor schedules match their expected class count.</div>
                </div>
            <% } else { %>
                <table class="flag-table">
                    <thead>
                        <tr>
                            <th>Counselor</th>
                            <th>Schedule Type</th>
                            <th>Classes Found</th>
                            <th>Expected</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% counselorMismatch.forEach(c => { %>
                        <tr>
                            <td><strong><%= c.FirstName %> <%= c.LastName %></strong></td>
                            <td><%= c.ScheduleType %></td>
                            <td><span class="flag-badge flag-error"><%= c.classCount %></span></td>
                            <td><span class="flag-badge flag-warn"><%= EXPECTED[c.ScheduleType] %></span></td>
                            <td class="text-right"><a href="/counselor-profile/<%= c.CounselorID %>" class="action-btn">View Profile</a></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
</div>

</body>
</html>
