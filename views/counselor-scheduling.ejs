                counselors.push({
                    counselorID:       cid,
                    homeGroupColor:    row.dataset.specialtyColor || null,
                    busRoute:          row.querySelector(`.cg-specialty-bus`)?.value.trim() || null,
                    scheduleType:      row.querySelector(`.cg-specialty-schedule`)?.value || null,
                    extendedHours:     row.querySelector(`.cg-specialty-extended`)?.value || null,
                    specialtyGroup:    null,
                    isWorkingThisWeek: row.querySelector(`.cg-specialty-working`)?.checked ? 1 : 0,
                });
            });

            try {
                const resp = await fetch('/save-counselor-group-assignments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ counselors, weekNumber: PLAN_WEEK })
                });
                if (resp.ok) {
                    btn.textContent = '✓ Saved!';
                    setTimeout(() => { btn.textContent = 'Save Group Assignments'; btn.disabled = false; }, 2500);
                } else {
                    btn.textContent = 'Error — try again'; btn.disabled = false;
                }
            } catch {
                btn.textContent = 'Error — try again'; btn.disabled = false;
            }
        }

        // ── Auto-Schedule Builder ────────────────────────────────────────────────
        function shuffle(arr) {
            const a = [...arr];
            for (let i = a.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [a[i], a[j]] = [a[j], a[i]];
            }
            return a;
        }

        // ── Mirror counselor assignments from another week ───────────────────────
        async function mirrorWeek(side) {
            const fromWeek = parseInt(document.getElementById('mirrorSourceWeek').value);
            const statusEl = document.getElementById('mirrorStatus');
            statusEl.textContent = 'Loading…';

            let prevRows;
            try {
                const resp = await fetch(`/counselor-week-assignments/${fromWeek}`);
                prevRows = await resp.json();
            } catch {
                statusEl.textContent = 'Error fetching source week.';
                return;
            }

            // activityName â†’ [counselorIDs] from source week
            const prevMap = {};
            prevRows.forEach(r => {
                if (!prevMap[r.ActivityName]) prevMap[r.ActivityName] = [];
                prevMap[r.ActivityName].push(r.CounselorID);
            });

            let mirrored = 0;
            OFFERINGS.forEach((act, idx) => {
                if (act.SideOfCamp !== side) return;
                const prev = prevMap[act.ActivityName];
                if (!prev || prev.length === 0) return; // class didn't exist or had no assignments

                const availIds = new Set(COUNSELORS.filter(c => {
                    const sel = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                    const sched = sel ? sel.value : (c.ScheduleType || '');
                    return sched && isCounselorAvailableFor(sched, act.PeriodNumber, side);
                }).map(c => c.CounselorID));

                // Only carry over counselors who are available in the planning week
                let candidates = shuffle(prev.filter(cid => availIds.has(cid)));

                const slotCount = state[idx].counselors.length || 1;
                // Randomly trim if more candidates than slots
                if (candidates.length > slotCount) candidates = candidates.slice(0, slotCount);

                // Ensure enough slots exist
                while (state[idx].counselors.length < slotCount) state[idx].counselors.push(null);

                // Fill from mirrored candidates (don't overwrite slots with values if already set)
                for (let i = 0; i < slotCount; i++) {
                    state[idx].counselors[i] = candidates[i] ?? null;
                }

                // Update count input to match
                const card = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                if (card) {
                    const cInput = card.querySelector('[data-count-type="counselors"]');
                    if (cInput) cInput.value = slotCount;
                }

                mirrored++;
            });

            renderAllFromState();
            updateAllCounters();
            updateGroupCounters();
            statusEl.textContent = `Mirrored ${mirrored} ${side} class${mirrored !== 1 ? 'es' : ''} from ${SESSIONS.find(s => s.weekNumber === fromWeek)?.label ?? `Week ${fromWeek}`}.`;
        }

        async function mirrorStaffOnly() {
            const fromWeek = parseInt(document.getElementById('mirrorSourceWeek').value);
            const statusEl = document.getElementById('mirrorStatus');
            statusEl.textContent = 'Loading…';

            let staffRows;
            try {
                const resp = await fetch(`/api/week-staff-assignments/${fromWeek}`);
                staffRows = await resp.json();
            } catch {
                statusEl.textContent = 'Error fetching source week.';
                return;
            }

            const staffMap = {};
            staffRows.forEach(r => {
                const key = `${r.PeriodNumber}|${r.ActivityName}`;
                if (!staffMap[key]) staffMap[key] = [];
                staffMap[key].push(r.PersonID);
            });

            const validStaffIds = new Set(STAFF_MEMBERS.map(s => s.StaffID));
            let mirrored = 0;
            OFFERINGS.forEach((act, idx) => {
                const prev = staffMap[`${act.PeriodNumber}|${act.ActivityName}`];
                if (!prev || prev.length === 0) return;
                const candidates = prev.filter(id => validStaffIds.has(id));
                if (candidates.length === 0) return;
                state[idx].staff = [...candidates];
                const card = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                if (card) {
                    const sInput = card.querySelector('[data-count-type="staff"]');
                    if (sInput) sInput.value = candidates.length;
                }
                mirrored++;
            });

            renderAllFromState();
            updateAllCounters();
            updateGroupCounters();
            const fromLabel = SESSIONS.find(s => s.weekNumber === fromWeek)?.label ?? `Week ${fromWeek}`;
            statusEl.textContent = `Mirrored UL/SL for ${mirrored} class${mirrored !== 1 ? 'es' : ''} from ${fromLabel}.`;
        }

        function submitMirrorLocation() {
            const fromWeek = document.getElementById('mirrorSourceWeek').value;
            if (!confirm(`Copy Sports locations from Week ${fromWeek} to Week ${PLAN_WEEK}? This saves immediately to the database.`)) return;
            document.getElementById('mirrorLocationFromWeek').value = fromWeek;
            document.getElementById('mirrorLocationForm').submit();
        }

        // Keep for manual "Auto Assign Homegroups" server-side button — not called from Full Auto.
        function autoAssignHomeGroups() {
            const prefMap = {};
            PREFERENCES.forEach(p => { prefMap[p.CounselorID] = p; });
            const colors = ['Red','Carolina','Green','Navy'];
            const totalCampers = colors.reduce((s, c) => s + (CAMPER_COUNTS[c] || 0), 0);
            if (totalCampers === 0 || MAIN_COUNSELORS.length === 0) return;

            const targets = {};
            let totalAssigned = 0;
            colors.forEach(c => {
                targets[c] = Math.floor(((CAMPER_COUNTS[c] || 0) / totalCampers) * MAIN_COUNSELORS.length);
                totalAssigned += targets[c];
            });
            const rem = MAIN_COUNSELORS.length - totalAssigned;
            colors.map(c => ({ c, frac: ((CAMPER_COUNTS[c]||0)/totalCampers)*MAIN_COUNSELORS.length - targets[c] }))
                .sort((a,b) => b.frac - a.frac).slice(0, rem).forEach(({c}) => targets[c]++);

            const assignedIds = new Set();
            const assignments = {};
            const targetsLeft = { ...targets };
            colors.forEach(color => {
                MAIN_COUNSELORS.filter(c => !assignedIds.has(c.CounselorID) && prefMap[c.CounselorID]?.HomeGroupPreference === color)
                    .slice(0, targetsLeft[color])
                    .forEach(c => { assignments[c.CounselorID] = color; assignedIds.add(c.CounselorID); targetsLeft[color]--; });
            });
            const unassigned = MAIN_COUNSELORS.filter(c => !assignedIds.has(c.CounselorID)).sort(() => Math.random() - 0.5);
            let offset = 0;
            for (const color of colors) {
                unassigned.slice(offset, offset + targetsLeft[color]).forEach(c => { assignments[c.CounselorID] = color; });
                offset += targetsLeft[color];
            }
            Object.entries(assignments).forEach(([cid, color]) => {
                const hg = document.querySelector(`.cg-homegroup[data-cid="${cid}"]`);
                if (hg) hg.value = color;
            });
            updateGroupCounters();
        }

        // ── Schedule type assignment (used by Full Auto Build) ───────────────────
        // Respects already-saved schedule types — only assigns free counselors.
        // Shows a modal if fixed types cannot satisfy quadrant demand.
        function autoAssignScheduleTypes(savedTypes) {
            const prefMap = {};
            PREFERENCES.forEach(p => { prefMap[p.CounselorID] = p; });

            const sMin = parseInt(document.getElementById('sportsMin').value)       || 2;
            const sThr = parseInt(document.getElementById('sportsThreshold').value) || 16;
            const sPer = parseInt(document.getElementById('sportsPer').value)       || 8;
            const eRed = parseInt(document.getElementById('enrichRed').value)       || 2;
            const eCar = parseInt(document.getElementById('enrichCarolina').value)  || 1;
            const eRC  = parseInt(document.getElementById('enrichRC').value)        || 2;
            const eGN  = parseInt(document.getElementById('enrichGN').value)        || 1;

            const demand = { amSports: 0, pmSports: 0, amEnrich: 0, pmEnrich: 0 };
            const slotTotals = {};
            OFFERINGS.forEach(act => {
                if (!act.PeriodNumber || !act.SideOfCamp) return;
                const key = `${act.PeriodNumber}_${act.SideOfCamp}`;
                let cnt;
                if (/hartt.+chamber/i.test(act.ActivityName)) {
                    cnt = 0;
                } else if (/archery/i.test(act.ActivityName)) {
                    cnt = 2;
                } else if (act.SideOfCamp === 'Sports') {
                    const enr = act.PreliminaryEnrollment || 0;
                    cnt = sMin + Math.ceil(Math.max(0, enr - sThr) / sPer);
                    if (/swim/i.test(act.ActivityName)) cnt = Math.min(cnt, 2);
                } else {
                    const ag = act.AllowedGroups || '';
                    cnt = ag === 'Red' ? eRed : ag === 'Carolina' ? eCar : ag === 'Red-Carolina' ? eRC : ag === 'Green-Navy' ? eGN : eRC;
                }
                slotTotals[key] = (slotTotals[key] || 0) + cnt;
            });
            Object.entries(slotTotals).forEach(([key, total]) => {
                const [p, side] = key.split('_');
                const am = parseInt(p) <= 3;
                if (side === 'Sports')      { if (am) demand.amSports = Math.max(demand.amSports, total); else demand.pmSports = Math.max(demand.pmSports, total); }
                else if (side === 'Enrichment') { if (am) demand.amEnrich = Math.max(demand.amEnrich, total); else demand.pmEnrich = Math.max(demand.pmEnrich, total); }
            });

            const COVERS = {
                'All Sports':                { amSports: 1, pmSports: 1, amEnrich: 0, pmEnrich: 0 },
                'All Enrichment':            { amSports: 0, pmSports: 0, amEnrich: 1, pmEnrich: 1 },
                'AM Sports / PM Enrichment': { amSports: 1, pmSports: 0, amEnrich: 0, pmEnrich: 1 },
                'AM Enrichment / PM Sports': { amSports: 0, pmSports: 1, amEnrich: 1, pmEnrich: 0 },
            };
            const VALID_TYPES = Object.keys(COVERS);

            function supplyFrom(typeMap) {
                const s = { amSports: 0, pmSports: 0, amEnrich: 0, pmEnrich: 0 };
                Object.values(typeMap).forEach(t => {
                    if (COVERS[t]) Object.keys(s).forEach(q => s[q] += COVERS[t][q]);
                });
                return s;
            }
            function scheduleIsValid(supply) {
                return supply.amSports >= demand.amSports && supply.pmSports >= demand.pmSports &&
                       supply.amEnrich >= demand.amEnrich && supply.pmEnrich >= demand.pmEnrich;
            }
            function mostNeededType(supply) {
                let best = null, bestScore = -1;
                for (const [type, cov] of Object.entries(COVERS)) {
                    const score = Object.keys(supply).reduce((acc, q) => acc + (cov[q] > 0 ? Math.max(0, demand[q] - supply[q]) : 0), 0);
                    if (score > bestScore) { bestScore = score; best = type; }
                }
                return best;
            }

            // Build assignment map: counselors with a saved type are fixed; others are free
            const typeAssignments = {};
            const freeCids = [];
            const prefCids = [];
            MAIN_COUNSELORS.forEach(c => {
                const cid = String(c.CounselorID);
                const saved = savedTypes[cid];
                if (saved && VALID_TYPES.includes(saved)) {
                    typeAssignments[cid] = saved; // locked — do not change
                } else {
                    const schedPref = prefMap[c.CounselorID]?.SchedulePreference;
                    if (schedPref && schedPref !== 'No Preference' && VALID_TYPES.includes(schedPref)) {
                        typeAssignments[cid] = schedPref;
                        prefCids.push(cid);
                    } else {
                        freeCids.push(cid);
                    }
                }
            });

            // Assign free counselors demand-first
            freeCids.forEach(cid => {
                typeAssignments[cid] = mostNeededType(supplyFrom(typeAssignments)) || 'All Sports';
            });

            // If supply still can't meet demand, override preference-only counselors
            if (!scheduleIsValid(supplyFrom(typeAssignments))) {
                for (const cid of shuffle(prefCids)) {
                    if (scheduleIsValid(supplyFrom(typeAssignments))) break;
                    const needed = mostNeededType(supplyFrom(typeAssignments));
                    if (needed) typeAssignments[cid] = needed;
                }
            }

            // If still invalid after all free reassignments, show shortfall modal
            const finalSupply = supplyFrom(typeAssignments);
            if (!scheduleIsValid(finalSupply)) {
                const lines = [];
                const labels = { amSports: 'AM Sports', pmSports: 'PM Sports', amEnrich: 'AM Enrichment', pmEnrich: 'PM Enrichment' };
                Object.keys(demand).forEach(q => {
                    const gap = demand[q] - finalSupply[q];
                    if (gap > 0) lines.push(`${gap} more ${labels[q]} counselor${gap !== 1 ? 's' : ''} needed`);
                });
                alert('Warning: Saved schedule types cannot fully satisfy demand.\n\n' + lines.join('\n') + '\n\nSchedule types have been assigned as best as possible. Consider updating manually before building.');
            }

            // Apply only to counselors that are NOT saved (don't overwrite fixed types)
            Object.entries(typeAssignments).forEach(([cid, type]) => {
                if (savedTypes[cid]) return; // saved type — leave DOM as-is
                const sc = document.querySelector(`.cg-schedule[data-cid="${cid}"]:not(.cg-specialty-schedule)`);
                if (sc) sc.value = type;
            });

            updateGroupCounters();
        }

        // Canonical block-used key: rec swim and swim lessons are the same class for scheduling purposes
        function blockKey(name) { return /swim/i.test(name) ? 'swim' : name; }

        // Minimum counselors for an enrichment offering based on period, enrollment, AllowedGroups, and configured inputs.
        // PM enrichment with ≤8 enrolled campers gets a reduced minimum of 1.
        function getEnrichMin(act) {
            const period     = act.PeriodNumber || 0;
            const enrollment = act.PreliminaryEnrollment || 0;
            if (period > 3 && enrollment <= 8) return 1;
            const ag   = act.AllowedGroups || '';
            const eRed = parseInt(document.getElementById('enrichRed').value)     || 2;
            const eCar = parseInt(document.getElementById('enrichCarolina').value) || 2;
            const eRC  = parseInt(document.getElementById('enrichRC').value)       || 2;
            const eGN  = parseInt(document.getElementById('enrichGN').value)       || 2;
            if (ag === 'Red')               return eRed;
            if (ag === 'Carolina')          return eCar;
            if (ag === 'Red-Carolina')      return eRC;
            if (ag === 'Green-Navy')        return eGN;
            return eRC;
        }

        function autoCalculateSlots() {
            const sportsMin       = parseInt(document.getElementById('sportsMin').value)       || 2;
            const sportsThreshold = parseInt(document.getElementById('sportsThreshold').value) || 16;
            const sportsPer       = parseInt(document.getElementById('sportsPer').value)       || 8;
            const enrichRed       = parseInt(document.getElementById('enrichRed').value)       || 2;
            const enrichCarolina  = parseInt(document.getElementById('enrichCarolina').value)  || 2;
            const enrichRC        = parseInt(document.getElementById('enrichRC').value)        || 2;
            const enrichGN        = parseInt(document.getElementById('enrichGN').value)        || 2;

            // Step 1: Compute raw slot counts (skip offerings already manually set)
            const rawCounts = {};
            OFFERINGS.forEach((act, idx) => {
                if (!act.PeriodNumber || !act.SideOfCamp) return;
                if (lockedOfferings.has(idx)) return; // never touch locked classes

                // Hard limits: always enforce regardless of existing state
                if (/hartt.+chamber/i.test(act.ActivityName) || /learning.zone/i.test(act.ActivityName)) {
                    state[idx].counselors = [];
                    state[idx].staff = [];
                    const hCard = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                    if (hCard) {
                        const hC = hCard.querySelector('[data-count-type="counselors"]');
                        if (hC) hC.value = 0;
                        const hS = hCard.querySelector('[data-count-type="staff"]');
                        if (hS) hS.value = 0;
                    }
                    return;
                }
                if (/swim/i.test(act.ActivityName) && state[idx].counselors.length > 2) {
                    state[idx].counselors = state[idx].counselors.slice(0, 2);
                    const swCard = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                    if (swCard) {
                        const swC = swCard.querySelector('[data-count-type="counselors"]');
                        if (swC) swC.value = 2;
                    }
                }
                if (/archery/i.test(act.ActivityName) && state[idx].counselors.length > 2) {
                    state[idx].counselors = state[idx].counselors.slice(0, 2);
                    const arCard = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                    if (arCard) {
                        const arC = arCard.querySelector('[data-count-type="counselors"]');
                        if (arC) arC.value = 2;
                    }
                }

                // If all existing slots are already filled (all pinned), skip calculation
                if (state[idx].counselors.length !== 0 && !state[idx].counselors.includes(null)) return;

                // Respect counts the user manually typed before running Full Auto Build
                const mcPre = manualCounts[idx]?.counselors;
                if (mcPre != null) {
                    // Pad pinned counselors up to the manual count with nulls
                    while (state[idx].counselors.length < mcPre) state[idx].counselors.push(null);
                    return;
                }

                let count;
                if (/archery/i.test(act.ActivityName)) {
                    count = 2;
                } else if (act.SideOfCamp === 'Sports') {
                    const enrollment = act.PreliminaryEnrollment || 0;
                    count = sportsMin + Math.ceil(Math.max(0, enrollment - sportsThreshold) / sportsPer);
                    if (/swim/i.test(act.ActivityName)) count = Math.min(count, 2);
                } else {
                    const enrollment = act.PreliminaryEnrollment || 0;
                    if (act.PeriodNumber > 3 && enrollment <= 8) {
                        // PM enrichment with small classes: reduced minimum of 1
                        count = 1;
                    } else {
                        const ag = act.AllowedGroups || '';
                        if (ag === 'Red')               count = enrichRed;
                        else if (ag === 'Carolina')     count = enrichCarolina;
                        else if (ag === 'Red-Carolina') count = enrichRC;
                        else if (ag === 'Green-Navy')   count = enrichGN;
                        else                            count = enrichRC;
                    }
                }
                rawCounts[idx] = count;
            });

            // Step 2: Bucket raw counts by period+side; compute supply from current DOM ScheduleTypes
            const buckets = {};
            Object.keys(rawCounts).forEach(idxStr => {
                const idx = parseInt(idxStr);
                const act = OFFERINGS[idx];
                const key = `${act.PeriodNumber}_${act.SideOfCamp}`;
                if (!buckets[key]) {
                    const period = act.PeriodNumber;
                    const side   = act.SideOfCamp;
                    const avail  = getAssignablePool().filter(c => {
                        const sel   = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                        const sched = sel ? sel.value : (c.ScheduleType || '');
                        return sched && isCounselorAvailableFor(sched, period, side);
                    }).length;
                    buckets[key] = { totalRaw: 0, indices: [], avail };
                }
                buckets[key].totalRaw += rawCounts[idx];
                buckets[key].indices.push(idx);
            });

            // Step 3: Scale down per bucket where raw demand exceeds known supply
            const finalCounts = { ...rawCounts };
            Object.values(buckets).forEach(({ totalRaw, indices, avail }) => {
                if (avail === 0 || totalRaw <= avail) return; // no supply data or already within budget
                const scale = avail / totalRaw;
                let used = 0;
                indices.forEach(idx => {
                    // Enrichment classes have small fixed requirements — never scale below configured min.
                    // Sports classes scale down when over-subscribed.
                    finalCounts[idx] = OFFERINGS[idx].SideOfCamp === 'Enrichment'
                        ? rawCounts[idx]
                        : rawCounts[idx] === 0 ? 0 : Math.max(1, Math.floor(rawCounts[idx] * scale));
                    used += finalCounts[idx];
                });
                // Distribute remainder to highest-enrollment offerings
                let rem = avail - used;
                [...indices]
                    .filter(idx => rawCounts[idx] > 0)
                    .sort((a, b) => (OFFERINGS[b].PreliminaryEnrollment || 0) - (OFFERINGS[a].PreliminaryEnrollment || 0))
                    .forEach(idx => {
                        if (rem <= 0) return;
                        finalCounts[idx]++;
                        rem--;
                    });
            });

            // Step 4: Apply to state and DOM — pad pinned counselors with nulls to target count
            OFFERINGS.forEach((act, idx) => {
                if (finalCounts[idx] == null) return;
                const target = finalCounts[idx];
                // Keep already-pinned (non-null) entries; add nulls for remaining slots
                const pinned = state[idx].counselors.filter(id => id !== null);
                const extra = Math.max(0, target - pinned.length);
                state[idx].counselors = [...pinned, ...Array(extra).fill(null)];
                const card = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                if (card) {
                    const inp = card.querySelector('[data-count-type="counselors"]');
                    if (inp) inp.value = state[idx].counselors.length;
                }
            });

            renderAllFromState();
            updateAllCounters();
        }

        function buildSchedule(forceReset = false) {
            const mode = document.querySelector('input[name="autoMode"]:checked').value;
            const statusEl = document.getElementById('autoStatus');
            statusEl.textContent = 'Building…';

            // Step 1: Set slot counts from slot calculation rules.
            // forceReset restores pinned (manually-saved) counselors for non-locked offerings
            // and clears auto-assigned slots, so autoCalculateSlots can pad to target count.
            // Staff/UL arrays are intentionally NOT cleared — they must survive the reset.
            if (forceReset) {
                OFFERINGS.forEach((_, idx) => {
                    if (lockedOfferings.has(idx)) return;
                    // Restore pinned (saved) counselors; null slots will be recalculated
                    state[idx].counselors = [...(pinnedCounselors[idx] || [])];
                });
            }
            autoCalculateSlots();

            const prefMap = {};
            PREFERENCES.forEach(p => { prefMap[p.CounselorID] = p; });

            // Track activity names a counselor has been placed in per AM/PM block
            const blockUsed = {};
            COUNSELORS.forEach(c => { blockUsed[c.CounselorID] = { am: new Set(), pm: new Set() }; });

            // Pre-load any non-null slots into blockUsed (autoCalculateSlots sets all to null,
            // so this handles any slots pre-populated before calling buildSchedule)
            OFFERINGS.forEach((act, idx) => {
                if (!act.PeriodNumber) return;
                const block = act.PeriodNumber <= 3 ? 'am' : 'pm';
                state[idx].counselors.forEach(id => {
                    if (id && id !== -1 && blockUsed[id]) blockUsed[id][block].add(blockKey(act.ActivityName));
                });
            });

            // Track which counselors are already placed in each period
            const usedThisPeriod = {};
            for (let p = 1; p <= 6; p++) usedThisPeriod[p] = new Set();
            OFFERINGS.forEach((act, idx) => {
                if (!act.PeriodNumber) return;
                state[idx].counselors.forEach(id => { if (id && id !== -1) usedThisPeriod[act.PeriodNumber].add(id); });
                state[idx].staff.forEach(id => { if (id && id !== -1) usedThisPeriod[act.PeriodNumber].add(id); });
            });

            // Pre-fill: assign the same counselors across ALL periods of triple-period activities
            // (e.g. "Sports Pals (triple period)") before the greedy loop runs, so it can't
            // scatter different counselors into each period.
            const tripleGroupsPre = {};
            OFFERINGS.forEach((act, idx) => {
                if (!act.ActivityName.toLowerCase().includes('triple period')) return;
                if (!tripleGroupsPre[act.ActivityName]) tripleGroupsPre[act.ActivityName] = [];
                tripleGroupsPre[act.ActivityName].push(idx);
            });
            for (const [tName, tIndices] of Object.entries(tripleGroupsPre)) {
                if (tIndices.length < 2) continue;
                tIndices.sort((a, b) => OFFERINGS[a].PeriodNumber - OFFERINGS[b].PeriodNumber);

                // If any period is locked, propagate its counselors to unlocked periods instead
                // of running the pool-based logic (which would exclude the locked counselors from
                // the eligible pool and overwrite the locked state with wrong counselors).
                const lockedIdx = tIndices.find(i => lockedOfferings.has(i));
                if (lockedIdx != null) {
                    const lockedCounselors = state[lockedIdx].counselors.filter(id => id && id !== -1);
                    const tBlock = OFFERINGS[lockedIdx].PeriodNumber <= 3 ? 'am' : 'pm';
                    for (const tidx of tIndices) {
                        if (lockedOfferings.has(tidx)) continue;
                        while (state[tidx].counselors.length < lockedCounselors.length) state[tidx].counselors.push(null);
                        lockedCounselors.forEach((cId, slot) => {
                            state[tidx].counselors[slot] = cId;
                            usedThisPeriod[OFFERINGS[tidx].PeriodNumber].add(cId);
                            if (blockUsed[cId]) blockUsed[cId][tBlock].add(blockKey(tName));
                        });
                    }
                    continue;
                }

                const srcIdx    = tIndices[0];
                const srcPeriod = OFFERINGS[srcIdx].PeriodNumber;
                const tSide     = OFFERINGS[srcIdx].SideOfCamp;
                const tBlock    = srcPeriod <= 3 ? 'am' : 'pm';
                const slotCount = state[srcIdx].counselors.length;
                // Eligible for the source period (skip same-name blockUsed; repeat is intentional)
                const tEligible = getAssignablePool().filter(c => {
                    if (usedThisPeriod[srcPeriod].has(c.CounselorID)) return false;
                    if ((STAFF_BUSY[c.CounselorID] || []).includes(srcPeriod)) return false;
                    const sel   = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                    const sched = sel ? sel.value : (c.ScheduleType || '');
                    return isCounselorAvailableFor(sched, srcPeriod, tSide);
                });
                const tPreferred = shuffle(tEligible.filter(c =>  prefMap[c.CounselorID]?.ActivityPreferences?.includes(tName)));
                const tNonPref   = shuffle(tEligible.filter(c => !prefMap[c.CounselorID]?.ActivityPreferences?.includes(tName)));
                const tPool = mode === 'pref' ? [...tPreferred] : [...tPreferred, ...tNonPref];
                for (let slot = 0; slot < slotCount; slot++) {
                    if (!tPool[slot]) break;
                    const chosen = tPool[slot];
                    for (const tidx of tIndices) {
                        if (lockedOfferings.has(tidx)) continue; // never overwrite locked periods
                        while (state[tidx].counselors.length <= slot) state[tidx].counselors.push(null);
                        state[tidx].counselors[slot] = chosen.CounselorID;
                        usedThisPeriod[OFFERINGS[tidx].PeriodNumber].add(chosen.CounselorID);
                    }
                    blockUsed[chosen.CounselorID][tBlock].add(blockKey(tName));
                }
            }

            // Step 2: Greedy fill — each iteration places one counselor in the class with the
            // highest enrollment / placed-counselors ratio (highest need first).
            // Zero-placed classes always take priority; among those, higher enrollment wins.
            // Slots that cannot be filled are marked -1 (sentinel) and restored to null at the end.
            let madeProgress = true;
            while (madeProgress) {
                madeProgress = false;

                let bestIdx = -1, bestRatio = -Infinity;
                OFFERINGS.forEach((act, idx) => {
                    if (!act.PeriodNumber || !act.SideOfCamp) return;
                    if (lockedOfferings.has(idx)) return; // skip locked
                    if (!state[idx].counselors.some(id => id === null)) return;
                    const placed = state[idx].counselors.filter(id => id !== null && id !== -1).length;
                    const enrollment = act.PreliminaryEnrollment || 0;
                    const ratio = placed === 0 ? (1e9 + enrollment) : (enrollment / placed);
                    if (ratio > bestRatio) { bestRatio = ratio; bestIdx = idx; }
                });

                if (bestIdx === -1) break;

                const act    = OFFERINGS[bestIdx];
                const period = act.PeriodNumber;
                const side   = act.SideOfCamp;
                const name   = act.ActivityName;
                const block  = period <= 3 ? 'am' : 'pm';
                const oppBlock = block === 'am' ? 'pm' : 'am';
                const slotPos  = state[bestIdx].counselors.indexOf(null);

                const eligible = getAssignablePool().filter(c => {
                    if (usedThisPeriod[period].has(c.CounselorID)) return false;
                    if ((STAFF_BUSY[c.CounselorID] || []).includes(period)) return false;
                    const sel = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                    const sched = sel ? sel.value : (c.ScheduleType || '');
                    if (!isCounselorAvailableFor(sched, period, side)) return false;
                    if (blockUsed[c.CounselorID]?.[block].has(blockKey(name))) return false;
                    return true;
                });

                const preferred = shuffle(eligible.filter(c =>  prefMap[c.CounselorID]?.ActivityPreferences?.includes(name)));
                const nonPref   = shuffle(eligible.filter(c => !prefMap[c.CounselorID]?.ActivityPreferences?.includes(name)));
                const pool = mode === 'pref' ? [...preferred] : [...preferred, ...nonPref];

                if (pool.length === 0) {
                    state[bestIdx].counselors[slotPos] = -1; // unfillable sentinel
                } else {
                    const chosen = pool[0];
                    state[bestIdx].counselors[slotPos] = chosen.CounselorID;
                    usedThisPeriod[period].add(chosen.CounselorID);
                    blockUsed[chosen.CounselorID][block].add(blockKey(name));
                }
                madeProgress = true;
            }

            // Restore -1 sentinels to null (slots that couldn't be filled)
            OFFERINGS.forEach((_, idx) => {
                state[idx].counselors = state[idx].counselors.map(id => (id === -1 ? null : id));
            });

            // Enforce same counselors across all periods of triple-period activities.
            // Lowest period is authoritative; subsequent periods are overridden to match.
            const tripleGroups = {};
            OFFERINGS.forEach((act, idx) => {
                if (!act.ActivityName.toLowerCase().includes('triple period')) return;
                if (!tripleGroups[act.ActivityName]) tripleGroups[act.ActivityName] = [];
                tripleGroups[act.ActivityName].push(idx);
            });
            for (const [, indices] of Object.entries(tripleGroups)) {
                if (indices.length < 2) continue;
                indices.sort((a, b) => OFFERINGS[a].PeriodNumber - OFFERINGS[b].PeriodNumber);
                const maxSlots = Math.max(...indices.map(i => state[i].counselors.length));
                for (let slot = 0; slot < maxSlots; slot++) {
                    const cId = state[indices[0]].counselors[slot] ?? null;
                    if (cId === null) continue;
                    for (const idx of indices.slice(1)) {
                        if (lockedOfferings.has(idx)) continue; // never overwrite locked periods
                        if (state[idx].counselors.length <= slot) {
                            const mc = manualCounts[idx]?.counselors;
                            if (mc == null || state[idx].counselors.length < mc) state[idx].counselors.push(cId);
                        } else {
                            state[idx].counselors[slot] = cId;
                        }
                    }
                }
            }

            // Remove unfilled null slots, but preserve manually-set counts and enrichment minimums
            OFFERINGS.forEach((act, idx) => {
                state[idx].counselors = state[idx].counselors.filter(id => id !== null);
                const mc = manualCounts[idx]?.counselors;
                const floor = mc != null ? mc : (act.SideOfCamp === 'Enrichment' ? getEnrichMin(act) : 0);
                while (state[idx].counselors.length < floor) state[idx].counselors.push(null);
                const card = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                if (card) {
                    const inp = card.querySelector('[data-count-type="counselors"]');
                    if (inp) inp.value = state[idx].counselors.length;
                }
            });

            renderAllFromState();
            updateAllCounters();
            updateGroupCounters();
            statusEl.textContent = 'Schedule built. Checking for extra counselors…';
        }

        function fillExtraCounselors() {
            const statusEl = document.getElementById('autoStatus');
            statusEl.textContent = 'Placing extra counselors…';

            const prefMap = {};
            PREFERENCES.forEach(p => { prefMap[p.CounselorID] = p; });
            const mode = document.querySelector('input[name="autoMode"]:checked').value;

            // Rebuild blockUsed from the current fully-built state
            const blockUsed = {};
            COUNSELORS.forEach(c => { blockUsed[c.CounselorID] = { am: new Set(), pm: new Set() }; });
            OFFERINGS.forEach((act, idx) => {
                if (!act.PeriodNumber) return;
                const block = act.PeriodNumber <= 3 ? 'am' : 'pm';
                state[idx].counselors.forEach(id => {
                    if (id && blockUsed[id]) blockUsed[id][block].add(blockKey(act.ActivityName));
                });
            });

            let totalAdded = 0;

            for (let period = 1; period <= 6; period++) {
                const block = period <= 3 ? 'am' : 'pm';
                const oppBlock = block === 'am' ? 'pm' : 'am';

                // Build usedThisPeriod from current state
                const usedThisPeriod = new Set();
                OFFERINGS.forEach((a, i) => {
                    if (a.PeriodNumber === period) {
                        state[i].counselors.forEach(id => { if (id) usedThisPeriod.add(id); });
                        state[i].staff.forEach(id => { if (id) usedThisPeriod.add(id); });
                    }
                });

                for (const side of ['Sports', 'Enrichment']) {
                    // Counselors that should be in this period+side but aren't placed
                    const extras = getAssignablePool().filter(c => {
                        if (usedThisPeriod.has(c.CounselorID)) return false;
                        if ((STAFF_BUSY[c.CounselorID] || []).includes(period)) return false;
                        const schedSel = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                        const sched = schedSel ? schedSel.value : (c.ScheduleType || '');
                        return isCounselorAvailableFor(sched, period, side);
                    });
                    if (extras.length === 0) continue;

                    // Eligible offerings for this period+side (exclude Hartt Chamber placeholder which always has 0 counselors)
                    const eligibleIdxs = [];
                    OFFERINGS.forEach((act, idx) => {
                        if (act.PeriodNumber !== period || act.SideOfCamp !== side) return;
                        if (/hartt.+chamber/i.test(act.ActivityName) || /learning.zone/i.test(act.ActivityName)) return;
                        if (lockedOfferings.has(idx)) return; // skip locked
                        eligibleIdxs.push(idx);
                    });
                    if (eligibleIdxs.length === 0) continue;

                    // Phase 1: Fill existing null slots before adding new ones.
                    // Sort so classes with the most unfilled slots get first pick of extras.
                    eligibleIdxs.sort((a, b) => {
                        const nullA = state[a].counselors.filter(id => id === null).length;
                        const nullB = state[b].counselors.filter(id => id === null).length;
                        return nullB - nullA;
                    });
                    const extrasPool = [...extras];
                    for (const eligIdx of eligibleIdxs) {
                        if (extrasPool.length === 0) break;
                        const actName = OFFERINGS[eligIdx].ActivityName;
                        state[eligIdx].counselors.forEach((id, slotPos) => {
                            if (id !== null || extrasPool.length === 0) return;
                            const eligible_e = extrasPool.filter(c => {
                                if (blockUsed[c.CounselorID]?.[block].has(blockKey(actName))) return false;
                                return true;
                            });
                            const preferred = shuffle(eligible_e.filter(c =>  prefMap[c.CounselorID]?.ActivityPreferences?.includes(actName)));
                            const nonPref   = shuffle(eligible_e.filter(c => !prefMap[c.CounselorID]?.ActivityPreferences?.includes(actName)));
                            const chosen    = mode === 'pref' ? (preferred[0] ?? null) : (preferred[0] ?? nonPref[0]);
                            if (!chosen) return;
                            state[eligIdx].counselors[slotPos] = chosen.CounselorID;
                            usedThisPeriod.add(chosen.CounselorID);
                            blockUsed[chosen.CounselorID][block].add(blockKey(actName));
                            extrasPool.splice(extrasPool.indexOf(chosen), 1);
                            totalAdded++;
                        });
                    }

                    // Never give extras to a well-staffed class while another class in this
                    // period+side is still missing required counselors (slot count = minimum)
                    if (eligibleIdxs.some(idx => state[idx].counselors.some(id => id === null))) continue;

                    // Phase 2: For remaining extras, add new slots
                    const newSlots = [];
                    for (const extra of extrasPool) {
                        // Only target activities not already run in this block; cross-block repeat only if preferred
                        const valid = eligibleIdxs.filter(idx => {
                            const actName = OFFERINGS[idx].ActivityName;
                            if (blockUsed[extra.CounselorID][block].has(blockKey(actName))) return false;
                            return true;
                        });
                        if (valid.length === 0) continue;
                        const targetIdx = valid.reduce((best, idx) => {
                            const bestRatio = (OFFERINGS[best].PreliminaryEnrollment || 0) / Math.max(state[best].counselors.length, 1);
                            const idxRatio  = (OFFERINGS[idx].PreliminaryEnrollment || 0) / Math.max(state[idx].counselors.length, 1);
                            return idxRatio > bestRatio ? idx : best;
                        });
                        const mc  = manualCounts[targetIdx]?.counselors;
                        const cap = Math.min(
                            /swim/i.test(OFFERINGS[targetIdx].ActivityName)    ? 2         : Infinity,
                            /archery/i.test(OFFERINGS[targetIdx].ActivityName) ? 2         : Infinity,
                            OFFERINGS[targetIdx].SideOfCamp === 'Enrichment'   ? 3         : Infinity
                        );
                        if ((mc == null || state[targetIdx].counselors.length < mc) && state[targetIdx].counselors.length < cap) {
                            state[targetIdx].counselors.push(null);
                            newSlots.push({ idx: targetIdx, slotPos: state[targetIdx].counselors.length - 1 });
                        }
                    }

                    // Fill new slots
                    const remaining = new Set(extrasPool.map(c => c.CounselorID));
                    for (const { idx, slotPos } of newSlots) {
                        if (state[idx].counselors[slotPos] != null) continue;
                        const actName = OFFERINGS[idx].ActivityName;
                        const eligible_r = [...remaining].filter(cid => {
                            if (blockUsed[cid]?.[block].has(blockKey(actName))) return false;
                            return true;
                        });
                        const preferred = shuffle(eligible_r.filter(cid =>  prefMap[cid]?.ActivityPreferences?.includes(actName)));
                        const nonPref   = shuffle(eligible_r.filter(cid => !prefMap[cid]?.ActivityPreferences?.includes(actName)));
                        const chosen    = mode === 'pref' ? (preferred[0] ?? null) : (preferred[0] ?? nonPref[0]);
                        if (chosen == null) continue;
                        state[idx].counselors[slotPos] = chosen;
                        usedThisPeriod.add(chosen);
                        blockUsed[chosen][block].add(blockKey(actName));
                        remaining.delete(chosen);
                        totalAdded++;
                    }
                }
            }

            // Phase 3: Force-place any counselors still missing from required periods (ignores slot caps)
            for (let p3 = 1; p3 <= 6; p3++) {
                const block3 = p3 <= 3 ? 'am' : 'pm';

                const usedP3 = new Set();
                OFFERINGS.forEach((a, i) => {
                    if (a.PeriodNumber === p3) {
                        state[i].counselors.forEach(id => { if (id) usedP3.add(id); });
                        state[i].staff.forEach(id => { if (id) usedP3.add(id); });
                    }
                });

                for (const side3 of ['Sports', 'Enrichment']) {
                    const unplaced = getAssignablePool().filter(c => {
                        if (usedP3.has(c.CounselorID)) return false;
                        if ((STAFF_BUSY[c.CounselorID] || []).includes(p3)) return false;
                        const sel3   = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                        const sched3 = sel3 ? sel3.value : (c.ScheduleType || '');
                        return isCounselorAvailableFor(sched3, p3, side3);
                    });
                    if (unplaced.length === 0) continue;

                    const tIdxs = [];
                    OFFERINGS.forEach((act, idx) => {
                        if (act.PeriodNumber !== p3 || act.SideOfCamp !== side3) return;
                        if (/hartt.+chamber/i.test(act.ActivityName) || /learning.zone/i.test(act.ActivityName)) return;
                        if (lockedOfferings.has(idx)) return; // skip locked
                        tIdxs.push(idx);
                    });
                    if (tIdxs.length === 0) continue;

                    for (const c of unplaced) {
                        // Prefer variety (no repeated activity name in same block); fall back if needed
                        const belowCap = idx => {
                            const a = OFFERINGS[idx];
                            if (/swim/i.test(a.ActivityName)    && state[idx].counselors.length >= 2) return false;
                            if (/archery/i.test(a.ActivityName) && state[idx].counselors.length >= 2) return false;
                            return true;
                        };
                        let valid = tIdxs.filter(idx =>
                            belowCap(idx) &&
                            !blockUsed[c.CounselorID]?.[block3].has(blockKey(OFFERINGS[idx].ActivityName)) &&
                            !state[idx].counselors.includes(c.CounselorID)
                        );
                        if (valid.length === 0) valid = tIdxs.filter(idx => belowCap(idx) && !state[idx].counselors.includes(c.CounselorID));
                        if (valid.length === 0) continue;

                        const tIdx = valid.reduce((best, idx) => {
                            const bR = (OFFERINGS[best].PreliminaryEnrollment || 0) / Math.max(state[best].counselors.length, 1);
                            const iR = (OFFERINGS[idx].PreliminaryEnrollment  || 0) / Math.max(state[idx].counselors.length,  1);
                            return iR > bR ? idx : best;
                        });
                        state[tIdx].counselors.push(c.CounselorID);
                        usedP3.add(c.CounselorID);
                        if (blockUsed[c.CounselorID]) blockUsed[c.CounselorID][block3].add(blockKey(OFFERINGS[tIdx].ActivityName));
                        totalAdded++;
                    }
                }
            }

            // Re-sync triple-period activities so any newly added counselors stay consistent
            const tripleGroups2 = {};
            OFFERINGS.forEach((act, idx) => {
                if (!act.ActivityName.toLowerCase().includes('triple period')) return;
                if (!tripleGroups2[act.ActivityName]) tripleGroups2[act.ActivityName] = [];
                tripleGroups2[act.ActivityName].push(idx);
            });
            for (const [, indices] of Object.entries(tripleGroups2)) {
                if (indices.length < 2) continue;
                indices.sort((a, b) => OFFERINGS[a].PeriodNumber - OFFERINGS[b].PeriodNumber);
                const maxSlots = Math.max(...indices.map(i => state[i].counselors.length));
                for (let slot = 0; slot < maxSlots; slot++) {
                    const cId = state[indices[0]].counselors[slot] ?? null;
                    if (cId === null) continue;

                    for (const idx of indices.slice(1)) {
                        if (lockedOfferings.has(idx)) continue; // never overwrite locked periods
                        if (state[idx].counselors.length <= slot) {
                            const mc = manualCounts[idx]?.counselors;
                            if (mc == null || state[idx].counselors.length < mc) state[idx].counselors.push(cId);
                        } else {
                            state[idx].counselors[slot] = cId;
                        }
                    }
                }
            }

            // Remove unfilled null slots, but preserve manually-set counts and enrichment minimums
            OFFERINGS.forEach((act, idx) => {
                state[idx].counselors = state[idx].counselors.filter(id => id !== null);
                const mc = manualCounts[idx]?.counselors;
                const floor = mc != null ? mc : (act.SideOfCamp === 'Enrichment' ? getEnrichMin(act) : 0);
                while (state[idx].counselors.length < floor) state[idx].counselors.push(null);
                const card = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                if (card) {
                    const inp = card.querySelector('[data-count-type="counselors"]');
                    if (inp) inp.value = state[idx].counselors.length;
                }
            });

            renderAllFromState();
            updateAllCounters();
            updateGroupCounters();
            statusEl.textContent = totalAdded > 0
                ? `Done! ${totalAdded} extra counselor slot${totalAdded !== 1 ? 's' : ''} added. Review and save when ready.`
                : 'Done! Review and save when ready.';
        }

        // ── Side-specific rebuild ─────────────────────────────────────────────────
        // Re-scrambles only the counselors currently assigned to one side (Sports or Enrichment).
        // The other side's assignments are never touched.
        function rebuildSide(targetSide) {
            const statusEl = document.getElementById('autoStatus');
            const mode     = document.querySelector('input[name="autoMode"]:checked').value;
            const prefMap  = {};
            PREFERENCES.forEach(p => { prefMap[p.CounselorID] = p; });

            // Collect the rebuild pool: counselors currently assigned to any unlocked target-side class
            const rebuildPoolIds = new Set();
            OFFERINGS.forEach((act, idx) => {
                if (act.SideOfCamp !== targetSide || lockedOfferings.has(idx)) return;
                state[idx].counselors.forEach(id => { if (id) rebuildPoolIds.add(id); });
            });
            if (rebuildPoolIds.size === 0) {
                statusEl.textContent = `No counselors assigned to unlocked ${targetSide} classes to rebuild.`;
                return;
            }
            const rebuildPool = getAssignablePool().filter(c => rebuildPoolIds.has(c.CounselorID));
            statusEl.textContent = `Rebuilding ${targetSide}…`;

            // Clear unlocked target-side counselors only; autoCalculateSlots recalculates empty arrays.
            OFFERINGS.forEach((act, idx) => {
                if (act.SideOfCamp === targetSide && !lockedOfferings.has(idx)) state[idx].counselors = [];
            });
            autoCalculateSlots();
            // Snapshot enrollment-based demand counts
            const calcSlots = {};
            OFFERINGS.forEach((act, idx) => {
                if (act.SideOfCamp === targetSide && !lockedOfferings.has(idx))
                    calcSlots[idx] = state[idx].counselors.length;
            });

            // Supply-aware redistribution: for each period, count how many rebuild-pool counselors
            // are actually available, and if that's less than total demand, redistribute slots
            // proportionally (by enrollment) so the greedy loop can fill every opened slot.
            for (let p = 1; p <= 6; p++) {
                const items = [];
                OFFERINGS.forEach((act, idx) => {
                    if (act.PeriodNumber !== p || act.SideOfCamp !== targetSide || lockedOfferings.has(idx)) return;
                    const demand = calcSlots[idx] ?? 0;
                    if (demand === 0) return; // hard-limited (Hartt, LearningZone, etc.)
                    items.push({ idx, demand, enrollment: act.PreliminaryEnrollment || 0 });
                });
                if (items.length === 0) continue;

                const supply = rebuildPool.filter(c => {
                    if (usedThisPeriod[p].has(c.CounselorID)) return false;
                    if ((STAFF_BUSY[c.CounselorID] || []).includes(p)) return false;
                    const sel = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                    const sched = sel ? sel.value : (c.ScheduleType || '');
                    return isCounselorAvailableFor(sched, p, targetSide);
                }).length;

                const totalDemand = items.reduce((s, { demand }) => s + demand, 0);
                if (supply >= totalDemand) continue; // enough — keep enrollment-based counts

                // Not enough supply: distribute 'supply' slots across offerings.
                // Phase 1: give each offering 1 slot (ordered by enrollment desc), down to 0 if out.
                // Phase 2: distribute remaining proportionally by enrollment, up to each offering's demand.
                const alloc = {};
                items.forEach(({ idx }) => { alloc[idx] = 0; });
                const byEnroll = [...items].sort((a, b) => b.enrollment - a.enrollment);
                let rem = supply;

                for (const { idx } of byEnroll) {
                    if (rem <= 0) break;
                    alloc[idx] = 1;
                    rem--;
                }
                if (rem > 0) {
                    const totalE = items.reduce((s, { enrollment }) => s + Math.max(enrollment, 1), 0);
                    for (const { idx, demand, enrollment } of byEnroll) {
                        if (rem <= 0) break;
                        const share = Math.min(
                            Math.round(supply * Math.max(enrollment, 1) / totalE) - alloc[idx],
                            demand - alloc[idx],
                            rem
                        );
                        if (share > 0) { alloc[idx] += share; rem -= share; }
                    }
                    // Flush any leftover to offerings still below demand
                    for (const { idx, demand } of byEnroll) {
                        if (rem <= 0) break;
                        const add = Math.min(demand - alloc[idx], rem);
                        if (add > 0) { alloc[idx] += add; rem -= add; }
                    }
                }

                items.forEach(({ idx }) => {
                    state[idx].counselors = Array(alloc[idx]).fill(null);
                    calcSlots[idx] = alloc[idx]; // update cap for fill phases
                });
            }

            // Seed blockUsed from: other side AND locked target-side classes (all stay untouched)
            const blockUsed = {};
            COUNSELORS.forEach(c => { blockUsed[c.CounselorID] = { am: new Set(), pm: new Set() }; });
            OFFERINGS.forEach((act, idx) => {
                if (!act.PeriodNumber) return;
                if (act.SideOfCamp !== targetSide || lockedOfferings.has(idx)) {
                    const block = act.PeriodNumber <= 3 ? 'am' : 'pm';
                    state[idx].counselors.forEach(id => {
                        if (id && blockUsed[id]) blockUsed[id][block].add(blockKey(act.ActivityName));
                    });
                }
            });

            // usedThisPeriod: pre-lock other-side AND locked target-side counselors; always lock staff
            const usedThisPeriod = {};
            for (let p = 1; p <= 6; p++) usedThisPeriod[p] = new Set();
            OFFERINGS.forEach((act, idx) => {
                if (!act.PeriodNumber) return;
                if (act.SideOfCamp !== targetSide || lockedOfferings.has(idx)) {
                    state[idx].counselors.forEach(id => { if (id) usedThisPeriod[act.PeriodNumber].add(id); });
                }
                state[idx].staff.forEach(id => { if (id) usedThisPeriod[act.PeriodNumber].add(id); });
            });

            // Triple-period pre-fill (target side only)
            const tripleGroupsPre = {};
            OFFERINGS.forEach((act, idx) => {
                if (act.SideOfCamp !== targetSide || !act.ActivityName.toLowerCase().includes('triple period')) return;
                if (!tripleGroupsPre[act.ActivityName]) tripleGroupsPre[act.ActivityName] = [];
                tripleGroupsPre[act.ActivityName].push(idx);
            });
            for (const [tName, tIndices] of Object.entries(tripleGroupsPre)) {
                if (tIndices.length < 2) continue;
                tIndices.sort((a, b) => OFFERINGS[a].PeriodNumber - OFFERINGS[b].PeriodNumber);

                // If any period is locked, propagate its counselors to unlocked periods
                const lockedIdx = tIndices.find(i => lockedOfferings.has(i));
                if (lockedIdx != null) {
                    const lockedCounselors = state[lockedIdx].counselors.filter(id => id && id !== -1);
                    const tBlock = OFFERINGS[lockedIdx].PeriodNumber <= 3 ? 'am' : 'pm';
                    for (const tidx of tIndices) {
                        if (lockedOfferings.has(tidx)) continue;
                        while (state[tidx].counselors.length < lockedCounselors.length) state[tidx].counselors.push(null);
                        lockedCounselors.forEach((cId, slot) => {
                            state[tidx].counselors[slot] = cId;
                            usedThisPeriod[OFFERINGS[tidx].PeriodNumber].add(cId);
                            if (blockUsed[cId]) blockUsed[cId][tBlock].add(blockKey(tName));
                        });
                    }
                    continue;
                }

                const srcIdx    = tIndices[0];
                const srcPeriod = OFFERINGS[srcIdx].PeriodNumber;
                const tBlock    = srcPeriod <= 3 ? 'am' : 'pm';
                const slotCount = state[srcIdx].counselors.length;
                const tEligible = rebuildPool.filter(c => {
                    if (usedThisPeriod[srcPeriod].has(c.CounselorID)) return false;
                    const sel   = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                    const sched = sel ? sel.value : (c.ScheduleType || '');
                    return isCounselorAvailableFor(sched, srcPeriod, targetSide);
                });
                const tPreferred = shuffle(tEligible.filter(c =>  prefMap[c.CounselorID]?.ActivityPreferences?.includes(tName)));
                const tNonPref   = shuffle(tEligible.filter(c => !prefMap[c.CounselorID]?.ActivityPreferences?.includes(tName)));
                const tPool = mode === 'pref' ? [...tPreferred] : [...tPreferred, ...tNonPref];
                for (let slot = 0; slot < slotCount; slot++) {
                    if (!tPool[slot]) break;
                    const chosen = tPool[slot];
                    for (const tidx of tIndices) {
                        if (lockedOfferings.has(tidx)) continue; // never overwrite locked periods
                        while (state[tidx].counselors.length <= slot) state[tidx].counselors.push(null);
                        state[tidx].counselors[slot] = chosen.CounselorID;
                        usedThisPeriod[OFFERINGS[tidx].PeriodNumber].add(chosen.CounselorID);
                    }
                    blockUsed[chosen.CounselorID][tBlock].add(blockKey(tName));
                }
            }

            // Greedy fill — target side, rebuild pool only, skip locked
            let madeProgress = true;
            while (madeProgress) {
                madeProgress = false;
                let bestIdx = -1, bestRatio = -Infinity;
                OFFERINGS.forEach((act, idx) => {
                    if (act.SideOfCamp !== targetSide || !act.PeriodNumber) return;
                    if (lockedOfferings.has(idx)) return; // skip locked
                    if (!state[idx].counselors.some(id => id === null)) return;
                    const placed = state[idx].counselors.filter(id => id !== null && id !== -1).length;
                    const ratio  = placed === 0 ? (1e9 + (act.PreliminaryEnrollment || 0)) : ((act.PreliminaryEnrollment || 0) / placed);
                    if (ratio > bestRatio) { bestRatio = ratio; bestIdx = idx; }
                });
                if (bestIdx === -1) break;
                const act    = OFFERINGS[bestIdx];
                const period = act.PeriodNumber;
                const name   = act.ActivityName;
                const block  = period <= 3 ? 'am' : 'pm';
                const slotPos = state[bestIdx].counselors.indexOf(null);
                const eligible = rebuildPool.filter(c => {
                    if (usedThisPeriod[period].has(c.CounselorID)) return false;
                    if ((STAFF_BUSY[c.CounselorID] || []).includes(period)) return false;
                    const sel = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                    const sched = sel ? sel.value : (c.ScheduleType || '');
                    if (!isCounselorAvailableFor(sched, period, targetSide)) return false;
                    return true;
                });
                const preferred = shuffle(eligible.filter(c =>  prefMap[c.CounselorID]?.ActivityPreferences?.includes(name)));
                const nonPref   = shuffle(eligible.filter(c => !prefMap[c.CounselorID]?.ActivityPreferences?.includes(name)));
                const pool = mode === 'pref' ? [...preferred] : [...preferred, ...nonPref];
                if (pool.length === 0) {
                    state[bestIdx].counselors[slotPos] = -1;
                } else {
                    const chosen = pool[0];
                    state[bestIdx].counselors[slotPos] = chosen.CounselorID;
                    usedThisPeriod[period].add(chosen.CounselorID);
                    blockUsed[chosen.CounselorID][block].add(blockKey(name));
                }
                madeProgress = true;
            }

            // Restore -1 sentinels to null
            OFFERINGS.forEach((act, idx) => {
                if (act.SideOfCamp !== targetSide) return;
                state[idx].counselors = state[idx].counselors.map(id => id === -1 ? null : id);
            });

            // Triple-period sync
            const tripleGroups = {};
            OFFERINGS.forEach((act, idx) => {
                if (act.SideOfCamp !== targetSide || !act.ActivityName.toLowerCase().includes('triple period')) return;
                if (!tripleGroups[act.ActivityName]) tripleGroups[act.ActivityName] = [];
                tripleGroups[act.ActivityName].push(idx);
            });
            for (const [, indices] of Object.entries(tripleGroups)) {
                if (indices.length < 2) continue;
                indices.sort((a, b) => OFFERINGS[a].PeriodNumber - OFFERINGS[b].PeriodNumber);
                const maxSlots = Math.max(...indices.map(i => state[i].counselors.length));
                for (let slot = 0; slot < maxSlots; slot++) {
                    const cId = state[indices[0]].counselors[slot] ?? null;
                    if (cId === null) continue;
                    for (const idx of indices.slice(1)) {
                        if (state[idx].counselors.length <= slot) {
                            const mc = manualCounts[idx]?.counselors;
                            if (mc == null || state[idx].counselors.length < mc) state[idx].counselors.push(cId);
                        } else {
                            state[idx].counselors[slot] = cId;
                        }
                    }
                }
            }

            // Fill extras — target side, rebuild pool only
            for (let period = 1; period <= 6; period++) {
                const block = period <= 3 ? 'am' : 'pm';

                // Re-snapshot used set including newly placed target-side counselors
                const usedP = new Set(usedThisPeriod[period]);
                OFFERINGS.forEach((a, i) => {
                    if (a.PeriodNumber === period && a.SideOfCamp === targetSide)
                        state[i].counselors.forEach(id => { if (id) usedP.add(id); });
                });

                const extras = rebuildPool.filter(c => {
                    if (usedP.has(c.CounselorID)) return false;
                    const sel   = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                    const sched = sel ? sel.value : (c.ScheduleType || '');
                    return isCounselorAvailableFor(sched, period, targetSide);
                });
                if (extras.length === 0) continue;

                const eligibleIdxs = [];
                OFFERINGS.forEach((act, idx) => {
                    if (act.PeriodNumber !== period || act.SideOfCamp !== targetSide) return;
                    if (/hartt.+chamber/i.test(act.ActivityName) || /learning.zone/i.test(act.ActivityName)) return;
                    if (lockedOfferings.has(idx)) return; // skip locked
                    eligibleIdxs.push(idx);
                });
                if (eligibleIdxs.length === 0) continue;

                // Phase 1: fill existing null slots
                eligibleIdxs.sort((a, b) =>
                    state[b].counselors.filter(id => id === null).length -
                    state[a].counselors.filter(id => id === null).length
                );
                const extrasPool = [...extras];
                for (const eligIdx of eligibleIdxs) {
                    if (extrasPool.length === 0) break;
                    const actName = OFFERINGS[eligIdx].ActivityName;
                    state[eligIdx].counselors.forEach((id, slotPos) => {
                        if (id !== null || extrasPool.length === 0) return;
                        const elig_e  = extrasPool;
                        const pref    = shuffle(elig_e.filter(c =>  prefMap[c.CounselorID]?.ActivityPreferences?.includes(actName)));
                        const nonP    = shuffle(elig_e.filter(c => !prefMap[c.CounselorID]?.ActivityPreferences?.includes(actName)));
                        const chosen  = mode === 'pref' ? (pref[0] ?? null) : (pref[0] ?? nonP[0]);
                        if (!chosen) return;
                        state[eligIdx].counselors[slotPos] = chosen.CounselorID;
                        usedP.add(chosen.CounselorID);
                        blockUsed[chosen.CounselorID][block].add(blockKey(actName));
                        extrasPool.splice(extrasPool.indexOf(chosen), 1);
                    });
                }

                if (eligibleIdxs.some(idx => state[idx].counselors.some(id => id === null))) continue;

                // Phase 2: add new slots for remaining extras
                const newSlots = [];
                for (const extra of extrasPool) {
                    const valid = eligibleIdxs;
                    if (valid.length === 0) continue;
                    const tgtIdx = valid.reduce((best, idx) => {
                        const bR = (OFFERINGS[best].PreliminaryEnrollment || 0) / Math.max(state[best].counselors.length, 1);
                        const iR = (OFFERINGS[idx].PreliminaryEnrollment  || 0) / Math.max(state[idx].counselors.length,  1);
                        return iR > bR ? idx : best;
                    });
                    const mc  = manualCounts[tgtIdx]?.counselors;
                    const cap = Math.min(
                        /swim/i.test(OFFERINGS[tgtIdx].ActivityName)    ? 2 : Infinity,
                        /archery/i.test(OFFERINGS[tgtIdx].ActivityName) ? 2 : Infinity,
                        OFFERINGS[tgtIdx].SideOfCamp === 'Enrichment'   ? 3 : Infinity,
                        calcSlots[tgtIdx] ?? Infinity
                    );
                    if ((mc == null || state[tgtIdx].counselors.length < mc) && state[tgtIdx].counselors.length < cap) {
                        state[tgtIdx].counselors.push(null);
                        newSlots.push({ idx: tgtIdx, slotPos: state[tgtIdx].counselors.length - 1 });
                    }
                }
                const remaining = new Set(extrasPool.map(c => c.CounselorID));
                for (const { idx, slotPos } of newSlots) {
                    if (state[idx].counselors[slotPos] != null) continue;
                    const actName  = OFFERINGS[idx].ActivityName;
                    const elig_r   = [...remaining].filter(cid => !blockUsed[cid]?.[block].has(blockKey(actName)));
                    const pref     = shuffle(elig_r.filter(cid =>  prefMap[cid]?.ActivityPreferences?.includes(actName)));
                    const nonP     = shuffle(elig_r.filter(cid => !prefMap[cid]?.ActivityPreferences?.includes(actName)));
                    const chosen   = mode === 'pref' ? (pref[0] ?? null) : (pref[0] ?? nonP[0]);
                    if (chosen == null) continue;
                    state[idx].counselors[slotPos] = chosen;
                    usedP.add(chosen);
                    blockUsed[chosen][block].add(blockKey(actName));
                    remaining.delete(chosen);
                }
            }

            // Phase 3: force-place any rebuild-pool counselors still missing from required periods
            for (let p3 = 1; p3 <= 6; p3++) {
                const block3 = p3 <= 3 ? 'am' : 'pm';
                const usedP3 = new Set(usedThisPeriod[p3]);
                OFFERINGS.forEach((a, i) => {
                    if (a.PeriodNumber === p3) {
                        state[i].counselors.forEach(id => { if (id) usedP3.add(id); });
                        state[i].staff.forEach(id => { if (id) usedP3.add(id); });
                    }
                });
                const unplaced = rebuildPool.filter(c => {
                    if (usedP3.has(c.CounselorID)) return false;
                    const sel   = document.querySelector(`.cg-schedule[data-cid="${c.CounselorID}"]`);
                    const sched = sel ? sel.value : (c.ScheduleType || '');
                    return isCounselorAvailableFor(sched, p3, targetSide);
                });
                if (unplaced.length === 0) continue;
                const tIdxs = [];
                OFFERINGS.forEach((act, idx) => {
                    if (act.PeriodNumber !== p3 || act.SideOfCamp !== targetSide) return;
                    if (/hartt.+chamber/i.test(act.ActivityName) || /learning.zone/i.test(act.ActivityName)) return;
                    if (lockedOfferings.has(idx)) return; // skip locked
                    tIdxs.push(idx);
                });
                if (tIdxs.length === 0) continue;
                const belowCap = idx => {
                    const a = OFFERINGS[idx];
                    if (/swim/i.test(a.ActivityName)    && state[idx].counselors.length >= 2) return false;
                    if (/archery/i.test(a.ActivityName) && state[idx].counselors.length >= 2) return false;
                    if (calcSlots[idx] != null && state[idx].counselors.length >= calcSlots[idx]) return false;
                    return true;
                };
                for (const c of unplaced) {
                    const valid = tIdxs.filter(idx =>
                        belowCap(idx) &&
                        !state[idx].counselors.includes(c.CounselorID)
                    );
                    if (valid.length === 0) continue;
                    const tIdx = valid.reduce((best, idx) => {
                        const bR = (OFFERINGS[best].PreliminaryEnrollment || 0) / Math.max(state[best].counselors.length, 1);
                        const iR = (OFFERINGS[idx].PreliminaryEnrollment  || 0) / Math.max(state[idx].counselors.length,  1);
                        return iR > bR ? idx : best;
                    });
                    state[tIdx].counselors.push(c.CounselorID);
                    usedP3.add(c.CounselorID);
                    if (blockUsed[c.CounselorID]) blockUsed[c.CounselorID][block3].add(blockKey(OFFERINGS[tIdx].ActivityName));
                }
            }

            // Compact: remove nulls, enforce enrichment minimums, sync count inputs (skip locked)
            OFFERINGS.forEach((act, idx) => {
                if (act.SideOfCamp !== targetSide || lockedOfferings.has(idx)) return;
                state[idx].counselors = state[idx].counselors.filter(id => id !== null);
                const mc    = manualCounts[idx]?.counselors;
                const floor = mc != null ? mc : (act.SideOfCamp === 'Enrichment' ? getEnrichMin(act) : 0);
                while (state[idx].counselors.length < floor) state[idx].counselors.push(null);
                const card = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                if (card) {
                    const inp = card.querySelector('[data-count-type="counselors"]');
                    if (inp) inp.value = state[idx].counselors.length;
                }
            });

            renderAllFromState();
            updateAllCounters();
            updateGroupCounters();
            statusEl.textContent = `${targetSide} rebuilt from ${rebuildPool.length} counselor${rebuildPool.length !== 1 ? 's' : ''}. Review and save when ready.`;
        }

        // ── Full Auto Build ──────────────────────────────────────────────────────
        async function runFullAutoBuild() {
            const statusEl = document.getElementById('autoStatus');
            statusEl.textContent = 'Syncing schedule…';
            try {
                const resp = await fetch('/api/sync-offerings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ weekNumber: PLAN_WEEK })
                });
                if (!resp.ok) throw new Error('sync failed');
            } catch {
                statusEl.textContent = 'Sync failed — try again.';
                return;
            }
            // Sync home group colors from roster data before reload (replaces algorithmic color assignment)
            statusEl.textContent = 'Syncing colors from roster…';
            try {
                const colorResp = await fetch('/sync-homegroup-colors', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `weekNumber=${PLAN_WEEK}`
                });
                if (!colorResp.ok) throw new Error('color sync failed');
            } catch {
                statusEl.textContent = 'Color sync failed — continuing without color update.';
            }
            sessionStorage.setItem('pendingFullAuto', '1');
            location.reload();
        }

        // ── Bootstrap ────────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            initState();
            renderAllFromState();
            // loadLockedState is async (fetches from server); await it so locks are set before
            // pendingFullAuto runs and before any other interaction reads lockedOfferings.
            loadLockedState().then(() => {
                // Default staff slot count to 1 for sports activities, but only if never previously saved
                // (preserves explicit 0-UL saves — EXISTING[key] exists even when staff array is empty)
                OFFERINGS.forEach((act, idx) => {
                    if (!act.PeriodNumber || act.SideOfCamp !== 'Sports') return;
                    if (/hartt.+chamber/i.test(act.ActivityName)) return;
                    if (/swim/i.test(act.ActivityName)) return; // Swim UL assigned manually
                    const key = `${act.PeriodNumber}|${act.ActivityName}`;
                    if (state[idx].staff.length === 0 && !EXISTING[key]) {
                        handleCountChange(idx, 'staff', 1);
                        const card = document.querySelector(`.offering-card[data-offer="${idx}"]`);
                        if (card) {
                            const sInput = card.querySelector('[data-count-type="staff"]');
                            if (sInput) sInput.value = 1;
                        }
                    }
                });
                updateAllCounters();
                updateGroupCounters();
                document.querySelectorAll('.cg-schedule').forEach(sel => {
                    sel.addEventListener('change', () => { updateAllCounters(); updateGroupCounters(); });
                });

                if (sessionStorage.getItem('pendingFullAuto')) {
                    sessionStorage.removeItem('pendingFullAuto');
                    // Snapshot saved schedule types before assigning — counselors with a saved
                    // type are treated as fixed; only unset types are auto-assigned.
                    const savedTypes = {};
                    document.querySelectorAll('.cg-schedule:not(.cg-specialty-schedule)').forEach(sel => {
                        if (sel.value) savedTypes[sel.dataset.cid] = sel.value;
                    });
                    autoAssignScheduleTypes(savedTypes);
                    buildSchedule(true);
                    fillExtraCounselors();
                    saveCounselorGroups();
                }
            });
        });
    </script>
</body>
</html>