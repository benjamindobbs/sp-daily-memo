<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
    <style>
        .att-flat-list { display: flex; flex-direction: column; gap: 8px; }
        .att-flat-item { display: flex; align-items: center; justify-content: space-between; padding: 13px 18px; background: white; border: 1px solid var(--border-color); border-radius: 10px; text-decoration: none; color: var(--text); transition: background 0.12s, border-color 0.12s; }
        .att-flat-item:hover { background: #f8fafc; border-color: #94a3b8; }
        .att-flat-cat { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 2px; }
        .att-flat-name { font-weight: 600; font-size: 0.92rem; display: flex; align-items: center; gap: 6px; }
        .period-filter-bar { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; align-items: center; }
        .period-pill { padding: 5px 14px; border-radius: 20px; border: 1px solid #cbd5e1; background: #f8fafc; font-size: 0.8rem; font-weight: 600; cursor: pointer; color: var(--text-muted); transition: all 0.12s; white-space: nowrap; }
        .period-pill:hover { border-color: var(--primary); color: var(--primary); }
        .period-pill.active { background: var(--primary); color: white; border-color: var(--primary); }
        .sub-filter-bar { display: flex; gap: 6px; margin-bottom: 10px; }
        .sub-pill { padding: 3px 10px; border-radius: 12px; border: 1px solid #cbd5e1; background: #f8fafc; font-size: 0.72rem; font-weight: 600; cursor: pointer; color: var(--text-muted); transition: all 0.12s; white-space: nowrap; }
        .sub-pill:hover { border-color: var(--primary); color: var(--primary); }
        .sub-pill.active { background: var(--primary); color: white; border-color: var(--primary); }
    </style>
</head>
<body>
    <% if (viewMode === 'admin') { %>
    <nav class="nav-bar">
        <a href="/admin" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128100; Counselors</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/attendance" class="nav-btn primary">&#128203; Attendance</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
    </nav>
    <% } else { %>
    <nav class="nav-bar">
        <a href="/staff" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/attendance" class="nav-btn primary">&#128203; Attendance</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="admin">
            <button class="nav-btn" style="cursor:pointer;">&#128274; Admin View</button>
        </form>
    </nav>
    <% } %>

    <div class="container">
        <header style="margin-bottom: 20px;">
            <h1>Daily Attendance</h1>
        </header>

        <div class="date-bar">
            <label for="datePicker">Date:</label>
            <input type="date" id="datePicker" value="<%= date %>" onchange="window.location='/attendance?date='+this.value">
            <input type="text" id="attSearch" class="att-search-input" placeholder="Search counselors or classes…" oninput="filterCards()">
            <% if (!counselorFilterActive) { %>
            <% if (lateCount > 0) { %>
                <a href="/attendance/late-arrivals?date=<%= date %>" class="late-warning-link">
                    &#9888; <%= lateCount %> absent this morning &rarr; Late Arrivals
                </a>
            <% } else { %>
                <a href="/attendance/late-arrivals?date=<%= date %>" class="late-arrivals-link">
                    Late Arrivals &rarr;
                </a>
            <% } %>
            <% } %>
        </div>

        <% if (counselorFilterActive) { %>
        <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:10px 16px; margin-bottom:14px; font-size:0.875rem; display:flex; align-items:center; gap:10px;">
            Showing sessions for <strong><%= selectedCounselorName %></strong>
            <a href="/attendance?date=<%= date %>&showAll=1" style="margin-left:auto; white-space:nowrap;">Show All Sessions</a>
        </div>
        <% } %>

        <%
            // Split sessions by AM/PM
            const hgAM  = homegroupSessions.filter(s => s.session === 'am');
            const hgPM  = homegroupSessions.filter(s => s.session === 'pm');
            const busAM = busSessions.filter(s => s.session === 'am');
            const busPM = busSessions.filter(s => s.session === 'pm');
            const extAM = extSessions.filter(s => s.session === 'am');
            const extPM = extSessions.filter(s => s.session === 'pm');

            // Period map for class sections
            const byPeriod = {};
            classSessions.forEach(function(s) {
                const k = s.periodKey;
                if (!byPeriod[k]) byPeriod[k] = { label: s.periodLabel, sessions: [] };
                byPeriod[k].sessions.push(s);
            });

            // Unique colors for color filter pills
            const hgAMColors = [...new Set(hgAM.map(s => s.color).filter(Boolean))].sort();
            const hgPMColors = [...new Set(hgPM.map(s => s.color).filter(Boolean))].sort();

            // Helper: return badge class + text for section summary
            function secStat(arr) {
                const sub = arr.filter(s => s.submitted).length;
                const tot = arr.length;
                if (tot === 0) return null;
                const cls = sub === tot ? 'sec-count-done' : sub > 0 ? 'sec-count-partial' : 'sec-count-none';
                return { sub, tot, cls };
            }

            // Period filter bar helpers
            const periodOrder = ['1','2','3','4','5','6'];
            const hasAMServices = extAM.length > 0 || busAM.length > 0 || hgAM.length > 0;
            const hasPMServices = extPM.length > 0 || busPM.length > 0 || hgPM.length > 0;
            const activePeriodKeys = periodOrder.filter(pk => byPeriod[pk]);
        %>

        <% if (counselorFilterActive) { %>

        <%/* ── FLAT VIEW: sequential list for identified counselors ── */%>
        <%
            const flatItems = [];
            extAM.forEach(s => flatItems.push({ icon: '⏰', cat: 'Extended AM', label: s.label, link: s.link, submitted: s.submitted, color: null }));
            busAM.forEach(s => flatItems.push({ icon: '🚌', cat: 'Bus AM', label: s.label, link: s.link, submitted: s.submitted, color: null }));
            hgAM.forEach(s => flatItems.push({ icon: '🏠', cat: 'Home Group AM', label: s.label.split('—')[0].trim(), link: s.link, submitted: s.submitted, color: s.color }));
            classSessions.forEach(s => flatItems.push({ icon: '🏃', cat: 'Period ' + s.periodLabel, label: s.activityName, link: s.link, submitted: s.submitted, color: null }));
            hgPM.forEach(s => flatItems.push({ icon: '🏠', cat: 'Home Group PM', label: s.label.split('—')[0].trim(), link: s.link, submitted: s.submitted, color: s.color }));
            busPM.forEach(s => flatItems.push({ icon: '🚌', cat: 'Bus PM', label: s.label, link: s.link, submitted: s.submitted, color: null }));
            extPM.forEach(s => flatItems.push({ icon: '⏰', cat: 'Extended PM', label: s.label, link: s.link, submitted: s.submitted, color: null }));
        %>
        <div class="att-flat-list">
            <% flatItems.forEach(function(item) { %>
            <a href="<%= item.link %>" class="att-flat-item">
                <div>
                    <div class="att-flat-cat"><%= item.icon %> <%= item.cat %></div>
                    <div class="att-flat-name">
                        <% if (item.color) { %>
                        <span class="tag <%= item.color %>" style="font-size:0.65rem; padding:1px 6px;"><%= item.color %></span>
                        <% } %>
                        <%= item.label %>
                    </div>
                </div>
                <span class="<%= item.submitted ? 'badge-submitted' : 'badge-pending' %>"><%= item.submitted ? '✓ Submitted' : 'Pending' %></span>
            </a>
            <% }); %>
            <% if (flatItems.length === 0) { %>
            <div style="text-align:center; padding:40px 20px; color:var(--text-muted);">No sessions assigned for today.</div>
            <% } %>
        </div>

        <% } else { %>

        <%/* ── PERIOD FILTER BAR ── */%>
        <% if (hasAMServices || activePeriodKeys.length > 0 || hasPMServices) { %>
        <div class="period-filter-bar" id="periodFilterBar">
            <button class="period-pill active" data-filter="all" onclick="setPeriodFilter('all',this)">All</button>
            <% if (hasAMServices) { %>
            <button class="period-pill" data-filter="am-services" onclick="setPeriodFilter('am-services',this)">AM Services</button>
            <% } %>
            <% activePeriodKeys.forEach(function(pk) { %>
            <button class="period-pill" data-filter="period-<%= pk %>" onclick="setPeriodFilter('period-<%= pk %>',this)">Period <%= pk %></button>
            <% }); %>
            <% if (hasPMServices) { %>
            <button class="period-pill" data-filter="pm-services" onclick="setPeriodFilter('pm-services',this)">PM Services</button>
            <% } %>
        </div>
        <% } %>

        <%/* ── DROPDOWN VIEW: full overview with collapsible sections ── */%>

        <%/* ── Extended AM ── */%>
        <% if (extAM.length > 0) { %>
        <% const extAMStat = secStat(extAM); %>
        <details class="att-section" id="section-ext-am" data-section="am-services">
            <summary>
                &#9200; Extended AM
                <% if (extAMStat) { %><span class="sec-count <%= extAMStat.cls %>"><%= extAMStat.sub %>/<%= extAMStat.tot %></span><% } %>
            </summary>
            <div class="att-section-body">
                <div class="sub-filter-bar">
                    <button class="sub-pill active" onclick="setSubFilter('section-ext-am','all',this)">All</button>
                    <button class="sub-pill" onclick="setSubFilter('section-ext-am','pending',this)">Pending</button>
                    <button class="sub-pill" onclick="setSubFilter('section-ext-am','submitted',this)">Submitted</button>
                </div>
                <div class="att-grid">
                    <% extAM.forEach(function(s) { %>
                    <a href="<%= s.link %>" class="att-card" data-submitted="<%= s.submitted ? 'true' : 'false' %>">
                        <div class="att-card-label"><%= s.label %></div>
                        <span class="<%= s.submitted ? 'badge-submitted' : 'badge-pending' %>"><%= s.submitted ? 'Submitted' : 'Pending' %></span>
                    </a>
                    <% }); %>
                </div>
            </div>
        </details>
        <% } %>

        <%/* ── Busses AM ── */%>
        <% if (busAM.length > 0) { %>
        <% const busAMStat = secStat(busAM); %>
        <details class="att-section" id="section-bus-am" data-section="am-services">
            <summary>
                &#128652; Busses AM
                <% if (busAMStat) { %><span class="sec-count <%= busAMStat.cls %>"><%= busAMStat.sub %>/<%= busAMStat.tot %></span><% } %>
            </summary>
            <div class="att-section-body">
                <div class="sub-filter-bar">
                    <button class="sub-pill active" onclick="setSubFilter('section-bus-am','all',this)">All</button>
                    <button class="sub-pill" onclick="setSubFilter('section-bus-am','pending',this)">Pending</button>
                    <button class="sub-pill" onclick="setSubFilter('section-bus-am','submitted',this)">Submitted</button>
                </div>
                <div class="att-grid">
                    <% busAM.forEach(function(s) { %>
                    <a href="<%= s.link %>" class="att-card" data-submitted="<%= s.submitted ? 'true' : 'false' %>" data-search="<%= ('bus ' + s.route).toLowerCase() %>">
                        <div class="att-card-label"><%= s.label %></div>
                        <span class="<%= s.submitted ? 'badge-submitted' : 'badge-pending' %>"><%= s.submitted ? 'Submitted' : 'Pending' %></span>
                    </a>
                    <% }); %>
                </div>
            </div>
        </details>
        <% } %>

        <%/* ── Home Groups AM ── */%>
        <% if (hgAM.length > 0) { %>
        <% const hgAMStat = secStat(hgAM); %>
        <details class="att-section" id="section-hg-am" data-section="am-services">
            <summary>
                &#127968; Home Groups AM
                <% if (hgAMStat) { %><span class="sec-count <%= hgAMStat.cls %>"><%= hgAMStat.sub %>/<%= hgAMStat.tot %></span><% } %>
            </summary>
            <div class="att-section-body">
                <div class="sub-filter-bar">
                    <button class="sub-pill active" onclick="setSubFilter('section-hg-am','all',this)">All</button>
                    <button class="sub-pill" onclick="setSubFilter('section-hg-am','pending',this)">Pending</button>
                    <button class="sub-pill" onclick="setSubFilter('section-hg-am','submitted',this)">Submitted</button>
                </div>
                <% if (hgAMColors.length > 1) { %>
                <div class="color-filter-bar">
                    <button class="pill pill-all active" onclick="setColorFilter('hg-am','all',this)">All</button>
                    <% hgAMColors.forEach(function(c) { %>
                    <button class="pill pill-<%= c %>" onclick="setColorFilter('hg-am','<%= c %>',this)"><%= c %></button>
                    <% }); %>
                </div>
                <% } %>
                <div class="att-grid" data-grid-id="hg-am">
                    <% hgAM.forEach(function(s) { %>
                    <a href="<%= s.link %>" class="att-card" data-submitted="<%= s.submitted ? 'true' : 'false' %>" data-search="<%= s.label.toLowerCase() %>" data-color="<%= s.color %>">
                        <div class="att-card-label">
                            <span class="tag <%= s.color %>" style="font-size:0.68rem; padding:1px 7px; margin-right:6px;"><%= s.color %></span>
                            <%= s.label.split('—')[0].trim() %>
                        </div>
                        <span class="<%= s.submitted ? 'badge-submitted' : 'badge-pending' %>"><%= s.submitted ? 'Submitted' : 'Pending' %></span>
                    </a>
                    <% }); %>
                </div>
            </div>
        </details>
        <% } %>

        <%/* ── Class Periods (clock blocks 1-6) ── */%>
        <% periodOrder.forEach(function(pk) { %>
        <% if (byPeriod[pk]) { %>
        <% const pStat = secStat(byPeriod[pk].sessions); %>
        <details class="att-section" id="section-period-<%= pk %>" data-section="period-<%= pk %>" data-period-key="<%= pk %>">
            <summary>
                &#127947; Period <%= byPeriod[pk].label %>
                <% if (pStat) { %><span class="sec-count <%= pStat.cls %>"><%= pStat.sub %>/<%= pStat.tot %></span><% } %>
            </summary>
            <div class="att-section-body">
                <div class="sub-filter-bar">
                    <button class="sub-pill active" onclick="setSubFilter('section-period-<%= pk %>','all',this)">All</button>
                    <button class="sub-pill" onclick="setSubFilter('section-period-<%= pk %>','pending',this)">Pending</button>
                    <button class="sub-pill" onclick="setSubFilter('section-period-<%= pk %>','submitted',this)">Submitted</button>
                </div>
                <div class="att-grid">
                    <% byPeriod[pk].sessions.forEach(function(s) { %>
                    <a href="<%= s.link %>" class="att-card" data-submitted="<%= s.submitted ? 'true' : 'false' %>" data-search="<%= s.activityName.toLowerCase() %>">
                        <div class="att-card-label" style="font-size:0.82rem;"><%= s.activityName %></div>
                        <span class="<%= s.submitted ? 'badge-submitted' : 'badge-pending' %>"><%= s.submitted ? 'Submitted' : 'Pending' %></span>
                    </a>
                    <% }); %>
                </div>
            </div>
        </details>
        <% } %>
        <% }); %>

        <%/* ── Home Groups PM ── */%>
        <% if (hgPM.length > 0) { %>
        <% const hgPMStat = secStat(hgPM); %>
        <details class="att-section" id="section-hg-pm" data-section="pm-services">
            <summary>
                &#127968; Home Groups PM
                <% if (hgPMStat) { %><span class="sec-count <%= hgPMStat.cls %>"><%= hgPMStat.sub %>/<%= hgPMStat.tot %></span><% } %>
            </summary>
            <div class="att-section-body">
                <div class="sub-filter-bar">
                    <button class="sub-pill active" onclick="setSubFilter('section-hg-pm','all',this)">All</button>
                    <button class="sub-pill" onclick="setSubFilter('section-hg-pm','pending',this)">Pending</button>
                    <button class="sub-pill" onclick="setSubFilter('section-hg-pm','submitted',this)">Submitted</button>
                </div>
                <% if (hgPMColors.length > 1) { %>
                <div class="color-filter-bar">
                    <button class="pill pill-all active" onclick="setColorFilter('hg-pm','all',this)">All</button>
                    <% hgPMColors.forEach(function(c) { %>
                    <button class="pill pill-<%= c %>" onclick="setColorFilter('hg-pm','<%= c %>',this)"><%= c %></button>
                    <% }); %>
                </div>
                <% } %>
                <div class="att-grid" data-grid-id="hg-pm">
                    <% hgPM.forEach(function(s) { %>
                    <a href="<%= s.link %>" class="att-card" data-submitted="<%= s.submitted ? 'true' : 'false' %>" data-search="<%= s.label.toLowerCase() %>" data-color="<%= s.color %>">
                        <div class="att-card-label">
                            <span class="tag <%= s.color %>" style="font-size:0.68rem; padding:1px 7px; margin-right:6px;"><%= s.color %></span>
                            <%= s.label.split('—')[0].trim() %>
                        </div>
                        <span class="<%= s.submitted ? 'badge-submitted' : 'badge-pending' %>"><%= s.submitted ? 'Submitted' : 'Pending' %></span>
                    </a>
                    <% }); %>
                </div>
            </div>
        </details>
        <% } %>

        <%/* ── Busses PM ── */%>
        <% if (busPM.length > 0) { %>
        <% const busPMStat = secStat(busPM); %>
        <details class="att-section" id="section-bus-pm" data-section="pm-services">
            <summary>
                &#128652; Busses PM
                <% if (busPMStat) { %><span class="sec-count <%= busPMStat.cls %>"><%= busPMStat.sub %>/<%= busPMStat.tot %></span><% } %>
            </summary>
            <div class="att-section-body">
                <div class="sub-filter-bar">
                    <button class="sub-pill active" onclick="setSubFilter('section-bus-pm','all',this)">All</button>
                    <button class="sub-pill" onclick="setSubFilter('section-bus-pm','pending',this)">Pending</button>
                    <button class="sub-pill" onclick="setSubFilter('section-bus-pm','submitted',this)">Submitted</button>
                </div>
                <div class="att-grid">
                    <% busPM.forEach(function(s) { %>
                    <a href="<%= s.link %>" class="att-card" data-submitted="<%= s.submitted ? 'true' : 'false' %>" data-search="<%= ('bus ' + s.route).toLowerCase() %>">
                        <div class="att-card-label"><%= s.label %></div>
                        <span class="<%= s.submitted ? 'badge-submitted' : 'badge-pending' %>"><%= s.submitted ? 'Submitted' : 'Pending' %></span>
                    </a>
                    <% }); %>
                </div>
            </div>
        </details>
        <% } %>

        <%/* ── Extended PM ── */%>
        <% if (extPM.length > 0) { %>
        <% const extPMStat = secStat(extPM); %>
        <details class="att-section" id="section-ext-pm" data-section="pm-services">
            <summary>
                &#9200; Extended PM
                <% if (extPMStat) { %><span class="sec-count <%= extPMStat.cls %>"><%= extPMStat.sub %>/<%= extPMStat.tot %></span><% } %>
            </summary>
            <div class="att-section-body">
                <div class="sub-filter-bar">
                    <button class="sub-pill active" onclick="setSubFilter('section-ext-pm','all',this)">All</button>
                    <button class="sub-pill" onclick="setSubFilter('section-ext-pm','pending',this)">Pending</button>
                    <button class="sub-pill" onclick="setSubFilter('section-ext-pm','submitted',this)">Submitted</button>
                </div>
                <div class="att-grid">
                    <% extPM.forEach(function(s) { %>
                    <a href="<%= s.link %>" class="att-card" data-submitted="<%= s.submitted ? 'true' : 'false' %>">
                        <div class="att-card-label"><%= s.label %></div>
                        <span class="<%= s.submitted ? 'badge-submitted' : 'badge-pending' %>"><%= s.submitted ? 'Submitted' : 'Pending' %></span>
                    </a>
                    <% }); %>
                </div>
            </div>
        </details>
        <% } %>

        <% } %>

    </div>

    <script>
        const activeColorFilters = { 'hg-am': 'all', 'hg-pm': 'all' };
        const sectionSubFilter = {};

        function setPeriodFilter(filter, btn) {
            document.getElementById('periodFilterBar').querySelectorAll('.period-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.querySelectorAll('.att-section[data-section]').forEach(section => {
                section.style.display = (filter === 'all' || section.dataset.section === filter) ? '' : 'none';
            });
            document.getElementById('attSearch').value = '';
        }

        function setSubFilter(sectionId, filter, btn) {
            sectionSubFilter[sectionId] = filter;
            btn.closest('.sub-filter-bar').querySelectorAll('.sub-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            const section = document.getElementById(sectionId);
            section.querySelectorAll('.att-card').forEach(card => {
                const subOk = filter === 'all' || card.dataset.submitted === (filter === 'submitted' ? 'true' : 'false');
                const grid = card.closest('[data-grid-id]');
                const gridId = grid ? grid.dataset.gridId : null;
                const colorFilter = gridId ? (activeColorFilters[gridId] || 'all') : 'all';
                const colorOk = colorFilter === 'all' || card.dataset.color === colorFilter;
                card.style.display = (subOk && colorOk) ? '' : 'none';
            });
        }

        function filterCards() {
            const term = document.getElementById('attSearch').value.toLowerCase().trim();
            if (term) {
                document.querySelectorAll('.att-card[data-search]').forEach(card => {
                    const section = card.closest('.att-section');
                    if (section && section.style.display === 'none') return;
                    card.style.display = card.dataset.search.includes(term) ? '' : 'none';
                });
                document.querySelectorAll('.att-section').forEach(section => {
                    if (section.style.display === 'none') return;
                    const hasVisible = [...section.querySelectorAll('.att-card[data-search]')].some(c => c.style.display !== 'none');
                    if (hasVisible) section.open = true;
                });
            } else {
                document.querySelectorAll('.att-section').forEach(section => {
                    if (section.style.display === 'none') return;
                    const sectionId = section.id;
                    const subFilter = sectionSubFilter[sectionId] || 'all';
                    section.querySelectorAll('.att-card').forEach(card => {
                        const grid = card.closest('[data-grid-id]');
                        const gridId = grid ? grid.dataset.gridId : null;
                        const colorFilter = gridId ? (activeColorFilters[gridId] || 'all') : 'all';
                        const subOk = subFilter === 'all' || card.dataset.submitted === (subFilter === 'submitted' ? 'true' : 'false');
                        const colorOk = colorFilter === 'all' || card.dataset.color === colorFilter;
                        card.style.display = (subOk && colorOk) ? '' : 'none';
                    });
                });
            }
        }

        function setColorFilter(gridId, color, btn) {
            activeColorFilters[gridId] = color;
            btn.closest('.color-filter-bar').querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            const section = btn.closest('.att-section');
            const sectionId = section ? section.id : null;
            const subFilter = sectionId ? (sectionSubFilter[sectionId] || 'all') : 'all';
            document.querySelectorAll(`[data-grid-id="${gridId}"] .att-card`).forEach(card => {
                const colorOk = (color === 'all' || card.dataset.color === color);
                const subOk = subFilter === 'all' || card.dataset.submitted === (subFilter === 'submitted' ? 'true' : 'false');
                card.style.display = (colorOk && subOk) ? '' : 'none';
            });
        }

        document.getElementById('attSearch').addEventListener('focus', function() {
            this.style.borderColor = 'var(--primary)';
        });
        document.getElementById('attSearch').addEventListener('blur', function() {
            this.style.borderColor = '#cbd5e1';
        });

        // Pre-select period filter when navigated from admin hub stat card (?period=N)
        (function() {
            const p = new URLSearchParams(location.search).get('period');
            if (!p) return;
            const filterVal = 'period-' + p;
            const btn = document.querySelector(`[data-filter="${filterVal}"]`);
            if (!btn) return;
            setPeriodFilter(filterVal, btn);
            const section = document.getElementById('section-period-' + p);
            if (section) {
                section.open = true;
                setTimeout(() => section.scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
            }
        })();
    </script>
</body>
</html>
