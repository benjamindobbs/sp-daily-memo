<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Directory | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>
<body>

    <nav class="nav-bar">
        <a href="/admin" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">📅 Master Schedule</a>
        <a href="/search" class="nav-btn">🔍 Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn primary">&#128101; Staff Directory</a>
        <a href="/promotions" class="nav-btn">🔔 Promotions</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
    </nav>

    <div class="directory-container">
        <header style="margin-bottom: 30px;">
            <h1>Staff Directory</h1>
            <p style="color: var(--text-muted);">Browse all camp staff, counselors, and support personnel.</p>
            
            <div class="card dir-filters" style="margin-top: 20px;">
                <input type="text" id="staffSearch" placeholder="Filter by name..." onkeyup="filterStaff()">
                <select id="roleFilter" onchange="filterStaff()">
                    <option value="all">All Roles</option>
                    <optgroup label="Counselors">
                        <option value="__role_Counselor">Counselors</option>
                        <option value="__role_Swim Counselor">Swim Counselors</option>
                    </optgroup>
                    <optgroup label="Leaders">
                        <option value="__role_Unit Leader">Unit Leaders</option>
                        <option value="__role_Sports Leader">Sports Leaders</option>
                    </optgroup>
                    <optgroup label="Faculty">
                        <option value="__role_Instructor">Instructors</option>
                    </optgroup>
                    <optgroup label="Home Groups">
                        <option value="__color_Red">Red</option>
                        <option value="__color_Carolina">Carolina</option>
                        <option value="__color_Green">Green</option>
                        <option value="__color_Navy">Navy</option>
                    </optgroup>
                    <optgroup label="Specialty Camps">
                        <option value="__color_LilPlace">Li'l Place</option>
                        <option value="__color_KinderPlace">Kinder Place</option>
                        <option value="__color_SPLIT">SPLIT</option>
                        <option value="__color_SPRC">SPRC</option>
                        <option value="__color_Swim">Swim Staff</option>
                    </optgroup>
                    <optgroup label="Support">
                        <option value="__support">Support Staff (Directors, etc.)</option>
                    </optgroup>
                </select>
            </div>
        </header>

        <% const SUPPORT_ROLES = ['Director','Office Staff','Nurse','Equipment Manager','CPR Instructor','Internship']; %>
        <div class="directory-grid" id="staffGrid">
            <% counselors.forEach(c => { %>
                <div class="counselor-card staff-item"
                     data-name="<%= (c.FirstName + ' ' + c.LastName).toLowerCase() %>"
                     data-group="<%= c.HomeGroupColor || '' %>"
                     data-role="<%= c.StaffRole || 'Counselor' %>"
                     data-support="<%= SUPPORT_ROLES.includes(c.StaffRole) ? '1' : '0' %>">

                    <% if (c.HomeGroupColor) { %>
                        <span class="tag <%= c.HomeGroupColor %>" style="font-size:0.72rem;"><%= c.HomeGroupColor %></span>
                    <% } %>
                    <span style="font-size:0.72rem; background:#e2e8f0; color:#475569; padding:2px 8px; border-radius:10px; white-space:nowrap;"><%= c.StaffRole || 'Counselor' %></span>

                    <div class="counselor-name">
                        <%= c.FirstName %> <%= c.LastName %>
                    </div>

                    <% if (!SUPPORT_ROLES.includes(c.StaffRole)) { %>
                    <div class="assignment-info">
                        <div class="info-row">
                            <span class="info-label">&#9200; Extended</span>
                            <span class="info-value"><%= c.ExtendedHours || 'None' %></span>
                        </div>
                    </div>
                    <% } %>

                    <a href="/counselor-profile/<%= c.CounselorID %>" class="profile-btn">
                        View Profile
                    </a>
                </div>
            <% }) %>
        </div>
    </div>

    <script>
        function filterStaff() {
            const query = document.getElementById('staffSearch').value.toLowerCase();
            const filter = document.getElementById('roleFilter').value;
            const items = document.querySelectorAll('.staff-item');

            items.forEach(item => {
                const nameMatch = item.dataset.name.includes(query);
                let filterMatch = true;
                if (filter === 'all') {
                    filterMatch = true;
                } else if (filter === '__support') {
                    filterMatch = item.dataset.support === '1';
                } else if (filter.startsWith('__role_')) {
                    filterMatch = item.dataset.role === filter.slice(7);
                } else if (filter.startsWith('__color_')) {
                    filterMatch = item.dataset.group === filter.slice(8);
                }
                item.style.display = (nameMatch && filterMatch) ? 'flex' : 'none';
            });
        }
    </script>
</body>
</html>