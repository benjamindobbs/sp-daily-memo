<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schedule Preferences | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>
<body>

    <% if (viewMode === 'admin') { %>
    <nav class="nav-bar">
        <a href="<%= viewMode === 'admin' ? '/admin' : '/staff' %>" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128101; Staff Directory</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
    </nav>
    <% } else { %>
    <nav class="nav-bar">
        <a href="/staff" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/counselor-preferences" class="nav-btn primary">&#127381; My Preferences</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="admin">
            <button class="nav-btn" style="cursor:pointer;">&#128274; Admin View</button>
        </form>
    </nav>
    <% } %>

    <div class="container-md">

        <div class="page-header" style="margin-bottom: 28px;">
            <div>
                <h1 style="margin:0;">Schedule Preferences</h1>
                <p class="text-muted" style="margin:4px 0 0;">Submit your scheduling preferences for the upcoming session. You can resubmit at any time to update your response.</p>
            </div>
        </div>

        <% if (alertMessage) { %>
            <div class="alert" style="<%= alertMessage.includes('saved') ? '' : 'background:#fee2e2; color:#991b1b; border-color:#fca5a5;' %>">
                <%= alertMessage %>
            </div>
        <% } %>

        <form action="/counselor-preferences" method="POST">

            <div class="card" style="margin-bottom: 20px;">
                <h3 style="margin:0 0 18px;">Your Name</h3>
                <select name="counselorID" id="counselorSelect" required onchange="onCounselorChange(this.value)" style="width:100%; padding:10px 12px; border:1px solid var(--border-color); border-radius:8px; font-family:inherit; font-size:0.95rem; background:white;">
                    <option value="">— Select your name —</option>
                    <% counselors.forEach(function(c) { %>
                        <option value="<%= c.CounselorID %>" data-role="<%= c.StaffRole %>" <%= selectedCounselorId === c.CounselorID ? 'selected' : '' %>>
                            <%= c.FirstName %> <%= c.LastName %><% if (c.HomeGroupColor) { %> (<%= c.HomeGroupColor %>)<% } %> — <%= c.StaffRole %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div id="noPrefsMsg" class="card" style="margin-bottom:20px; text-align:center; color:var(--text-muted); display:<%= (selectedCounselorId && selectedCounselorRole !== 'Counselor' && selectedCounselorRole !== 'Swim Counselor') ? '' : 'none' %>;">
                Schedule preferences are only available for Counselors.
            </div>

            <button type="submit" id="saveNameBtn" class="btn btn-primary" style="width:100%; padding:14px; font-size:1rem; margin-bottom:20px; display:<%= (selectedCounselorId && selectedCounselorRole !== 'Counselor' && selectedCounselorRole !== 'Swim Counselor') ? '' : 'none' %>;">
                Save Name
            </button>

            <div id="prefsContainer" style="display:<%= (selectedCounselorRole === 'Counselor' || selectedCounselorRole === 'Swim Counselor') ? '' : 'none' %>;">

            <div class="card" style="margin-bottom: 20px; display:<%= selectedCounselorRole === 'Swim Counselor' ? 'none' : '' %>;" id="groupPrefSection">
                <h3 style="margin:0 0 6px;">Home Group Preference</h3>
                <p class="text-muted" style="margin:0 0 16px; font-size:0.85rem;">Which home group would you prefer to be assigned to?</p>
                <div style="display:flex; flex-wrap:wrap; gap:10px;">
                    <% ['Red', 'Carolina', 'Green', 'Navy', 'No Preference'].forEach(function(grp) { %>
                        <label style="display:flex; align-items:center; gap:8px; padding:10px 16px; border:1px solid var(--border-color); border-radius:8px; cursor:pointer; font-size:0.9rem; background:white; flex:1; min-width:120px;">
                            <input type="radio" name="homeGroupPreference" value="<%= grp %>" <%= selectedCounselorRole === 'Swim Counselor' ? '' : 'required' %> <%= existingPrefs && existingPrefs.HomeGroupPreference === grp ? 'checked' : '' %>>
                            <% if (grp !== 'No Preference') { %>
                                <span class="tag <%= grp %>" style="margin:0;"><%= grp %></span>
                            <% } else { %>
                                <span><%= grp %></span>
                            <% } %>
                        </label>
                    <% }); %>
                </div>
            </div>

            <div class="card" style="margin-bottom: 20px; display:<%= selectedCounselorRole === 'Swim Counselor' ? 'none' : '' %>;" id="schedulePrefSection">
                <h3 style="margin:0 0 6px;">Schedule Preference</h3>
                <p class="text-muted" style="margin:0 0 16px; font-size:0.85rem;">What type of schedule would you prefer?</p>
                <div style="display:flex; flex-direction:column; gap:10px;">
                    <% [
                        { value: 'All Sports',                  label: 'All Sports',                  desc: 'Sports activities across all periods' },
                        { value: 'All Enrichment',              label: 'All Enrichment',              desc: 'Enrichment activities across all periods' },
                        { value: 'AM Sports / PM Enrichment',   label: 'AM Sports / PM Enrichment',   desc: 'Sports in the morning, Enrichment in the afternoon' },
                        { value: 'AM Enrichment / PM Sports',   label: 'AM Enrichment / PM Sports',   desc: 'Enrichment in the morning, Sports in the afternoon' },
                        { value: 'No Preference',               label: 'No Preference',               desc: 'No preference — assign wherever needed' }
                    ].forEach(function(opt) { %>
                        <label style="display:flex; align-items:flex-start; gap:12px; padding:12px 16px; border:1px solid var(--border-color); border-radius:8px; cursor:pointer; background:white;">
                            <input type="radio" name="schedulePreference" value="<%= opt.value %>" <%= selectedCounselorRole === 'Swim Counselor' ? '' : 'required' %> style="margin-top:2px; flex-shrink:0;" <%= existingPrefs && existingPrefs.SchedulePreference === opt.value ? 'checked' : '' %>>
                            <div>
                                <div style="font-weight:600; font-size:0.9rem;"><%= opt.label %></div>
                                <div class="text-muted" style="font-size:0.78rem;"><%= opt.desc %></div>
                            </div>
                        </label>
                    <% }); %>
                </div>
            </div>

            <div class="card" style="margin-bottom: 28px;" id="activityPrefSection">
                <h3 style="margin:0 0 6px;">Activity Preferences</h3>
                <p class="text-muted" style="margin:0 0 16px; font-size:0.85rem;">Select all activities you would enjoy teaching. Check as many as you like.<% if (activitiesWeekLabel) { %> Showing offerings for <strong><%= activitiesWeekLabel %></strong>.<% } %></p>

                <div style="margin-bottom: 12px;">
                    <input type="text" id="activityFilter" placeholder="&#128269; Filter activities..."
                        onkeyup="filterActivities()"
                        style="width:100%; padding:8px 12px; border:1px solid var(--border-color); border-radius:8px; font-size:0.88rem; font-family:inherit; box-sizing:border-box;">
                </div>

                <% const sports = activities.filter(a => a.SideOfCamp === 'Sports'); %>
                <% const enrichment = activities.filter(a => a.SideOfCamp === 'Enrichment'); %>
                <% const other = activities.filter(a => a.SideOfCamp !== 'Sports' && a.SideOfCamp !== 'Enrichment'); %>

                <% if (sports.length > 0) { %>
                <div style="margin-bottom: 18px;">
                    <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted); margin-bottom:8px;">Sports</div>
                    <div class="activity-checkbox-grid" id="sportsGrid">
                        <% sports.forEach(function(act) { %>
                            <label class="activity-check-label" data-name="<%= act.Name.toLowerCase() %>">
                                <input type="checkbox" name="activityPreferences" value="<%= act.Name %>" <%= savedActivityPrefs.includes(act.Name) ? 'checked' : '' %>>
                                <span><%= act.Name %></span>
                            </label>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <% if (enrichment.length > 0) { %>
                <div style="margin-bottom: 18px;">
                    <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted); margin-bottom:8px;">Enrichment</div>
                    <div class="activity-checkbox-grid" id="enrichmentGrid">
                        <% enrichment.forEach(function(act) { %>
                            <label class="activity-check-label" data-name="<%= act.Name.toLowerCase() %>">
                                <input type="checkbox" name="activityPreferences" value="<%= act.Name %>" <%= savedActivityPrefs.includes(act.Name) ? 'checked' : '' %>>
                                <span><%= act.Name %></span>
                            </label>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <% if (other.length > 0) { %>
                <div>
                    <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted); margin-bottom:8px;">Other</div>
                    <div class="activity-checkbox-grid" id="otherGrid">
                        <% other.forEach(function(act) { %>
                            <label class="activity-check-label" data-name="<%= act.Name.toLowerCase() %>">
                                <input type="checkbox" name="activityPreferences" value="<%= act.Name %>" <%= savedActivityPrefs.includes(act.Name) ? 'checked' : '' %>>
                                <span><%= act.Name %></span>
                            </label>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <% if (activities.length === 0) { %>
                    <p class="text-muted" style="font-style:italic;">No activities have been added yet.</p>
                <% } %>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%; padding:14px; font-size:1rem;">
                Submit Preferences
            </button>

            </div><!-- /prefsContainer -->

        </form>

        <div class="card" style="margin-top:24px;">
            <h3 style="margin:0 0 6px;">Notifications</h3>
            <p class="text-muted" style="margin:0 0 16px; font-size:0.85rem;">Receive push alerts and attendance reminders on this device.</p>
            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <button id="enableNotifyBtn" onclick="enablePushNotifications()" class="btn btn-primary" style="display:none;">
                    &#128276; Enable notifications
                </button>
                <button id="disableNotifyBtn" onclick="disablePushNotifications()" class="btn" style="display:none; background:#fee2e2; color:#991b1b; border-color:#fca5a5;">
                    &#128277; Disable notifications
                </button>
            </div>
            <p id="notifyUnsupported" style="display:none; font-size:0.82rem; color:var(--text-muted); margin:8px 0 0;">
                Push notifications are not available in this browser. On iPhone, add this site to your Home Screen first, then open it from there.
            </p>
        </div>

    </div>

    <script>
        function getRoleForValue(val) {
            if (!val) return '';
            const opt = document.querySelector(`#counselorSelect option[value="${val}"]`);
            return opt ? opt.dataset.role : '';
        }

        function applyPrefs(prefs) {
            document.querySelectorAll('input[name="homeGroupPreference"]').forEach(function(r) {
                r.checked = r.value === prefs.HomeGroupPreference;
            });
            document.querySelectorAll('input[name="schedulePreference"]').forEach(function(r) {
                r.checked = r.value === prefs.SchedulePreference;
            });
            const actSet = new Set(prefs.activityPreferences || []);
            document.querySelectorAll('input[name="activityPreferences"]').forEach(function(cb) {
                cb.checked = actSet.has(cb.value);
            });
        }

        function setPrefsDisabled(disabled) {
            document.querySelectorAll('#prefsContainer input, #prefsContainer textarea, #prefsContainer select').forEach(function(el) {
                el.disabled = disabled;
            });
        }

        function onCounselorChange(val) {
            const prefsContainer   = document.getElementById('prefsContainer');
            const noPrefsMsg       = document.getElementById('noPrefsMsg');
            const saveNameBtn      = document.getElementById('saveNameBtn');
            const groupPrefSection = document.getElementById('groupPrefSection');
            const schedulePrefSection = document.getElementById('schedulePrefSection');
            const role = getRoleForValue(val);

            if (!val) {
                prefsContainer.style.display = 'none';
                noPrefsMsg.style.display     = 'none';
                saveNameBtn.style.display    = 'none';
                setPrefsDisabled(true);
                return;
            }

            if (role === 'Counselor' || role === 'Swim Counselor') {
                prefsContainer.style.display = '';
                noPrefsMsg.style.display     = 'none';
                saveNameBtn.style.display    = 'none';
                setPrefsDisabled(false);

                const isSwim = role === 'Swim Counselor';
                groupPrefSection.style.display    = isSwim ? 'none' : '';
                schedulePrefSection.style.display = isSwim ? 'none' : '';
                groupPrefSection.querySelectorAll('input').forEach(function(el) {
                    el.required = !isSwim;
                    el.disabled = isSwim;
                });
                schedulePrefSection.querySelectorAll('input').forEach(function(el) {
                    el.required = !isSwim;
                    el.disabled = isSwim;
                });

                fetch('/api/counselor-preferences/' + val)
                    .then(function(r) { return r.json(); })
                    .then(function(prefs) { applyPrefs(prefs); })
                    .catch(function() {});
            } else {
                prefsContainer.style.display = 'none';
                noPrefsMsg.style.display     = '';
                saveNameBtn.style.display    = '';
                setPrefsDisabled(true);
            }
        }

        // Disable pref inputs on initial load if the container is hidden
        document.addEventListener('DOMContentLoaded', function() {
            const prefsContainer = document.getElementById('prefsContainer');
            if (prefsContainer.style.display === 'none') setPrefsDisabled(true);
        });

        function filterActivities() {
            const term = document.getElementById('activityFilter').value.toLowerCase();
            document.querySelectorAll('.activity-check-label').forEach(function(label) {
                label.style.display = label.dataset.name.includes(term) ? '' : 'none';
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const supported = ('Notification' in window) && ('PushManager' in window);
            if (!supported) {
                document.getElementById('notifyUnsupported').style.display = '';
            }
            // nav.js sets swReg asynchronously; poll briefly to pick it up
            var attempts = 0;
            var interval = setInterval(function () {
                if (typeof updateNotifyButton === 'function') {
                    updateNotifyButton();
                    clearInterval(interval);
                } else if (++attempts > 20) {
                    clearInterval(interval);
                }
            }, 150);
        });
    </script>
</body>
</html>
