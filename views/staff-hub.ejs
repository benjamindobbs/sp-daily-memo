<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Hub | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
    <style>
        .hub-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 16px;
            margin-top: 32px;
        }
        .hub-card {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 32px 20px;
            box-shadow: var(--shadow);
            text-align: center;
            text-decoration: none;
            display: block;
            transition: transform 0.15s, box-shadow 0.15s;
            color: var(--text);
        }
        .hub-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
        .hub-card-icon { font-size: 2.4rem; margin-bottom: 12px; }
        .hub-card-title { font-size: 1.05rem; font-weight: 700; margin: 0; }
        .switch-bar { margin-top: 48px; text-align: center; }
        .switch-bar a, .switch-bar button { color: #94a3b8; font-size: 0.82rem; background: none; border: none; cursor: pointer; font-family: inherit; text-decoration: underline; }
        .switch-bar a:hover, .switch-bar button:hover { color: var(--text); }
    </style>
</head>
<body>
    <nav class="nav-bar">
        <a href="/staff" class="nav-btn primary">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/map" class="nav-btn">&#128205; Camp Map</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/photo-day" class="nav-btn">&#128247; Photo of the Day</a>
        <a href="/counselor-preferences" class="nav-btn">&#127381; My Preferences</a>
        <a href="/docs" class="nav-btn">&#128196; Documents</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="admin">
            <button class="nav-btn" style="cursor:pointer;">&#128274; Admin View</button>
        </form>
    </nav>

    <div class="container">
        <header class="header-flex" style="margin-bottom: 8px;">
            <div>
                <h1>Welcome Back<% if (selectedCounselorName) { %>, <%= selectedCounselorName.split(' ')[0] %><%  } %>!</h1>
                <p class="text-muted">It's a great day to have a great day! Select a tool to get started.</p>
            </div>
        </header>

        <!-- Schedule Bar -->
        <div style="margin-bottom:16px; border:1px solid var(--border-color); border-radius:12px; box-shadow:var(--shadow); overflow:hidden;">
            <!-- Compact now-bar (always visible) -->
            <div id="ss-compact" style="padding:14px 18px; background:white; cursor:pointer; user-select:none;" onclick="toggleSchedExpand()">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                    <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Now</div>
                    <span id="ss-chevron" style="font-size:0.7rem; color:var(--text-muted); display:inline-block; transition:transform 0.2s;">&#9660;</span>
                </div>
                <div id="ss-name" style="font-size:1rem; font-weight:700; color:var(--text); margin-bottom:8px; display:none;"></div>
                <div id="ss-row" style="display:none; align-items:center; gap:8px;">
                    <span id="ss-start" style="font-size:0.72rem; color:var(--text-muted); min-width:36px; font-variant-numeric:tabular-nums;"></span>
                    <div style="flex:1; height:6px; background:var(--border-color); border-radius:3px; overflow:hidden;">
                        <div id="ss-fill" style="height:100%; border-radius:3px; width:0%; transition:width 0.5s;"></div>
                    </div>
                    <span id="ss-end" style="font-size:0.72rem; color:var(--text-muted); min-width:36px; text-align:right; font-variant-numeric:tabular-nums;"></span>
                </div>
                <div id="ss-status" style="font-size:0.8rem; color:var(--text-muted); font-style:italic;"></div>
            </div>
            <!-- Expanded full-day timeline -->
            <div id="ss-expand" style="display:none; padding:14px 18px; border-top:1px solid var(--border-color);">
                <div style="display:flex; gap:6px; margin-bottom:14px;">
                    <button id="ss-btn-sports"     onclick="setSchedSide('sports',event)"     style="padding:4px 14px; border:1px solid var(--border-color); border-radius:20px; font-size:0.78rem; font-weight:600; cursor:pointer; background:white; color:var(--text); transition:all 0.15s;">Sports</button>
                    <button id="ss-btn-enrichment" onclick="setSchedSide('enrichment',event)" style="padding:4px 14px; border:1px solid var(--border-color); border-radius:20px; font-size:0.78rem; font-weight:600; cursor:pointer; background:white; color:var(--text); transition:all 0.15s;">Enrichment</button>
                </div>
                <div style="position:relative; padding-top:22px;">
                    <div id="ss-tl-labels" style="position:absolute; top:0; left:0; right:0; height:20px; pointer-events:none;"></div>
                    <div style="position:relative;">
                        <div id="ss-tl-bar" style="display:flex; height:14px; border-radius:7px; overflow:hidden;"></div>
                        <div id="ss-tl-cursor" style="position:absolute; top:-3px; bottom:-3px; width:2px; background:rgba(0,0,0,0.3); border-radius:1px; display:none; pointer-events:none;"></div>
                        <div id="ss-tl-tooltip" style="position:absolute; bottom:calc(100% + 8px); background:#1e293b; color:#fff; border-radius:7px; padding:6px 10px; font-size:0.75rem; white-space:nowrap; display:none; pointer-events:none; transform:translateX(-50%); z-index:20; box-shadow:0 2px 8px rgba(0,0,0,0.25);">
                            <div id="ss-tl-tt-name" style="font-weight:700;"></div>
                            <div id="ss-tl-tt-time" style="color:#94a3b8; font-size:0.7rem; margin-top:1px;"></div>
                        </div>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:0.63rem; color:var(--text-muted); margin-top:4px; padding:0 1px;">
                        <span>9:00</span><span>12:00</span><span>4:30</span>
                    </div>
                </div>
            </div>
        </div>
        <script>
        (function() {
            const SPORTS_S = <%- JSON.stringify(sportsScheduleFull) %>;
            const ENRICH_S = <%- JSON.stringify(enrichmentScheduleFull) %>;
            const DEFAULT  = '<%= staffSide %>';
            const DAY_START=540, DAY_END=990, DAY_SPAN=450;
            let expanded=false, side=DEFAULT;

            function estMins() {
                const p=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',hour:'numeric',minute:'numeric',hour12:false}).formatToParts(new Date());
                return parseInt(p.find(x=>x.type==='hour').value)*60+parseInt(p.find(x=>x.type==='minute').value);
            }
            function fmt(m){const h=Math.floor(m/60),mn=m%60,h12=h>12?h-12:(h===0?12:h);return `${h12}:${String(mn).padStart(2,'0')}`;}
            function getSched(){return side==='sports'?SPORTS_S:ENRICH_S;}
            function getColor(){return side==='sports'?'#3b82f6':'#10b981';}

            function getState(sched,mins){
                for(const b of sched){const s=b.startH*60+b.startM,e=b.endH*60+b.endM;if(mins>=s&&mins<e)return{type:'active',b,s,e,pct:Math.round((mins-s)/(e-s)*100)};}
                if(mins<sched[0].startH*60+sched[0].startM)return{type:'before',next:sched[0]};
                for(let i=0;i<sched.length-1;i++){const te=sched[i].endH*60+sched[i].endM,ns=sched[i+1].startH*60+sched[i+1].startM;if(mins>=te&&mins<ns)return{type:'between',next:sched[i+1]};}
                return{type:'after'};
            }

            function updateCompact(){
                const st=getState(getSched(),estMins()),c=getColor();
                const nEl=document.getElementById('ss-name'),rEl=document.getElementById('ss-row'),
                      fEl=document.getElementById('ss-fill'),sEl=document.getElementById('ss-start'),
                      eEl=document.getElementById('ss-end'),stEl=document.getElementById('ss-status');
                if(st.type==='active'){
                    nEl.textContent=st.b.label;sEl.textContent=fmt(st.s);eEl.textContent=fmt(st.e);
                    fEl.style.width=st.pct+'%';fEl.style.background=c;
                    nEl.style.display='';rEl.style.display='flex';stEl.textContent='';
                }else if(st.type==='between'){
                    const ns=st.next.startH*60+st.next.startM;
                    nEl.textContent='Next: '+st.next.label;sEl.textContent='';eEl.textContent=fmt(ns);
                    fEl.style.width='0%';fEl.style.background=c;
                    nEl.style.display='';rEl.style.display='flex';stEl.textContent='';
                }else if(st.type==='before'){
                    nEl.style.display='none';rEl.style.display='none';
                    stEl.textContent='Camp starts at '+fmt(st.next.startH*60+st.next.startM);
                }else{nEl.style.display='none';rEl.style.display='none';stEl.textContent='Camp day complete';}
            }

            function blkColor(label,s){
                if(label==='Lunch')return'#64748b';if(label==='Dismissal')return'#94a3b8';
                if(['Snack Break','Popsicle Break','Big Game'].includes(label))return'#f59e0b';
                return s==='sports'?'#3b82f6':'#10b981';
            }
            function blkAbbr(l){return l.replace('Sports ','S').replace('Enrichment ','E').replace('Snack Break','Snack').replace('Popsicle Break','PB').replace('Big Game','BG').replace('Dismissal','Dis');}

            function buildTimeline(){
                const sched=getSched(),barEl=document.getElementById('ss-tl-bar'),
                      lblEl=document.getElementById('ss-tl-labels'),curEl=document.getElementById('ss-tl-cursor');
                if(!barEl)return;
                const segs=[];let cur=DAY_START;
                for(const b of sched){const s=b.startH*60+b.startM,e=b.endH*60+b.endM;if(s>cur)segs.push({gap:true,mins:s-cur,s:cur,e:s});segs.push({label:b.label,gap:false,mins:e-s,s,e});cur=e;}
                if(cur<DAY_END)segs.push({gap:true,mins:DAY_END-cur,s:cur,e:DAY_END});
                barEl.innerHTML=segs.map(sg=>{const p=(sg.mins/DAY_SPAN*100).toFixed(3),bg=sg.gap?'#e2e8f0':blkColor(sg.label,side);if(sg.gap)return`<div style="flex:0 0 ${p}%;background:${bg};"></div>`;return`<div style="flex:0 0 ${p}%;background:${bg};cursor:pointer;" data-label="${sg.label}" data-s="${sg.s}" data-e="${sg.e}"></div>`;}).join('');
                barEl.onmousemove=ev=>{const t=ev.target;if(t===barEl||!t.dataset.label)return;const br=barEl.getBoundingClientRect(),sr=t.getBoundingClientRect(),pct=(sr.left-br.left+sr.width/2)/br.width*100,tt=document.getElementById('ss-tl-tooltip');if(!tt)return;document.getElementById('ss-tl-tt-name').textContent=t.dataset.label;document.getElementById('ss-tl-tt-time').textContent=fmt(+t.dataset.s)+' – '+fmt(+t.dataset.e);tt.style.left=pct+'%';tt.style.display='block';};
                barEl.onmouseleave=()=>{const tt=document.getElementById('ss-tl-tooltip');if(tt)tt.style.display='none';};
                barEl.onclick=ev=>{const t=ev.target;if(t===barEl||!t.dataset.label)return;const br=barEl.getBoundingClientRect(),sr=t.getBoundingClientRect(),pct=(sr.left-br.left+sr.width/2)/br.width*100,tt=document.getElementById('ss-tl-tooltip');if(!tt)return;document.getElementById('ss-tl-tt-name').textContent=t.dataset.label;document.getElementById('ss-tl-tt-time').textContent=fmt(+t.dataset.s)+' – '+fmt(+t.dataset.e);tt.style.left=pct+'%';tt.style.display=tt.style.display==='block'?'none':'block';};
                barEl.addEventListener('touchend',function(ev){const touch=ev.changedTouches[0],br=barEl.getBoundingClientRect();if(Math.abs(touch.clientY-(br.top+br.height/2))>28)return;let found=null;for(const c of barEl.children){const cr=c.getBoundingClientRect();if(touch.clientX>=cr.left&&touch.clientX<=cr.right){found=c;break;}}if(!found||!found.dataset.label)return;ev.preventDefault();const sr=found.getBoundingClientRect(),pct=(sr.left-br.left+sr.width/2)/br.width*100,tt=document.getElementById('ss-tl-tooltip');if(!tt)return;document.getElementById('ss-tl-tt-name').textContent=found.dataset.label;document.getElementById('ss-tl-tt-time').textContent=fmt(+found.dataset.s)+' – '+fmt(+found.dataset.e);tt.style.left=pct+'%';tt.style.display='block';},{passive:false});
                lblEl.innerHTML='';let lp=0;
                for(const sg of segs){const p=sg.mins/DAY_SPAN*100;if(!sg.gap){const el=document.createElement('span');el.textContent=blkAbbr(sg.label);el.style.cssText=`position:absolute;left:${(lp+p/2).toFixed(2)}%;transform:translateX(-50%);font-size:0.6rem;font-weight:600;color:#64748b;white-space:nowrap;`;lblEl.appendChild(el);}lp+=p;}
                const now=estMins();
                if(now>=DAY_START&&now<=DAY_END){curEl.style.left=((now-DAY_START)/DAY_SPAN*100).toFixed(2)+'%';curEl.style.display='block';}else curEl.style.display='none';
                ['sports','enrichment'].forEach(s=>{
                    const btn=document.getElementById('ss-btn-'+s);if(!btn)return;
                    const on=s===side,c=s==='sports'?'#3b82f6':'#10b981';
                    btn.style.background=on?c:'';btn.style.color=on?'white':'';btn.style.borderColor=on?c:'';
                });
            }

            window.toggleSchedExpand=function(){
                expanded=!expanded;
                document.getElementById('ss-expand').style.display=expanded?'block':'none';
                const ch=document.getElementById('ss-chevron');if(ch)ch.style.transform=expanded?'rotate(180deg)':'';
                if(expanded)buildTimeline();
            };
            window.setSchedSide=function(s,e){if(e)e.stopPropagation();side=s;updateCompact();if(expanded)buildTimeline();};

            document.addEventListener('touchstart',function(ev){const bar=document.getElementById('ss-tl-bar');if(bar&&bar.contains(ev.target))return;const tt=document.getElementById('ss-tl-tooltip');if(tt)tt.style.display='none';},{passive:true});
            updateCompact();
            setInterval(()=>{updateCompact();if(expanded)buildTimeline();},30000);
        })();
        </script>

        <% if (releasedSchedule && releasedSchedule.length > 0) { %>
        <div class="card" style="margin-bottom:20px; border-left:4px solid var(--primary);">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                <h3 style="margin:0;">Your Upcoming Schedule</h3>
                <span style="background:var(--primary); color:white; font-size:0.75rem; font-weight:600; padding:3px 10px; border-radius:20px;"><%= releasedSessionLabel %></span>
            </div>
            <% const showLocation = releasedSchedule.some(r => r.Location); %>
            <table style="width:100%; border-collapse:collapse; font-size:0.875rem;">
                <thead>
                    <tr>
                        <th style="text-align:left; padding:4px 8px; color:var(--text-muted); font-weight:600;">Period</th>
                        <th style="text-align:left; padding:4px 8px; color:var(--text-muted); font-weight:600;">Activity</th>
                        <% if (showLocation) { %>
                        <th style="text-align:left; padding:4px 8px; color:var(--text-muted); font-weight:600;">Location</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                <% releasedSchedule.forEach(r => { %>
                    <tr style="border-top:1px solid var(--border-color);">
                        <td style="padding:6px 8px; color:var(--text-muted);">P<%= r.PeriodNumber %></td>
                        <td style="padding:6px 8px; font-weight:500;"><%= r.ActivityName %></td>
                        <% if (showLocation) { %>
                        <td style="padding:6px 8px; color:var(--text-muted);"><% if (r.Location) { %>&#128205; <%= r.Location %><% } else { %>&mdash;<% } %></td>
                        <% } %>
                    </tr>
                <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>

        <div class="hub-cards">
            <a href="/attendance" class="hub-card">
                <div class="hub-card-icon">&#128203;</div>
                <div class="hub-card-title">Attendance</div>
            </a>
            <a href="/search" class="hub-card">
                <div class="hub-card-icon">&#128269;</div>
                <div class="hub-card-title">Camper Lookup</div>
            </a>
            <a href="/master-schedule" class="hub-card">
                <div class="hub-card-icon">&#128197;</div>
                <div class="hub-card-title">Master Schedule</div>
            </a>
            <a href="/photo-day" class="hub-card">
                <div class="hub-card-icon">&#128247;</div>
                <div class="hub-card-title">Photo of the Day</div>
            </a>
            <a href="/spartan-games" class="hub-card">
                <div class="hub-card-icon">&#127942;</div>
                <div class="hub-card-title">Spartan Games</div>
            </a>
            <% if (talentOpen) { %>
            <a href="/talent-show" class="hub-card">
                <div class="hub-card-icon">&#127929;</div>
                <div class="hub-card-title">Talent Show</div>
            </a>
            <% } %>
        </div>

        <%
        const winnerToShow = (photoPhase === 'winner' && todayWinner && todayWinner.votes > 0)
            ? { ...todayWinner, label: "Today's Photo of the Day" }
            : (yesterdayWinner && yesterdayWinner.votes > 0)
                ? { ...yesterdayWinner, label: "Yesterday's Photo of the Day" }
                : null;
        %>
        <% if (winnerToShow) { %>
        <div class="card" style="margin-top:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <div style="font-size:0.72rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">&#127942; <%= winnerToShow.label %></div>
                <button id="potdToggle" onclick="togglePotd()" class="btn btn-small" style="font-size:0.72rem; padding:3px 10px;">Hide</button>
            </div>
            <div id="potdBody">
                <img src="<%= thumbUrl(winnerToShow.imageUrl, 800) %>" alt="Photo by <%= winnerToShow.counselorName %>"
                     style="width:100%; border-radius:8px; object-fit:cover; display:block;">
                <div style="margin-top:10px; display:flex; align-items:baseline; gap:10px;">
                    <span style="font-size:1.1rem; font-weight:700;"><%= winnerToShow.counselorName.split(' ')[0] %></span>
                    <span style="font-size:0.82rem; color:var(--text-muted);"><%= winnerToShow.votes %> vote<%= winnerToShow.votes === 1 ? '' : 's' %></span>
                    <a href="/photo-gallery" style="margin-left:auto; font-size:0.82rem; color:var(--primary);">View gallery &rarr;</a>
                </div>
            </div>
        </div>
        <script>
        (function() {
            if (localStorage.getItem('potdHidden') === '1') {
                document.getElementById('potdBody').style.display = 'none';
                document.getElementById('potdToggle').textContent = 'Show';
            }
        })();
        function togglePotd() {
            const body = document.getElementById('potdBody');
            const btn  = document.getElementById('potdToggle');
            const hiding = body.style.display !== 'none';
            body.style.display = hiding ? 'none' : '';
            btn.textContent = hiding ? 'Show' : 'Hide';
            localStorage.setItem('potdHidden', hiding ? '1' : '0');
        }
        </script>
        <% } %>

        <div class="card" style="margin-top:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h4 style="margin:0; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted);">Attendance at a Glance</h4>
                <button id="attGlanceToggle" onclick="toggleAttGlance()" class="btn btn-small" style="font-size:0.72rem; padding:3px 10px;">Hide</button>
            </div>
            <div id="attGlanceGrid">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;">
                <% ['Navy','Green','Carolina','Red'].forEach(function(color) { %>
                <div style="background:#f8fafc; border-radius:8px; padding:10px 14px;" id="group-<%= color %>">
                    <div style="font-size:0.75rem; font-weight:600; margin-bottom:6px;"><span class="tag <%= color %>"><%= color %></span></div>
                    <% (absentByGroup[color] || []).forEach(function(cam) { %>
                        <% if (cam.Status === 'late') { %>
                        <div style="font-size:0.82rem; padding:2px 0; color:var(--text-muted); text-decoration:line-through;"><%= cam.FirstName %> <%= cam.LastName %></div>
                        <% } else if (cam.Status === 'dismissed') { %>
                        <div style="font-size:0.82rem; padding:2px 0; color:#b45309; text-decoration:line-through;"><%= cam.FirstName %> <%= cam.LastName %></div>
                        <% } else if (cam.Status === 'nurse') { %>
                        <div style="font-size:0.82rem; padding:2px 0; color:#991b1b;">&#128137; <%= cam.FirstName %> <%= cam.LastName %></div>
                        <% } else { %>
                        <div style="font-size:0.82rem; padding:2px 0;"><%= cam.FirstName %> <%= cam.LastName %></div>
                        <% } %>
                    <% }); %>
                    <% if (!(absentByGroup[color] || []).length) { %><div style="font-size:0.78rem; color:var(--text-muted); font-style:italic;">None absent</div><% } %>
                </div>
                <% }); %>
            </div>
            <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-bottom:10px;">
                <% [['SPLIT','SPLIT'],['KinderPlace','Kinder Place'],['LilPlace',"Li'l Place"],['SPRC','SPRC']].forEach(function(pair) { %>
                <div style="background:#f8fafc; border-radius:8px; padding:10px 14px;">
                    <div style="font-size:0.75rem; font-weight:600; margin-bottom:6px;"><span class="tag <%= pair[0] %>" style="font-size:0.65rem;"><%= pair[1] %></span></div>
                    <% (absentByGroup[pair[0]] || []).forEach(function(cam) { %>
                        <% if (cam.Status === 'late') { %>
                        <div style="font-size:0.82rem; padding:2px 0; color:var(--text-muted); text-decoration:line-through;"><%= cam.FirstName %> <%= cam.LastName %></div>
                        <% } else if (cam.Status === 'dismissed') { %>
                        <div style="font-size:0.82rem; padding:2px 0; color:#b45309; text-decoration:line-through;"><%= cam.FirstName %> <%= cam.LastName %></div>
                        <% } else if (cam.Status === 'nurse') { %>
                        <div style="font-size:0.82rem; padding:2px 0; color:#991b1b;">&#128137; <%= cam.FirstName %> <%= cam.LastName %></div>
                        <% } else { %>
                        <div style="font-size:0.82rem; padding:2px 0;"><%= cam.FirstName %> <%= cam.LastName %></div>
                        <% } %>
                    <% }); %>
                    <% if (!(absentByGroup[pair[0]] || []).length) { %><div style="font-size:0.78rem; color:var(--text-muted); font-style:italic;">None</div><% } %>
                </div>
                <% }); %>
            </div>
            <% if (nurseNow.length > 0) { %>
            <div style="background:#fef2f2; border:1px solid #fca5a5; border-radius:8px; padding:10px 14px; margin-bottom:10px;">
                <div style="font-size:0.75rem; font-weight:700; color:#991b1b; margin-bottom:6px;">&#128137; In Nurse (<%= nurseNow.length %>)</div>
                <% nurseNow.forEach(function(cam) { %>
                <div style="font-size:0.82rem; padding:2px 0; display:flex; align-items:center; gap:6px;">
                    <span class="tag <%= cam.HomeGroupColor %>" style="font-size:0.65rem; padding:1px 5px;"><%= cam.HomeGroupColor %></span>
                    <%= cam.FirstName %> <%= cam.LastName %>
                    <% if (cam.Notes) { %><span style="color:var(--text-muted); font-size:0.75rem;">&mdash; <%= cam.Notes %></span><% } %>
                </div>
                <% }); %>
            </div>
            <% } %>
            <% if (caseNow.length > 0) { %>
            <div style="background:#fffbeb; border:1px solid #fcd34d; border-radius:8px; padding:10px 14px; margin-bottom:10px;">
                <div style="font-size:0.75rem; font-weight:700; color:#92400e; margin-bottom:6px;">&#128196; With Noell (<%= caseNow.length %>)</div>
                <% caseNow.forEach(function(cam) { %>
                <div style="font-size:0.82rem; padding:2px 0; display:flex; align-items:center; gap:6px;">
                    <span class="tag <%= cam.HomeGroupColor %>" style="font-size:0.65rem; padding:1px 5px;"><%= cam.HomeGroupColor %></span>
                    <%= cam.FirstName %> <%= cam.LastName %>
                    <% if (cam.Notes) { %><span style="color:var(--text-muted); font-size:0.75rem;">&mdash; <%= cam.Notes %></span><% } %>
                </div>
                <% }); %>
            </div>
            <% } %>
            </div><%/* end attGlanceGrid */%>
        </div>
        <script>
        (function() {
            if (localStorage.getItem('attGlanceHidden') === '1') {
                document.getElementById('attGlanceGrid').style.display = 'none';
                document.getElementById('attGlanceToggle').textContent = 'Show';
            }
        })();
        function toggleAttGlance() {
            const grid = document.getElementById('attGlanceGrid');
            const btn  = document.getElementById('attGlanceToggle');
            const hiding = grid.style.display !== 'none';
            grid.style.display = hiding ? 'none' : '';
            btn.textContent = hiding ? 'Show' : 'Hide';
            localStorage.setItem('attGlanceHidden', hiding ? '1' : '0');
        }
</script>

        <%/* ── Today's Activity Feed ── */%>
        <div class="card" style="margin-top:20px;">
            <h3 style="margin:0 0 16px;">Today's Memo</h3>
            <% if (rosterAbsent && rosterAbsent.length > 0) { %>
            <div style="margin-bottom:16px;">
                <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted); margin-bottom:8px;">&#10006; Absent from Your Group</div>
                <% rosterAbsent.forEach(function(cam) { %>
                <div style="display:flex; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid var(--border-color);">
                    <span class="tag <%= cam.HomeGroupColor %>" style="font-size:0.65rem; padding:1px 7px; flex-shrink:0;"><%= cam.HomeGroupColor %></span>
                    <span style="font-weight:500;"><%= cam.FirstName %> <%= cam.LastName %></span>
                </div>
                <% }); %>
            </div>
            <% } %>

            <% if (!rosterAbsent && !todayPickups.length && !todayLateArrivals.length && !todayEarlyDismissals.length && !todayScheduleChanges.length) { %>
            <p style="color:var(--text-muted); font-size:0.875rem; margin:0;">No pickups, late arrivals, dismissals, or schedule changes today.</p>
            <% } %>

            <% if (todayPickups.length > 0) { %>
            <div style="margin-bottom:16px;">
                <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted); margin-bottom:8px;">&#128663; Scheduled Pickups</div>
                <% todayPickups.forEach(function(p) { %>
                <div style="display:flex; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid var(--border-color);">
                    <span class="tag <%= p.HomeGroupColor %>" style="font-size:0.65rem; padding:1px 7px; flex-shrink:0;"><%= p.HomeGroupColor %></span>
                    <span style="font-weight:500; flex:1;"><%= p.FirstName %> <%= p.LastName %></span>
                    <span style="font-size:0.82rem; font-weight:700; color:#92400e; background:#fef3c7; padding:2px 8px; border-radius:4px;">
                        <%= fmtPickupTime(p.PickupTime) %><% if (p.PeriodNumber) { %> &middot; P<%= p.PeriodNumber %><% if (p.ActivityName) { %> <%= p.ActivityName %><% } %><% } %>
                    </span>
                    <% if (p.Notes) { %><span style="font-size:0.8rem; color:var(--text-muted); flex:1;">&#128221; <%= p.Notes %></span><% } %>
                </div>
                <% }); %>
            </div>
            <% } %>

            <% if (todayLateArrivals.length > 0) { %>
            <div style="margin-bottom:16px;">
                <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted); margin-bottom:8px;">&#9989; Late Arrivals</div>
                <% todayLateArrivals.forEach(function(a) { %>
                <div style="display:flex; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid var(--border-color);">
                    <span class="tag <%= a.HomeGroupColor %>" style="font-size:0.65rem; padding:1px 7px; flex-shrink:0;"><%= a.HomeGroupColor %></span>
                    <span style="font-weight:500; flex:1;"><%= a.FirstName %> <%= a.LastName %></span>
                    <span style="font-size:0.8rem; color:var(--text-muted);"><%= fmtTimeOnly(a.MarkedAt) %></span>
                </div>
                <% }); %>
            </div>
            <% } %>

            <% if (todayEarlyDismissals.length > 0) { %>
            <div style="margin-bottom:16px;">
                <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted); margin-bottom:8px;">&#128663; Early Dismissals</div>
                <% todayEarlyDismissals.forEach(function(d) { %>
                <div style="display:flex; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid var(--border-color);">
                    <span class="tag <%= d.HomeGroupColor %>" style="font-size:0.65rem; padding:1px 7px; flex-shrink:0;"><%= d.HomeGroupColor %></span>
                    <span style="font-weight:500; flex:1;"><%= d.FirstName %> <%= d.LastName %></span>
                    <% if (d.DismissalTime) { %><span style="font-size:0.82rem; color:var(--text-muted);"><%= d.DismissalTime %></span><% } %>
                    <% if (d.Notes) { %><span style="font-size:0.8rem; color:var(--text-muted); flex:1;">&#128221; <%= d.Notes %></span><% } %>
                </div>
                <% }); %>
            </div>
            <% } %>

            <% if (todayScheduleChanges.length > 0) { %>
            <div>
                <div style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted); margin-bottom:8px;">&#128260; Class Roster Changes</div>
                <% todayScheduleChanges.forEach(function(c) { %>
                <div style="display:flex; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid var(--border-color); flex-wrap:wrap;">
                    <% if (c.ColorGroup) { %><span class="tag <%= c.ColorGroup %>" style="font-size:0.65rem; padding:1px 7px; flex-shrink:0;"><%= c.ColorGroup %></span><% } %>
                    <span style="font-weight:500;"><%= c.CamperName %></span>
                    <span style="font-size:0.8rem; color:var(--text-muted);">P<%= c.PeriodNumber %></span>
                    <span style="font-size:0.8rem; color:#ef4444; text-decoration:line-through;"><%= c.OldActivity %></span>
                    <span style="font-size:0.8rem; color:var(--text-muted);">&#8594;</span>
                    <span style="font-size:0.8rem; color:#22c55e; font-weight:600;"><%= c.NewActivity %></span>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>

        <% if (announcement) { %>
        <div class="card" style="margin-top:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h3 style="margin:0;">Announcements</h3>
            </div>
            <div class="hub-rich-content"><%- announcement %></div>
        </div>
        <% } %>

        <% if (selectedCounselorName) { %>
        <div style="margin-top:20px; font-size:0.875rem; display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <span style="background:#f1f5f9; border:1px solid var(--border-color); border-radius:20px; padding:5px 14px;">
                Attending as: <strong><%= selectedCounselorName %></strong>
            </span>
            <a href="/counselor-preferences" style="color:var(--text-muted); font-size:0.78rem;">Change</a>
            <button id="enableNotifyBtn" onclick="enablePushNotifications()"
                style="background:none; border:1px solid var(--border-color); border-radius:20px; padding:5px 14px; font-size:0.78rem; color:var(--text-muted); cursor:pointer; display:none;">
                &#128276; Enable notifications
            </button>
        </div>
        <% } %>

        <div class="switch-bar">
            <form action="/choose-view" method="POST" style="display:inline;">
                <input type="hidden" name="view" value="admin">
                <button type="submit">Switch to Admin View</button>
            </form>
        </div>
    </div>
    <script>
        setTimeout(() => location.reload(), 15 * 60 * 1000);
    </script>
</body>
</html>
