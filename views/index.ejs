<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Camp Hub | Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <script src="/js/nav.js" defer></script>
</head>
<body>

    <nav class="nav-bar">
        <a href="/admin" class="nav-btn primary">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128100; Counselor Lookup</a>
        <a href="/staff-lookup" class="nav-btn">&#128101; Staff Lookup</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/promotions" class="nav-btn">&#128276; Promotions</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/settings" class="nav-btn">&#9881;&#65039; Data Management</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
        <a href="/logout" class="nav-btn" style="color:#ef4444;">Log Out</a>
    </nav>

    <div class="container">
        <header class="header-flex">
            <div>
                <h1>Welcome back, Director</h1>
                <p class="text-muted">Here is what's happening at camp today.</p>
            </div>
        </header>

        <% if (waitlistCount > 0) { %>
            <div class="promo-alert">
                <span><strong>Promotion Available:</strong> There are <%= waitlistCount %> campers eligible for open spots!</span>
                <a href="/promotions" class="btn btn-success">View Promotions</a>
            </div>
        <% } %>

        <div class="stats-grid">
            <div class="card stat-card">
                <span class="stat-number"><%= camperTotal %></span>
                <span class="stat-label">Active Campers</span>
            </div>
            <div class="card stat-card">
                <span class="stat-number"><%= staffTotal %></span>
                <span class="stat-label">Total Staff</span>
            </div>
            <div class="card stat-card">
                <span class="stat-number"><%= activityCount %></span>
                <span class="stat-label">Activities Running</span>
            </div>
        </div>

        <div class="quick-tasks mt-20">
            <div class="card">
                <h3>Quick Tasks</h3>
                <ul>
                    <li>
                        <a href="/counselor-scheduling">Build Counselor Schedule →</a>
                    </li>
                    <li>
                        <a href="/export-master-schedule">Download Master Schedule CSV →</a>
                    </li>
                    <li>
                        <a href="/settings">Adjust Activity Capacities →</a>
                    </li>
                    <li>
                        <a href="/settings">Upload New CSV Data →</a>
                    </li>
                    <li>
                        <a href="/photo-gallery">View Photo Gallery →</a>
                    </li>
                </ul>
            </div>
            <div class="card">
                <h3>System Status</h3>
                <p class="text-muted" style="font-size: 0.9rem;">
                    Database: <span style="color: var(--success);">● Operational</span><br>
                    Current Season: Summer 2026<br>
                    Last Backup: Today, 8:00 AM
                </p>
            </div>
        </div>
        <div class="card" style="margin-top:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h3 style="margin:0;">Director Notes <span style="font-size:0.75rem; font-weight:400; color:var(--text-muted);">(admin only)</span></h3>
                <button onclick="saveNotes(event)" class="btn btn-primary btn-small">Save</button>
            </div>
            <div id="notesEditor" style="min-height:120px;"><%- directorNotes %></div>
        </div>

        <div class="card" style="margin-top:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h3 style="margin:0;">Staff Announcement</h3>
                <button onclick="saveAnnounce(event)" class="btn btn-primary btn-small">Save</button>
            </div>
            <div id="announceEditor" style="min-height:120px;"><%- announcement %></div>
        </div>
    </div>

    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <script>
        const TOOLBAR = [['bold', 'italic', 'underline'], [{ color: [] }], [{ list: 'bullet' }], ['clean']];
        const quillNotes    = new Quill('#notesEditor',    { theme: 'snow', modules: { toolbar: TOOLBAR } });
        const quillAnnounce = new Quill('#announceEditor', { theme: 'snow', modules: { toolbar: TOOLBAR } });
        async function saveHub(id, quillInstance, btn) {
            btn.disabled = true; btn.textContent = 'Saving…';
            await fetch(`/hub-content/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: quillInstance.root.innerHTML })
            });
            btn.textContent = 'Saved!';
            setTimeout(() => { btn.disabled = false; btn.textContent = 'Save'; }, 1500);
        }
        function saveNotes(e)    { saveHub('director_notes', quillNotes,    e.currentTarget); }
        function saveAnnounce(e) { saveHub('announcement',   quillAnnounce, e.currentTarget); }
    </script>
</body>
</html>