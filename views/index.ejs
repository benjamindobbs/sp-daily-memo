<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Camp Hub | Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <script src="/js/nav.js" defer></script>
    <style>
        .hub-stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }
        .hub-stat-card {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 18px 20px;
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            text-decoration: none;
            color: var(--text);
            transition: box-shadow 0.15s, transform 0.1s;
        }
        a.hub-stat-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.10); transform: translateY(-1px); }
        .hub-stat-num { font-size: 2rem; font-weight: 800; line-height: 1; }
        .hub-stat-label { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.4px; }
        .hub-stat-sub { font-size: 0.72rem; color: var(--text-muted); margin-top: 2px; }
        .hub-stat-inactive { opacity: 0.45; }

        .sys-status-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
        .sys-status-table td { padding: 5px 0; }
        .sys-status-table td:last-child { text-align: right; font-weight: 600; }
        .sys-status-divider td { padding-top: 10px; padding-bottom: 4px; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); border-top: 1px solid var(--border-color); }
        .group-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; }
        .group-dot.Red { background: #dc2626; }
        .group-dot.Carolina { background: #2563eb; }
        .group-dot.Green { background: #16a34a; }
        .group-dot.Navy { background: #1e3a5f; }
        .hub-num-amber  { color: #f59e0b; }
        .hub-num-purple { color: #8b5cf6; }
        .hub-num-muted  { color: #94a3b8; }
        .hub-num-green  { color: #10b981; }
    </style>
</head>
<body>

    <nav class="nav-bar">
        <a href="/admin" class="nav-btn primary">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128100; Counselor Lookup</a>
        <a href="/staff-lookup" class="nav-btn">&#128101; Staff Lookup</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/promotions" class="nav-btn">&#128276; Promotions</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/photo-gallery" class="nav-btn">&#128247; Photo of the Day</a>
        <a href="/settings" class="nav-btn">&#9881;&#65039; Data Management</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
        <a href="/logout" class="nav-btn" style="color:#ef4444;">Log Out</a>
    </nav>

    <div class="container">
        <header class="header-flex">
            <div>
                <h1>Welcome back, <%= adminName || 'Director' %>!</h1>
                <p class="text-muted">Here is what's happening at camp today.</p>
            </div>
            <span style="font-size:0.78rem; background:#f1f5f9; border:1px solid var(--border-color); border-radius:20px; padding:5px 14px; white-space:nowrap;">
                Active: <strong><%= sessions.find(s => s.isActive)?.label ?? '—' %></strong>
            </span>
        </header>

        <%/* ── Stat Cards ── */%>
        <div class="hub-stat-grid">

            <%/* ── Attendance cards: mode-aware ── */%>
            <% if (hubStats.mode === 'classes') { %>

                <%/* Sports */%>
                <% if (hubStats.sports && hubStats.sports.total > 0) { %>
                <% const sPct = Math.round(hubStats.sports.submitted / hubStats.sports.total * 100); %>
                <a href="/attendance?date=<%= today %>&period=<%= hubStats.sports.clockBlock %>" class="hub-stat-card" style="border-top:3px solid #3b82f6;">
                    <span class="hub-stat-num" style="color:#3b82f6;"><%= sPct %>%</span>
                    <span class="hub-stat-label">Sports Attendance In</span>
                    <span class="hub-stat-sub"><%= hubStats.sports.label %> &middot; <%= hubStats.sports.submitted %>/<%= hubStats.sports.total %> classes</span>
                </a>
                <% } else { %>
                <div class="hub-stat-card hub-stat-inactive" style="border-top:3px solid #3b82f6;">
                    <span class="hub-stat-num" style="color:#3b82f6;">—</span>
                    <span class="hub-stat-label">Sports Attendance In</span>
                    <span class="hub-stat-sub"><%= hubStats.sports ? hubStats.sports.label + ' · no classes found' : 'No active period' %></span>
                </div>
                <% } %>

                <%/* Enrichment */%>
                <% if (hubStats.enrich && hubStats.enrich.total > 0) { %>
                <% const ePct = Math.round(hubStats.enrich.submitted / hubStats.enrich.total * 100); %>
                <a href="/attendance?date=<%= today %>&period=<%= hubStats.enrich.clockBlock %>" class="hub-stat-card" style="border-top:3px solid #10b981;">
                    <span class="hub-stat-num" style="color:#10b981;"><%= ePct %>%</span>
                    <span class="hub-stat-label">Enrichment Attendance In</span>
                    <span class="hub-stat-sub"><%= hubStats.enrich.label %> &middot; <%= hubStats.enrich.submitted %>/<%= hubStats.enrich.total %> classes</span>
                </a>
                <% } else { %>
                <div class="hub-stat-card hub-stat-inactive" style="border-top:3px solid #10b981;">
                    <span class="hub-stat-num" style="color:#10b981;">—</span>
                    <span class="hub-stat-label">Enrichment Attendance In</span>
                    <span class="hub-stat-sub"><%= hubStats.enrich ? hubStats.enrich.label + ' · no classes found' : 'No active period' %></span>
                </div>
                <% } %>

            <% } else if (hubStats.mode === 'precamp') { %>

                <%/* AM Extended */%>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #6366f1;">
                    <span class="hub-stat-num <%= hubStats.amExt.submitted ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.amExt.submitted ? '✓' : '—' %></span>
                    <span class="hub-stat-label">AM Extended</span>
                    <span class="hub-stat-sub"><%= hubStats.amExt.submitted ? 'Submitted' : 'Pending' %></span>
                </a>

                <%/* AM Bus */%>
                <% const amBusDone = hubStats.amBus.total > 0 && hubStats.amBus.submitted === hubStats.amBus.total; %>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #0ea5e9;">
                    <span class="hub-stat-num <%= amBusDone ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.amBus.submitted %>/<%= hubStats.amBus.total %></span>
                    <span class="hub-stat-label">AM Buses</span>
                    <span class="hub-stat-sub">Routes with attendance in</span>
                </a>

                <%/* AM Home Groups */%>
                <% const amHgDone = hubStats.amHg.total > 0 && hubStats.amHg.submitted === hubStats.amHg.total; %>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #f97316;">
                    <span class="hub-stat-num <%= amHgDone ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.amHg.submitted %>/<%= hubStats.amHg.total %></span>
                    <span class="hub-stat-label">AM Home Groups</span>
                    <span class="hub-stat-sub">Counselors with attendance in</span>
                </a>

            <% } else { %>

                <%/* PM Home Groups */%>
                <% const pmHgDone = hubStats.pmHg.total > 0 && hubStats.pmHg.submitted === hubStats.pmHg.total; %>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #f97316;">
                    <span class="hub-stat-num <%= pmHgDone ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.pmHg.submitted %>/<%= hubStats.pmHg.total %></span>
                    <span class="hub-stat-label">PM Home Groups</span>
                    <span class="hub-stat-sub">Counselors with attendance in</span>
                </a>

                <%/* PM Bus */%>
                <% const pmBusDone = hubStats.pmBus.total > 0 && hubStats.pmBus.submitted === hubStats.pmBus.total; %>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #0ea5e9;">
                    <span class="hub-stat-num <%= pmBusDone ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.pmBus.submitted %>/<%= hubStats.pmBus.total %></span>
                    <span class="hub-stat-label">PM Buses</span>
                    <span class="hub-stat-sub">Routes with attendance in</span>
                </a>

                <%/* PM Extended */%>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #6366f1;">
                    <span class="hub-stat-num <%= hubStats.pmExt.submitted ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.pmExt.submitted ? '✓' : '—' %></span>
                    <span class="hub-stat-label">PM Extended</span>
                    <span class="hub-stat-sub"><%= hubStats.pmExt.submitted ? 'Submitted' : 'Pending' %></span>
                </a>

            <% } %>

            <%/* CampBrain Pending */%>
            <a href="/schedule-history" class="hub-stat-card" style="border-top:3px solid #f59e0b;">
                <span class="hub-stat-num <%= pendingChanges > 0 ? 'hub-num-amber' : 'hub-num-muted' %>"><%= pendingChanges %></span>
                <span class="hub-stat-label">CampBrain Updates Pending</span>
                <span class="hub-stat-sub"><%= pendingChanges > 0 ? 'Needs sync' : 'All up to date' %></span>
            </a>

            <%/* Promotions */%>
            <a href="/promotions" class="hub-stat-card" style="border-top:3px solid #8b5cf6;">
                <span class="hub-stat-num <%= waitlistCount > 0 ? 'hub-num-purple' : 'hub-num-muted' %>"><%= waitlistCount %></span>
                <span class="hub-stat-label">Promotions Available</span>
                <span class="hub-stat-sub"><%= waitlistCount > 0 ? 'Campers ready to promote' : 'Waitlist clear' %></span>
            </a>

        </div>

        <%/* ── Director Notes ── */%>
        <div class="card" style="margin-bottom:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h3 style="margin:0;">Director Notes <span style="font-size:0.75rem; font-weight:400; color:var(--text-muted);">(admin only)</span></h3>
                <div style="display:flex; gap:8px;">
                    <button id="notesEditBtn" onclick="editNotes()" class="btn btn-small" style="background:#f1f5f9; color:var(--text);">Edit</button>
                    <button id="notesSaveBtn" onclick="saveNotes(event)" class="btn btn-primary btn-small" style="display:none;">Save</button>
                </div>
            </div>
            <div id="notesEditor" style="min-height:120px;"></div>
        </div>

        <%/* ── Quick Tasks + System Status ── */%>
        <div class="quick-tasks">
            <div class="card">
                <h3>Quick Tasks</h3>
                <ul>
                    <li><a href="/counselor-scheduling">Build Counselor Schedule &rarr;</a></li>
                    <li><a href="/export-master-schedule">Download Master Schedule CSV &rarr;</a></li>
                    <li><a href="/settings">Adjust Activity Capacities &rarr;</a></li>
                    <li><a href="/settings">Upload New CSV Data &rarr;</a></li>
                    <li><a href="/photo-gallery">View Photo Gallery &rarr;</a></li>
                </ul>
            </div>
            <div class="card">
                <h3>System Status</h3>
                <table class="sys-status-table">
                    <tbody>
                        <tr><td>Database</td><td><span style="color:var(--success);">&#9679; Operational</span></td></tr>
                        <tr><td>Active Week</td><td><%= sessions.find(s => s.isActive)?.label ?? '—' %></td></tr>
                        <tr><td>Total Campers</td><td><%= camperTotal %></td></tr>
                        <tr><td>Activities Running</td><td><%= activityCount %></td></tr>
                        <tr class="sys-status-divider"><td colspan="2">Group Breakdown</td></tr>
                        <tr>
                            <td><span class="group-dot Red"></span>Red</td>
                            <td><%= groupCounts.Red || 0 %></td>
                        </tr>
                        <tr>
                            <td><span class="group-dot Carolina"></span>Carolina</td>
                            <td><%= groupCounts.Carolina || 0 %></td>
                        </tr>
                        <tr>
                            <td><span class="group-dot Green"></span>Green</td>
                            <td><%= groupCounts.Green || 0 %></td>
                        </tr>
                        <tr>
                            <td><span class="group-dot Navy"></span>Navy</td>
                            <td><%= groupCounts.Navy || 0 %></td>
                        </tr>
                        <% if (groupCounts.LilPlace) { %>
                        <tr><td>Li'l Place</td><td><%= groupCounts.LilPlace %></td></tr>
                        <% } %>
                        <% if (groupCounts.KinderPlace) { %>
                        <tr><td>Kinder Place</td><td><%= groupCounts.KinderPlace %></td></tr>
                        <% } %>
                        <% if (groupCounts.SPLIT) { %>
                        <tr><td>SPLIT</td><td><%= groupCounts.SPLIT %></td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <%/* ── Staff Announcement ── */%>
        <div class="card" style="margin-top:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h3 style="margin:0;">Staff Announcement</h3>
                <button onclick="saveAnnounce(event)" class="btn btn-primary btn-small">Save</button>
            </div>
            <div id="announceEditor" style="min-height:120px;"></div>
        </div>
    </div>

    <% if (!adminName) { %>
    <div id="nameModal" style="position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:1000;display:flex;align-items:center;justify-content:center;">
        <div style="background:white;border-radius:16px;padding:32px;width:340px;box-shadow:0 8px 32px rgba(0,0,0,0.18);">
            <h3 style="margin:0 0 6px;">Who are you?</h3>
            <p style="color:var(--text-muted);font-size:0.875rem;margin:0 0 20px;">Select your name or add a new one to continue.</p>
            <form action="/admin-set-name" method="POST">
                <div style="margin-bottom:14px;">
                    <label style="display:block;font-size:0.82rem;font-weight:600;margin-bottom:6px;">Select Name</label>
                    <select id="nameSelect" name="existingName" onchange="handleNameSelect(this)"
                            style="width:100%;padding:8px 10px;border:1px solid var(--border-color);border-radius:6px;font-size:0.9rem;box-sizing:border-box;">
                        <option value="">— Select your name —</option>
                        <% adminUsers.forEach(function(u) { %>
                        <option value="<%= u %>"><%= u %></option>
                        <% }); %>
                        <option value="__new__">+ New user...</option>
                    </select>
                </div>
                <div id="newNameField" style="display:none;margin-bottom:14px;">
                    <label style="display:block;font-size:0.82rem;font-weight:600;margin-bottom:6px;">Your Name</label>
                    <input type="text" id="newNameInput" name="newName" placeholder="First Last"
                           style="width:100%;padding:8px 10px;border:1px solid var(--border-color);border-radius:6px;font-size:0.9rem;box-sizing:border-box;">
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;padding:11px;">Continue</button>
            </form>
        </div>
    </div>
    <script>
    function handleNameSelect(sel) {
        document.getElementById('newNameField').style.display = sel.value === '__new__' ? '' : 'none';
        if (sel.value === '__new__') document.getElementById('newNameInput').focus();
    }
    </script>
    <% } %>

    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <script>
        const SAVED_NOTES    = <%- JSON.stringify(directorNotes || '') %>;
        const SAVED_ANNOUNCE = <%- JSON.stringify(announcement  || '') %>;

        let isEditingNotes = false;
        const TOOLBAR = [['bold', 'italic', 'underline'], [{ color: [] }], [{ list: 'bullet' }], ['clean']];
        const quillNotes    = new Quill('#notesEditor',    { theme: 'snow', modules: { toolbar: TOOLBAR } });
        const quillAnnounce = new Quill('#announceEditor', { theme: 'snow', modules: { toolbar: TOOLBAR } });

        // Explicitly restore saved content rather than relying on Quill to parse container HTML
        if (SAVED_NOTES)    quillNotes.root.innerHTML    = SAVED_NOTES;
        if (SAVED_ANNOUNCE) quillAnnounce.root.innerHTML = SAVED_ANNOUNCE;

        const notesToolbar = quillNotes.getModule('toolbar').container;
        quillNotes.disable();
        notesToolbar.style.display = 'none';

        function editNotes() {
            quillNotes.enable();
            notesToolbar.style.display = '';
            document.getElementById('notesEditBtn').style.display = 'none';
            document.getElementById('notesSaveBtn').style.display = '';
            isEditingNotes = true;
        }

        async function saveHub(id, quillInstance, btn) {
            btn.disabled = true; btn.textContent = 'Saving…';
            await fetch(`/hub-content/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: quillInstance.root.innerHTML })
            });
            btn.textContent = 'Saved!';
            setTimeout(() => { btn.disabled = false; btn.textContent = 'Save'; }, 1500);
        }

        function saveNotes(e) {
            saveHub('director_notes', quillNotes, e.currentTarget).then(() => {
                quillNotes.disable();
                notesToolbar.style.display = 'none';
                document.getElementById('notesEditBtn').style.display = '';
                document.getElementById('notesSaveBtn').style.display = 'none';
                isEditingNotes = false;
            });
        }
        function saveAnnounce(e) { saveHub('announcement', quillAnnounce, e.currentTarget); }

        // Auto-refresh stats every 60 seconds when not actively editing
        quillAnnounce.on('text-change', () => { isEditingNotes = true; });
        setInterval(() => {
            if (!isEditingNotes) location.reload();
        }, 60000);
    </script>
</body>
</html>
