    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <script>
        // Register font whitelist before any Quill instance is created
        const Font = Quill.import('formats/font');
        Font.whitelist = ['serif', 'monospace'];
        Quill.register(Font, true);

        const SAVED_ANNOUNCE = <%- JSON.stringify(announcement || '') %>;

        let isEditing = false;
        const TOOLBAR = [
            [{ font: [] }],
            [{ size: ['small', false, 'large', 'huge'] }],
            ['bold', 'italic', 'underline'],
            [{ color: [] }],
            [{ align: [] }],
            [{ list: 'bullet' }],
            ['clean']
        ];
        const quillAnnounce = new Quill('#announceEditor', { theme: 'snow', modules: { toolbar: TOOLBAR } });
        if (SAVED_ANNOUNCE) quillAnnounce.root.innerHTML = SAVED_ANNOUNCE;

        async function saveHub(id, quillInstance, btn) {
            btn.disabled = true; btn.textContent = 'Saving…';
            await fetch(`/hub-content/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: quillInstance.root.innerHTML })
            });
            btn.textContent = 'Saved!';
            setTimeout(() => { btn.disabled = false; btn.textContent = 'Save'; }, 1500);
        }
        function saveAnnounce(e) { saveHub('announcement', quillAnnounce, e.currentTarget); }

        document.querySelectorAll('.note-ts[data-ts]').forEach(function(el) {
            const raw = el.dataset.ts || '';
            const d = new Date(raw.includes('Z') ? raw : raw.replace(' ', 'T') + 'Z');
            el.textContent = isNaN(d) ? raw : d.toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
        });

        // Director Notes feed controls
        function toggleAddNote() {
            const f = document.getElementById('addNoteForm');
            f.style.display = f.style.display === 'none' ? '' : 'none';
        }

        function toggleNoteEdit(id) {
            const body = document.getElementById('note-body-' + id);
            const form = document.getElementById('note-edit-form-' + id);
            const editing = form.style.display !== 'none';
            body.style.display = editing ? '' : 'none';
            form.style.display = editing ? 'none' : '';
        }

        let _notesCat = 'director';
        let _notesFilter = 'all';

        function setCatTab(cat, btn) {
            _notesCat = cat;
            document.querySelectorAll('.notes-cat-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const catInput = document.getElementById('noteCategory');
            if (catInput) catInput.value = cat;
            applyNotesFilter();
        }

        function setNotesFilter(filter, btn) {
            _notesFilter = filter;
            document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            applyNotesFilter();
        }
        function applyNotesFilter() {
            const query = (document.getElementById('notesSearch').value || '').toLowerCase();
            const now = new Date();
            const todayStr = now.toISOString().slice(0, 10);
            const weekStart = new Date(now);
            weekStart.setDate(now.getDate() - now.getDay());
            weekStart.setHours(0, 0, 0, 0);
            let visibleCount = 0;
            document.querySelectorAll('.note-item').forEach(item => {
                const cat = item.dataset.category || 'director';
                if (cat !== _notesCat) { item.style.display = 'none'; return; }
                const dateStr = item.dataset.date ? item.dataset.date.slice(0, 10) : '';
                const itemDate = new Date(item.dataset.date);
                let dateMatch = true;
                if (_notesFilter === 'today') dateMatch = dateStr === todayStr;
                else if (_notesFilter === 'week') dateMatch = itemDate >= weekStart;
                const textMatch = !query ||
                    (item.dataset.body || '').includes(query) ||
                    (item.dataset.author || '').includes(query) ||
                    dateStr.includes(query);
                const show = dateMatch && textMatch;
                item.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });
            const emptyMsg = document.getElementById('notesEmpty');
            if (emptyMsg) emptyMsg.style.display = visibleCount === 0 ? '' : 'none';
        }

        // Apply initial category filter so only Director Notes tab items show on load
        applyNotesFilter();

        // Auto-refresh stats every 60 seconds when not actively editing
        quillAnnounce.on('text-change', () => { isEditing = true; });
        setInterval(() => {
            if (!isEditing) location.reload();
        }, 60000);
    </script>
    <script>
        (function () {
            const banner  = document.getElementById('adminAlertBanner');
            const msgEl   = document.getElementById('adminAlertMsg');
            const SK      = 'adminAlertDismissed';

            function showBanner(alert) {
                const dismissed = parseInt(localStorage.getItem(SK) || '0');
                if (alert.AlertID <= dismissed) return;
                msgEl.textContent = alert.message + (alert.sentBy ? ' — ' + alert.sentBy : '');
                banner.style.display = 'flex';
                banner._alertId = alert.AlertID;
            }

            window.dismissAdminBanner = function () {
                localStorage.setItem(SK, String(banner._alertId || 0));
                banner.style.display = 'none';
            };

            function poll() {
                fetch('/api/admin-alert-banner')
                    .then(r => r.json())
                    .then(data => { if (data.alert) showBanner(data.alert); })
                    .catch(() => {});
            }

            poll();
            setInterval(poll, 30000);
        })();
    </script>
</body>
</html>