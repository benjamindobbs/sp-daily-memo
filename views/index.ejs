<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Camp Hub | Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <script src="/js/nav.js" defer></script>
    <style>
        .hub-stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }
        .hub-stat-card {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 18px 20px;
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            text-decoration: none;
            color: var(--text);
            transition: box-shadow 0.15s, transform 0.1s;
        }
        a.hub-stat-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.10); transform: translateY(-1px); }
        .hub-stat-num { font-size: 2rem; font-weight: 800; line-height: 1; }
        .hub-stat-label { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.4px; }
        .hub-stat-sub { font-size: 0.72rem; color: var(--text-muted); margin-top: 2px; }
        .hub-stat-inactive { opacity: 0.45; }

        .sys-status-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
        .sys-status-table td { padding: 5px 0; }
        .sys-status-table td:last-child { text-align: right; font-weight: 600; }
        .sys-status-divider td { padding-top: 10px; padding-bottom: 4px; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); border-top: 1px solid var(--border-color); }
        .group-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; }
        .group-dot.Red { background: #dc2626; }
        .group-dot.Carolina { background: #2563eb; }
        .group-dot.Green { background: #16a34a; }
        .group-dot.Navy { background: #1e3a5f; }
        .group-dot.LilPlace { background: #6ee7b7; }
        .group-dot.KinderPlace { background: #fef08a; }
        .group-dot.SPLIT { background: #fbbf24; }
        .group-dot.SPRC { background: #94a3b8; }
        .hub-num-amber  { color: #f59e0b; }
        .hub-num-purple { color: #8b5cf6; }
        .hub-num-muted  { color: #94a3b8; }
        .hub-num-green  { color: #10b981; }
        .hub-num-red    { color: #ef4444; }

        /* Quill font family classes */
        .ql-font-serif     { font-family: Georgia, 'Times New Roman', serif; }
        .ql-font-monospace { font-family: 'Courier New', Courier, monospace; }
    </style>
</head>
<body>

    <nav class="nav-bar">
        <a href="/admin" class="nav-btn primary">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/map" class="nav-btn">&#128205; Camp Map</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128101; Staff Directory</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/promotions" class="nav-btn">&#128276; Promotions</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
        <a href="/photo-gallery" class="nav-btn">&#128247; Photo of the Day</a>
        <a href="/alerts" class="nav-btn">&#128226; Alerts</a>
        <a href="/settings" class="nav-btn">&#9881;&#65039; Data Management</a>
        <a href="/split-scheduling" class="nav-btn" style="margin-left:auto;">&#127820; SPLIT View</a>
        <form action="/choose-view" method="POST">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
        <a href="/logout" class="nav-btn" style="color:#ef4444;">Log Out</a>
    </nav>

    <div id="adminAlertBanner" style="display:none; background:#dc2626; color:#fff; padding:12px 20px; font-weight:600; font-size:0.95rem; align-items:center; gap:12px; position:sticky; top:48px; z-index:99;">
        <span style="flex:1;">&#128226; <span id="adminAlertMsg"></span></span>
        <button onclick="dismissAdminBanner()" style="background:rgba(255,255,255,0.2); border:none; color:#fff; border-radius:4px; padding:3px 10px; cursor:pointer; font-size:0.85rem;">Dismiss</button>
    </div>

    <div class="container">
        <header class="header-flex">
            <div>
                <h1>Welcome back, <%= adminName || 'Director' %>!</h1>
                <p class="text-muted">Here is what's happening at camp today.</p>
            </div>
            <span style="font-size:0.78rem; background:#f1f5f9; border:1px solid var(--border-color); border-radius:20px; padding:5px 14px; white-space:nowrap;">
                Active: <strong><%= sessions.find(s => s.isActive)?.label ?? '—' %></strong>
            </span>
        </header>

        <%/* ── Stat Cards ── */%>
        <div class="hub-stat-grid">

            <%/* ── Attendance cards: mode-aware ── */%>
            <% if (hubStats.mode === 'classes') { %>

                <%/* Sports */%>
                <% if (hubStats.sports && hubStats.sports.total > 0) { %>
                <% const sPct = Math.round(hubStats.sports.submitted / hubStats.sports.total * 100); %>
                <a href="/attendance?date=<%= today %>&period=<%= hubStats.sports.clockBlock %>" class="hub-stat-card" style="border-top:3px solid #3b82f6;">
                    <span class="hub-stat-num" style="color:#3b82f6;"><%= sPct %>%</span>
                    <span class="hub-stat-label">Sports Attendance In</span>
                    <span class="hub-stat-sub"><%= hubStats.sports.label %> &middot; <%= hubStats.sports.submitted %>/<%= hubStats.sports.total %> classes</span>
                </a>
                <% } else { %>
                <div class="hub-stat-card hub-stat-inactive" style="border-top:3px solid #3b82f6;">
                    <span class="hub-stat-num" style="color:#3b82f6;">—</span>
                    <span class="hub-stat-label">Sports Attendance In</span>
                    <span class="hub-stat-sub"><%= hubStats.sports ? hubStats.sports.label + ' · no classes found' : 'No active period' %></span>
                </div>
                <% } %>

                <%/* Enrichment */%>
                <% if (hubStats.enrich && hubStats.enrich.total > 0) { %>
                <% const ePct = Math.round(hubStats.enrich.submitted / hubStats.enrich.total * 100); %>
                <a href="/attendance?date=<%= today %>&period=<%= hubStats.enrich.clockBlock %>" class="hub-stat-card" style="border-top:3px solid #10b981;">
                    <span class="hub-stat-num" style="color:#10b981;"><%= ePct %>%</span>
                    <span class="hub-stat-label">Enrichment Attendance In</span>
                    <span class="hub-stat-sub"><%= hubStats.enrich.label %> &middot; <%= hubStats.enrich.submitted %>/<%= hubStats.enrich.total %> classes</span>
                </a>
                <% } else { %>
                <div class="hub-stat-card hub-stat-inactive" style="border-top:3px solid #10b981;">
                    <span class="hub-stat-num" style="color:#10b981;">—</span>
                    <span class="hub-stat-label">Enrichment Attendance In</span>
                    <span class="hub-stat-sub"><%= hubStats.enrich ? hubStats.enrich.label + ' · no classes found' : 'No active period' %></span>
                </div>
                <% } %>

            <% } else if (hubStats.mode === 'lunch') { %>

                <%/* Lunch Home Groups */%>
                <% const lunchHgDone = hubStats.lunchHg.total > 0 && hubStats.lunchHg.submitted === hubStats.lunchHg.total; %>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #f97316;">
                    <span class="hub-stat-num <%= lunchHgDone ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.lunchHg.submitted %>/<%= hubStats.lunchHg.total %></span>
                    <span class="hub-stat-label">Lunch Home Groups</span>
                    <span class="hub-stat-sub">Counselors with attendance in</span>
                </a>

            <% } else if (hubStats.mode === 'precamp') { %>

                <%/* AM Extended */%>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #6366f1;">
                    <span class="hub-stat-num <%= hubStats.amExt.submitted ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.amExt.submitted ? '✓' : '—' %></span>
                    <span class="hub-stat-label">AM Extended</span>
                    <span class="hub-stat-sub"><%= hubStats.amExt.submitted ? 'Submitted' : 'Pending' %></span>
                </a>

                <%/* AM Bus */%>
                <% const amBusDone = hubStats.amBus.total > 0 && hubStats.amBus.submitted === hubStats.amBus.total; %>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #0ea5e9;">
                    <span class="hub-stat-num <%= amBusDone ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.amBus.submitted %>/<%= hubStats.amBus.total %></span>
                    <span class="hub-stat-label">AM Buses</span>
                    <span class="hub-stat-sub">Routes with attendance in</span>
                </a>

                <%/* AM Home Groups */%>
                <% const amHgDone = hubStats.amHg.total > 0 && hubStats.amHg.submitted === hubStats.amHg.total; %>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #f97316;">
                    <span class="hub-stat-num <%= amHgDone ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.amHg.submitted %>/<%= hubStats.amHg.total %></span>
                    <span class="hub-stat-label">AM Home Groups</span>
                    <span class="hub-stat-sub">Counselors with attendance in</span>
                </a>

            <% } else { %>

                <%/* PM Home Groups */%>
                <% const pmHgDone = hubStats.pmHg.total > 0 && hubStats.pmHg.submitted === hubStats.pmHg.total; %>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #f97316;">
                    <span class="hub-stat-num <%= pmHgDone ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.pmHg.submitted %>/<%= hubStats.pmHg.total %></span>
                    <span class="hub-stat-label">PM Home Groups</span>
                    <span class="hub-stat-sub">Counselors with attendance in</span>
                </a>

                <%/* PM Bus */%>
                <% const pmBusDone = hubStats.pmBus.total > 0 && hubStats.pmBus.submitted === hubStats.pmBus.total; %>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #0ea5e9;">
                    <span class="hub-stat-num <%= pmBusDone ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.pmBus.submitted %>/<%= hubStats.pmBus.total %></span>
                    <span class="hub-stat-label">PM Buses</span>
                    <span class="hub-stat-sub">Routes with attendance in</span>
                </a>

                <%/* PM Extended */%>
                <a href="/attendance?date=<%= today %>" class="hub-stat-card" style="border-top:3px solid #6366f1;">
                    <span class="hub-stat-num <%= hubStats.pmExt.submitted ? 'hub-num-green' : 'hub-num-muted' %>"><%= hubStats.pmExt.submitted ? '✓' : '—' %></span>
                    <span class="hub-stat-label">PM Extended</span>
                    <span class="hub-stat-sub"><%= hubStats.pmExt.submitted ? 'Submitted' : 'Pending' %></span>
                </a>

            <% } %>

            <%/* Nurse */%>
            <a href="/nurse" class="hub-stat-card" style="border-top:3px solid #ef4444;">
                <span class="hub-stat-num <%= nurseCount > 0 ? 'hub-num-red' : 'hub-num-muted' %>"><%= nurseCount %></span>
                <span class="hub-stat-label">&#128137; At the Nurse</span>
                <span class="hub-stat-sub"><%= nurseCount > 0 ? nurseCount === 1 ? '1 camper checked in' : nurseCount + ' campers checked in' : 'All clear' %></span>
            </a>

            <%/* CampBrain Pending */%>
            <a href="/schedule-history" class="hub-stat-card" style="border-top:3px solid #f59e0b;">
                <span class="hub-stat-num <%= pendingChanges > 0 ? 'hub-num-amber' : 'hub-num-muted' %>"><%= pendingChanges %></span>
                <span class="hub-stat-label">CampBrain Updates Pending</span>
                <span class="hub-stat-sub"><%= pendingChanges > 0 ? 'Needs sync' : 'All up to date' %></span>
            </a>

            <%/* Promotions */%>
            <a href="/promotions" class="hub-stat-card" style="border-top:3px solid #8b5cf6;">
                <span class="hub-stat-num <%= waitlistCount > 0 ? 'hub-num-purple' : 'hub-num-muted' %>"><%= waitlistCount %></span>
                <span class="hub-stat-label">Promotions Available</span>
                <span class="hub-stat-sub"><%= waitlistCount > 0 ? 'Campers ready to promote' : 'Waitlist clear' %></span>
            </a>

        </div>

        <!-- Schedule Bars -->
        <style>
        @media (max-width: 600px) { .admin-sched-grid { grid-template-columns: 1fr !important; } }
        </style>
        <div style="margin-bottom:20px;">
            <div class="admin-sched-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
                <!-- Sports compact card -->
                <div class="admin-sched-card" style="padding:14px 18px; background:white; border:1px solid var(--border-color); border-radius:12px; box-shadow:var(--shadow); cursor:pointer; user-select:none;" onclick="openAdminSched('sports')">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                        <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#3b82f6;">Sports</div>
                        <span style="font-size:0.7rem; color:var(--text-muted);">&#9660;</span>
                    </div>
                    <div id="as-name" style="font-size:1rem; font-weight:700; color:var(--text); margin-bottom:8px; display:none;"></div>
                    <div id="as-row" style="display:none; align-items:center; gap:8px;">
                        <span id="as-start" style="font-size:0.72rem; color:var(--text-muted); min-width:36px; font-variant-numeric:tabular-nums;"></span>
                        <div style="flex:1; height:6px; background:var(--border-color); border-radius:3px; overflow:hidden;">
                            <div id="as-fill" style="height:100%; border-radius:3px; background:#3b82f6; width:0%; transition:width 0.5s;"></div>
                        </div>
                        <span id="as-end" style="font-size:0.72rem; color:var(--text-muted); min-width:36px; text-align:right; font-variant-numeric:tabular-nums;"></span>
                    </div>
                    <div id="as-status" style="font-size:0.8rem; color:var(--text-muted); font-style:italic;"></div>
                </div>
                <!-- Enrichment compact card -->
                <div class="admin-sched-card" style="padding:14px 18px; background:white; border:1px solid var(--border-color); border-radius:12px; box-shadow:var(--shadow); cursor:pointer; user-select:none;" onclick="openAdminSched('enrichment')">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                        <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#10b981;">Enrichment</div>
                        <span style="font-size:0.7rem; color:var(--text-muted);">&#9660;</span>
                    </div>
                    <div id="ae-name" style="font-size:1rem; font-weight:700; color:var(--text); margin-bottom:8px; display:none;"></div>
                    <div id="ae-row" style="display:none; align-items:center; gap:8px;">
                        <span id="ae-start" style="font-size:0.72rem; color:var(--text-muted); min-width:36px; font-variant-numeric:tabular-nums;"></span>
                        <div style="flex:1; height:6px; background:var(--border-color); border-radius:3px; overflow:hidden;">
                            <div id="ae-fill" style="height:100%; border-radius:3px; background:#10b981; width:0%; transition:width 0.5s;"></div>
                        </div>
                        <span id="ae-end" style="font-size:0.72rem; color:var(--text-muted); min-width:36px; text-align:right; font-variant-numeric:tabular-nums;"></span>
                    </div>
                    <div id="ae-status" style="font-size:0.8rem; color:var(--text-muted); font-style:italic;"></div>
                </div>
            </div>
            <!-- Expanded full-day timeline (shared, shown below both cards) -->
            <div id="as-expand" style="display:none; margin-top:8px; padding:14px 18px; background:white; border:1px solid var(--border-color); border-radius:12px; box-shadow:var(--shadow);">
                <div style="display:flex; gap:6px; margin-bottom:14px;">
                    <button id="as-btn-sports"     onclick="setAdminSchedSide('sports',event)"     style="padding:4px 14px; border:1px solid var(--border-color); border-radius:20px; font-size:0.78rem; font-weight:600; cursor:pointer; background:white; color:var(--text); transition:all 0.15s;">Sports</button>
                    <button id="as-btn-enrichment" onclick="setAdminSchedSide('enrichment',event)" style="padding:4px 14px; border:1px solid var(--border-color); border-radius:20px; font-size:0.78rem; font-weight:600; cursor:pointer; background:white; color:var(--text); transition:all 0.15s;">Enrichment</button>
                </div>
                <div style="position:relative; padding-top:22px;">
                    <div id="as-tl-labels" style="position:absolute; top:0; left:0; right:0; height:20px; pointer-events:none;"></div>
                    <div style="position:relative;">
                        <div id="as-tl-bar" style="display:flex; height:14px; border-radius:7px; overflow:hidden;"></div>
                        <div id="as-tl-cursor" style="position:absolute; top:-3px; bottom:-3px; width:2px; background:rgba(0,0,0,0.3); border-radius:1px; display:none; pointer-events:none;"></div>
                        <div id="as-tl-tooltip" style="position:absolute; bottom:calc(100% + 8px); background:#1e293b; color:#fff; border-radius:7px; padding:6px 10px; font-size:0.75rem; white-space:nowrap; display:none; pointer-events:none; transform:translateX(-50%); z-index:20; box-shadow:0 2px 8px rgba(0,0,0,0.25);">
                            <div id="as-tl-tt-name" style="font-weight:700;"></div>
                            <div id="as-tl-tt-time" style="color:#94a3b8; font-size:0.7rem; margin-top:1px;"></div>
                        </div>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:0.63rem; color:var(--text-muted); margin-top:4px; padding:0 1px;">
                        <span>9:00</span><span>12:00</span><span>4:30</span>
                    </div>
                </div>
            </div>
        </div>
        <script>
        (function() {
            const SPORTS_S = <%- JSON.stringify(sportsScheduleFull) %>;
            const ENRICH_S = <%- JSON.stringify(enrichmentScheduleFull) %>;
            const DAY_START=540, DAY_END=990, DAY_SPAN=450;
            let adminExpanded=false, adminSide='sports';

            function estMins(){const p=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',hour:'numeric',minute:'numeric',hour12:false}).formatToParts(new Date());return parseInt(p.find(x=>x.type==='hour').value)*60+parseInt(p.find(x=>x.type==='minute').value);}
            function fmt(m){const h=Math.floor(m/60),mn=m%60,h12=h>12?h-12:(h===0?12:h);return`${h12}:${String(mn).padStart(2,'0')}`;}
            function getState(sched,mins){
                for(const b of sched){const s=b.startH*60+b.startM,e=b.endH*60+b.endM;if(mins>=s&&mins<e)return{type:'active',b,s,e,pct:Math.round((mins-s)/(e-s)*100)};}
                if(mins<sched[0].startH*60+sched[0].startM)return{type:'before',next:sched[0]};
                for(let i=0;i<sched.length-1;i++){const te=sched[i].endH*60+sched[i].endM,ns=sched[i+1].startH*60+sched[i+1].startM;if(mins>=te&&mins<ns)return{type:'between',next:sched[i+1]};}
                return{type:'after'};
            }
            function renderCompact(prefix,sched,color){
                const st=getState(sched,estMins());
                const nEl=document.getElementById(prefix+'-name'),rEl=document.getElementById(prefix+'-row'),
                      fEl=document.getElementById(prefix+'-fill'),sEl=document.getElementById(prefix+'-start'),
                      eEl=document.getElementById(prefix+'-end'),stEl=document.getElementById(prefix+'-status');
                if(!nEl)return;
                if(st.type==='active'){nEl.textContent=st.b.label;sEl.textContent=fmt(st.s);eEl.textContent=fmt(st.e);fEl.style.width=st.pct+'%';nEl.style.display='';rEl.style.display='flex';stEl.textContent='';}
                else if(st.type==='between'){const ns=st.next.startH*60+st.next.startM;nEl.textContent='Next: '+st.next.label;sEl.textContent='';eEl.textContent=fmt(ns);fEl.style.width='0%';nEl.style.display='';rEl.style.display='flex';stEl.textContent='';}
                else if(st.type==='before'){nEl.style.display='none';rEl.style.display='none';stEl.textContent='Camp starts at '+fmt(st.next.startH*60+st.next.startM);}
                else{nEl.style.display='none';rEl.style.display='none';stEl.textContent='Camp day complete';}
            }

            function blkColor(label,s){if(label==='Lunch')return'#64748b';if(label==='Dismissal')return'#94a3b8';if(['Snack Break','Popsicle Break','Big Game'].includes(label))return'#f59e0b';return s==='sports'?'#3b82f6':'#10b981';}
            function blkAbbr(l){return l.replace('Sports ','S').replace('Enrichment ','E').replace('Snack Break','Snack').replace('Popsicle Break','PB').replace('Big Game','BG').replace('Dismissal','Dis');}

            function buildTimeline(){
                const sched=adminSide==='sports'?SPORTS_S:ENRICH_S;
                const barEl=document.getElementById('as-tl-bar'),lblEl=document.getElementById('as-tl-labels'),curEl=document.getElementById('as-tl-cursor');
                if(!barEl)return;
                const segs=[];let cur=DAY_START;
                for(const b of sched){const s=b.startH*60+b.startM,e=b.endH*60+b.endM;if(s>cur)segs.push({gap:true,mins:s-cur,s:cur,e:s});segs.push({label:b.label,gap:false,mins:e-s,s,e});cur=e;}
                if(cur<DAY_END)segs.push({gap:true,mins:DAY_END-cur,s:cur,e:DAY_END});
                barEl.innerHTML=segs.map(sg=>{const p=(sg.mins/DAY_SPAN*100).toFixed(3),bg=sg.gap?'#e2e8f0':blkColor(sg.label,adminSide);if(sg.gap)return`<div style="flex:0 0 ${p}%;background:${bg};"></div>`;return`<div style="flex:0 0 ${p}%;background:${bg};cursor:pointer;" data-label="${sg.label}" data-s="${sg.s}" data-e="${sg.e}"></div>`;}).join('');
                barEl.onmousemove=ev=>{const t=ev.target;if(t===barEl||!t.dataset.label)return;const br=barEl.getBoundingClientRect(),sr=t.getBoundingClientRect(),pct=(sr.left-br.left+sr.width/2)/br.width*100,tt=document.getElementById('as-tl-tooltip');if(!tt)return;document.getElementById('as-tl-tt-name').textContent=t.dataset.label;document.getElementById('as-tl-tt-time').textContent=fmt(+t.dataset.s)+' – '+fmt(+t.dataset.e);tt.style.left=pct+'%';tt.style.display='block';};
                barEl.onmouseleave=()=>{const tt=document.getElementById('as-tl-tooltip');if(tt)tt.style.display='none';};
                barEl.onclick=ev=>{const t=ev.target;if(t===barEl||!t.dataset.label)return;const br=barEl.getBoundingClientRect(),sr=t.getBoundingClientRect(),pct=(sr.left-br.left+sr.width/2)/br.width*100,tt=document.getElementById('as-tl-tooltip');if(!tt)return;document.getElementById('as-tl-tt-name').textContent=t.dataset.label;document.getElementById('as-tl-tt-time').textContent=fmt(+t.dataset.s)+' – '+fmt(+t.dataset.e);tt.style.left=pct+'%';tt.style.display=tt.style.display==='block'?'none':'block';};
                barEl.addEventListener('touchend',function(ev){const touch=ev.changedTouches[0],br=barEl.getBoundingClientRect();if(Math.abs(touch.clientY-(br.top+br.height/2))>28)return;let found=null;for(const c of barEl.children){const cr=c.getBoundingClientRect();if(touch.clientX>=cr.left&&touch.clientX<=cr.right){found=c;break;}}if(!found||!found.dataset.label)return;ev.preventDefault();const sr=found.getBoundingClientRect(),pct=(sr.left-br.left+sr.width/2)/br.width*100,tt=document.getElementById('as-tl-tooltip');if(!tt)return;document.getElementById('as-tl-tt-name').textContent=found.dataset.label;document.getElementById('as-tl-tt-time').textContent=fmt(+found.dataset.s)+' – '+fmt(+found.dataset.e);tt.style.left=pct+'%';tt.style.display='block';},{passive:false});
                lblEl.innerHTML='';let lp=0;
                for(const sg of segs){const p=sg.mins/DAY_SPAN*100;if(!sg.gap){const el=document.createElement('span');el.textContent=blkAbbr(sg.label);el.style.cssText=`position:absolute;left:${(lp+p/2).toFixed(2)}%;transform:translateX(-50%);font-size:0.6rem;font-weight:600;color:#64748b;white-space:nowrap;`;lblEl.appendChild(el);}lp+=p;}
                const now=estMins();
                if(now>=DAY_START&&now<=DAY_END){curEl.style.left=((now-DAY_START)/DAY_SPAN*100).toFixed(2)+'%';curEl.style.display='block';}else curEl.style.display='none';
                ['sports','enrichment'].forEach(s=>{const btn=document.getElementById('as-btn-'+s);if(!btn)return;const on=s===adminSide,c=s==='sports'?'#3b82f6':'#10b981';btn.style.background=on?c:'';btn.style.color=on?'white':'';btn.style.borderColor=on?c:'';});
            }

            window.openAdminSched=function(s){
                adminSide=s;
                if(!adminExpanded){adminExpanded=true;document.getElementById('as-expand').style.display='block';}
                buildTimeline();
            };
            window.setAdminSchedSide=function(s,e){if(e)e.stopPropagation();adminSide=s;buildTimeline();};

            document.addEventListener('touchstart',function(ev){const bar=document.getElementById('as-tl-bar');if(bar&&bar.contains(ev.target))return;const tt=document.getElementById('as-tl-tooltip');if(tt)tt.style.display='none';},{passive:true});
            function updateAll(){renderCompact('as',SPORTS_S,'#3b82f6');renderCompact('ae',ENRICH_S,'#10b981');}
            updateAll();
            setInterval(()=>{updateAll();if(adminExpanded)buildTimeline();},30000);
        })();
        </script>

