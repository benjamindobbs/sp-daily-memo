<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Schedule | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>
<body>

    <% if (viewMode === 'admin') { %>
    <nav class="nav-bar">
        <a href="<%= viewMode === 'admin' ? '/admin' : '/staff' %>" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn primary">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128101; Staff Directory</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
    </nav>
    <% } else { %>
    <nav class="nav-bar">
        <a href="/staff" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn primary">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="admin">
            <button class="nav-btn" style="cursor:pointer;">&#128274; Admin View</button>
        </form>
    </nav>
    <% } %>

    <div class="container-xl">
        <header style="margin-bottom: 24px;">
            <div style="display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;">
                <h1 style="margin:0;">Master Schedule</h1>
                <% if (isPrepping) { %>
                <span style="background:#fef3c7; color:#92400e; font-size:0.78rem; font-weight:700; padding:3px 10px; border-radius:20px; border:1px solid #fde68a;">&#9998; Prep &mdash; <%= weekLabel %></span>
                <% } else { %>
                <span style="background:#dcfce7; color:#166534; font-size:0.78rem; font-weight:700; padding:3px 10px; border-radius:20px; border:1px solid #bbf7d0;">&#9679; <%= weekLabel %></span>
                <% } %>
            </div>
            <p style="color: var(--text-muted); margin: 4px 0 0;">All classes by period. Click a class name to view its full roster.</p>
        </header>

        <div class="filter-bar">
            <input type="search" id="scheduleSearch" placeholder="&#128269; Search class, staff, counselor, camper..." autocomplete="off"
                oninput="applyFilters()"
                style="padding:6px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:0.875rem; font-family:inherit; min-width:260px; outline:none;">

            <label for="periodFilter" style="margin-left:10px;">Period:</label>
            <select id="periodFilter" class="filter-dropdown" onchange="applyFilters()">
                <option value="all">All Periods</option>
                <% for (let p = 1; p <= 6; p++) { %>
                    <option value="<%= p %>">Period <%= p %></option>
                <% } %>
            </select>

            <label for="sideFilter" style="margin-left: 10px;">Side:</label>
            <select id="sideFilter" class="filter-dropdown" onchange="applyFilters()">
                <option value="all">All</option>
                <option value="Sports">Sports</option>
                <option value="Enrichment">Enrichment</option>
            </select>

            <label for="groupFilter" style="margin-left: 10px;">Group:</label>
            <select id="groupFilter" class="filter-dropdown" onchange="applyFilters()">
                <option value="all">All Groups</option>
                <option value="Red">Red</option>
                <option value="Carolina">Carolina</option>
                <option value="Green">Green</option>
                <option value="Navy">Navy</option>
            </select>
        </div>

        <% schedule.forEach(function(period) { %>
        <div class="period-section" data-period="<%= period.periodLabel %>">
            <div class="period-header">
                <span class="period-badge">Period <%= period.periodLabel %></span>
                <div class="period-divider"></div>
                <span style="font-size: 0.8rem; color: var(--text-muted); white-space: nowrap;"><%= period.classes.length %> classes</span>
            </div>

            <table class="class-table mc">
                <thead>
                    <tr>
                        <th style="width: 22%;">Class</th>
                        <th style="width: 8%;">Side</th>
                        <th style="width: 9%;">Enrolled</th>
                        <th style="width: 16%;">Groups</th>
                        <th style="width: 13%;">Staff</th>
                        <th style="width: 10%;">Location</th>
                        <th>Counselors</th>
                    </tr>
                </thead>
                <tbody>
                    <% period.classes.forEach(function(cls) {
                        const searchTokens = [
                            cls.activityName,
                            cls.staff.map(function(s){ return s.FirstName + ' ' + s.LastName; }).join(' '),
                            cls.counselors.map(function(c){ return c.FirstName + ' ' + c.LastName; }).join(' '),
                            (cls.camperNames || []).join(' ')
                        ].join(' ').toLowerCase();
                    %>
                    <tr class="class-row mc-card"
                        data-side="<%= cls.sideOfCamp || '' %>"
                        data-groups="<%= cls.colorGroups.join(',') %>"
                        data-bus="<%= cls.busPresent ? 'yes' : '' %>"
                        data-extended="<%= (cls.extGroups || []).join(',') %>"
                        data-search="<%- searchTokens %>">

                        <td class="mc-title">
                            <a class="activity-link"
                               href="/class-roster/<%= period.periodNumber %>/<%= encodeURIComponent(cls.mergedNames ? cls.mergedNames[0] : cls.activityName) %>">
                                <%= cls.activityName %>
                            </a>
                        </td>

                        <td>
                            <% if (cls.sideOfCamp === 'Sports') { %>
                                <span class="side-pill side-sports">Sports</span>
                            <% } else if (cls.sideOfCamp === 'Enrichment') { %>
                                <span class="side-pill side-enrichment">Enrichment</span>
                            <% } else { %>
                                <span class="side-pill" style="background:#f1f5f9; color:#64748b;">—</span>
                            <% } %>
                        </td>

                        <td class="mc-hide">
                            <%
                                const pct = cls.maxCapacity ? cls.enrolled / cls.maxCapacity : 0;
                                let enrollClass = '';
                                if (pct >= 1) enrollClass = 'full';
                                else if (pct >= 0.85) enrollClass = 'near-full';
                            %>
                            <span class="enroll-badge <%= enrollClass %>">
                                <%= cls.enrolled %><% if (cls.maxCapacity) { %>/<%= cls.maxCapacity %><% } %>
                            </span>
                        </td>

                        <td class="mc-hide">
                            <div class="group-dots">
                                <% cls.colorGroups.forEach(function(color) { %>
                                    <span class="tag <%= color %>"><%= color %></span>
                                <% }); %>
                                <% if (cls.colorGroups.length === 0) { %>
                                    <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
                                <% } %>
                            </div>
                        </td>

                        <td>
                            <span class="mc-label">Staff</span>
                            <% if (cls.staff.length > 0) { %>
                                <% cls.staff.forEach(function(s) { %>
                                    <a href="/counselor-profile/<%= s.CounselorID %>" class="staff-link">
                                        <div class="staff-name-sched"><%= s.FirstName %> <%= s.LastName %></div>
                                        <div class="staff-type-label"><%= s.StaffType %></div>
                                    </a>
                                <% }); %>
                            <% } else { %>
                                <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
                            <% } %>
                        </td>

                        <td>
                            <span class="mc-label">Location</span>
                            <span class="location-text"><%= cls.location || '—' %></span>
                        </td>

                        <td>
                            <span class="mc-label">Counselors</span>
                            <div class="counselor-chips">
                                <% cls.counselors.forEach(function(c) { %>
                                    <a href="/counselor-profile/<%= c.CounselorID %>"
                                       class="counselor-chip <%= c.HomeGroupColor || 'no-group' %>"
                                       title="<%= c.covering ? ('Covering for ' + c.coveringForName) : '' %>">
                                        <%= c.FirstName %> <%= c.LastName %><%= c.covering ? ' ↔' : '' %>
                                    </a>
                                <% }); %>
                                <% if (cls.counselors.length === 0) { %>
                                    <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% }); %>
    </div>

    <script>
        function groupMatches(row, group) {
            if (group === 'all') return true;
            return (row.dataset.groups || '').split(',').includes(group);
        }

        function applyFilters() {
            const period = document.getElementById('periodFilter').value;
            const side   = document.getElementById('sideFilter').value;
            const group  = document.getElementById('groupFilter').value;
            const query  = document.getElementById('scheduleSearch').value.toLowerCase().trim();

            document.querySelectorAll('.period-section').forEach(section => {
                const periodMatch = period === 'all' || section.dataset.period === period;
                section.style.display = periodMatch ? '' : 'none';
            });

            document.querySelectorAll('.class-row').forEach(row => {
                const sideMatch   = side === 'all' || row.dataset.side === side;
                const searchMatch = !query || (row.dataset.search || '').includes(query);
                const visible = sideMatch && groupMatches(row, group) && searchMatch;
                row.classList.toggle('filter-hidden', !visible);
            });

            // Hide period headers with no visible rows
            document.querySelectorAll('.period-section').forEach(section => {
                if (section.style.display === 'none') return;
                const anyVisible = [...section.querySelectorAll('.class-row')].some(r => !r.classList.contains('filter-hidden'));
                section.style.display = anyVisible ? '' : 'none';
            });
        }
    </script>
</body>
</html>
