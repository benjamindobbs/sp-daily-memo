<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photo of the Day | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>
<body>
    <% if (viewMode === 'admin') { %>
    <nav class="nav-bar">
        <a href="/admin" class="nav-btn">&#127968; Hub</a>
        <a href="/photo-day" class="nav-btn primary">&#128247; Photo of the Day</a>
        <a href="/photo-gallery" class="nav-btn">&#127775; Gallery</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
    </nav>
    <% } else { %>
    <nav class="nav-bar">
        <a href="/staff" class="nav-btn">&#127968; Hub</a>
        <a href="/photo-day" class="nav-btn primary">&#128247; Submit Photo</a>
        <a href="/photo-gallery" class="nav-btn">&#127775; Gallery</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="admin">
            <button class="nav-btn" style="cursor:pointer;">&#128274; Admin View</button>
        </form>
    </nav>
    <% } %>

    <div class="container">
        <header style="margin-bottom:24px;">
            <h1>&#128247; Photo of the Day</h1>
            <p style="color:var(--text-muted); margin:0;">Submit a photo from today at camp.</p>
        </header>

        <% if (message) { %>
        <div style="background:#f0fdf4; border:1px solid #86efac; border-radius:8px; padding:12px 16px; margin-bottom:18px; color:#166534;">
            <%= message %>
        </div>
        <% } %>
        <% if (error) { %>
        <div style="background:#fef2f2; border:1px solid #fca5a5; border-radius:8px; padding:12px 16px; margin-bottom:18px; color:#991b1b;">
            <%= error %>
        </div>
        <% } %>

        <div class="card" style="max-width:520px; margin-bottom:32px;">
            <h3 style="margin:0 0 16px;">Submit a Photo</h3>
            <% if (!viewerName) { %>
            <div style="background:#fffbeb; border:1px solid #fcd34d; border-radius:8px; padding:12px 16px; margin-bottom:16px; color:#92400e; font-size:0.875rem;">
                <% if (viewMode === 'admin') { %>
                &#9888; Please set your name on the <a href="/admin" style="color:#92400e; font-weight:600;">admin hub</a> before submitting a photo.
                <% } else { %>
                &#9888; Please select your name in <a href="/counselor-preferences" style="color:#92400e; font-weight:600;">Preferences</a> before submitting a photo.
                <% } %>
            </div>
            <form style="opacity:0.5; pointer-events:none;">
                <div style="margin-bottom:14px;">
                    <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:6px;">Submitting as</label>
                    <div style="padding:8px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.9rem; background:#f8fafc; color:var(--text-muted);">—</div>
                </div>
                <div style="margin-bottom:18px;">
                    <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:6px;">Photo</label>
                    <input type="file" name="photo" accept="image/*" disabled style="font-size:0.9rem;">
                </div>
                <button type="button" disabled class="btn btn-primary">Upload Photo</button>
            </form>
            <% } else { %>
            <form action="/photo-day" method="POST" enctype="multipart/form-data">
                <div style="margin-bottom:14px;">
                    <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:6px;">Submitting as</label>
                    <div style="padding:8px 10px; border:1px solid var(--border-color); border-radius:6px; font-size:0.9rem; background:#f8fafc; font-weight:500;">
                        <%= viewerName %>
                    </div>
                </div>
                <div style="margin-bottom:18px;">
                    <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:6px;">Photo</label>
                    <input type="file" name="photo" accept="image/*" required style="font-size:0.9rem;">
                </div>
                <button type="submit" class="btn btn-primary">Upload Photo</button>
            </form>
            <% } %>
        </div>

        <% if (submissions.length > 0) { %>
        <h3>Today's Submissions</h3>
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; margin-top:14px;">
            <% submissions.forEach(s => { %>
            <div class="card" style="padding:12px;">
                <img src="<%= s.imageUrl %>" alt="Photo by <%= s.counselorName %>"
                     style="width:100%; border-radius:8px; object-fit:cover; aspect-ratio:4/3;">
                <p style="margin:8px 0 0; font-size:0.85rem; font-weight:600; color:var(--text-muted);"><%= s.counselorName %></p>
            </div>
            <% }); %>
        </div>
        <% } %>
    </div>
</body>
</html>
