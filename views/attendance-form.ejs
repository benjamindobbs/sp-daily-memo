<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> Attendance | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>
<body>
    <% if (viewMode === 'admin') { %>
    <nav class="nav-bar">
        <a href="<%= viewMode === 'admin' ? '/admin' : '/staff' %>" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128101; Staff Directory</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/attendance" class="nav-btn primary">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
        <a href="/case-log" class="nav-btn">&#128330;&#65039; Case Log</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
    </nav>
    <% } else { %>
    <nav class="nav-bar">
        <a href="/staff" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/attendance" class="nav-btn primary">&#128203; Attendance</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="admin">
            <button class="nav-btn" style="cursor:pointer;">&#128274; Admin View</button>
        </form>
    </nav>
    <% } %>

    <div class="container-sm">
        <div class="att-header">
            <a href="<%= backLink %>" class="back-link">&#8592; Attendance</a>
            <span class="pipe-sep">|</span>
            <div class="att-title">
                <h1><%= title %></h1>
                <p><%= date.slice(5).replace('-', '/') %><% if (typeof location !== 'undefined' && location) { %> &nbsp;·&nbsp; &#128205; <%= location %><% } %></p>
            </div>
        </div>

        <% if (typeof staffRows !== 'undefined' && (staffRows.length > 0 || counselorRows.length > 0)) { %>
        <div style="background:#f8fafc; border:1px solid var(--border-color); border-radius:10px; padding:12px 16px; margin-bottom:14px; font-size:0.875rem; display:flex; gap:24px; flex-wrap:wrap;">
            <% if (staffRows.length > 0) { %>
            <div><span style="font-weight:600; color:var(--text-muted);">Instructor<%= staffRows.length > 1 ? 's' : '' %>:</span>
                 <%= staffRows.map(s => s.FirstName + ' ' + s.LastName).join(', ') %></div>
            <% } %>
            <% if (counselorRows.length > 0) { %>
            <div><span style="font-weight:600; color:var(--text-muted);">Counselors:</span>
                 <%= counselorRows.map(c => c.FirstName + ' ' + c.LastName).join(', ') %></div>
            <% } %>
        </div>
        <% } %>

        <%/* ── Field Trip controls (SPLIT AM sheet) ── */%>
        <% if (typeof isSplitAM !== 'undefined' && isSplitAM) { %>
        <div style="display:flex; align-items:center; gap:12px; padding:12px 16px; border-radius:10px; margin-bottom:14px;
                    background:<%= fieldTripActive ? '#fef9c3' : '#f8fafc' %>; border:1px solid <%= fieldTripActive ? '#fde047' : 'var(--border-color)' %>;">
            <span style="font-size:1.2rem;">&#128652;</span>
            <span style="font-weight:600; font-size:0.9rem; flex:1;">
                <% if (fieldTripActive) { %>Field Trip — SPLIT group is away. Individual marking still allowed.<% } else { %>Mark SPLIT group as Field Trip for today<% } %>
            </span>
            <form action="/split-field-trip/<%= fieldTripActive ? 'clear' : 'mark' %>" method="POST" style="margin:0;">
                <input type="hidden" name="date" value="<%= date %>">
                <input type="hidden" name="returnTo" value="/attendance/specialty/SPLIT/am?date=<%= date %>">
                <button type="submit" class="btn btn-small" style="<%= fieldTripActive ? 'background:#fee2e2;color:#991b1b;border-color:#fca5a5;' : 'background:white;' %>">
                    <%- fieldTripActive ? 'Returned' : '&#128652; Mark Field Trip' %>
                </button>
            </form>
        </div>
        <% } %>

        <%/* ── Field Trip returned button (class sheets and SPLIT PM when trip is active) ── */%>
        <% if (typeof hasSplits !== 'undefined' && hasSplits && fieldTripActive) { %>
        <div style="display:flex; align-items:center; gap:12px; padding:12px 16px; border-radius:10px; margin-bottom:14px; background:#fef9c3; border:1px solid #fde047;">
            <span style="font-size:1.2rem;">&#128652;</span>
            <span style="font-weight:600; font-size:0.9rem; flex:1;">SPLIT group is on a Field Trip today — attendees shown below are read-only.</span>
            <form action="/split-field-trip/clear" method="POST" style="margin:0;">
                <input type="hidden" name="date" value="<%= date %>">
                <input type="hidden" name="returnTo" value="<%= backLink %>">
                <button type="submit" class="btn btn-small" style="background:#fee2e2;color:#991b1b;border-color:#fca5a5;">Returned</button>
            </form>
        </div>
        <% } %>
        <%/* ── SPLIT PM Returned button ── */%>
        <% if (typeof splitColor !== 'undefined' && splitColor === 'SPLIT' && sessionType === 'specialty_pm' && fieldTripActive) { %>
        <div style="display:flex; align-items:center; gap:12px; padding:12px 16px; border-radius:10px; margin-bottom:14px; background:#fef9c3; border:1px solid #fde047;">
            <span style="font-size:1.2rem;">&#128652;</span>
            <span style="font-weight:600; font-size:0.9rem; flex:1;">Field Trip — mark as Returned once the group is back.</span>
            <form action="/split-field-trip/clear" method="POST" style="margin:0;">
                <input type="hidden" name="date" value="<%= date %>">
                <input type="hidden" name="returnTo" value="/attendance/specialty/SPLIT/pm?date=<%= date %>">
                <button type="submit" class="btn btn-small" style="background:#fee2e2;color:#991b1b;border-color:#fca5a5;">Returned</button>
            </form>
        </div>
        <% } %>

        <div class="roster-card">
            <div class="roster-card-header">
                <div>
                    <strong id="presentCount">—</strong> present &nbsp;·&nbsp;
                    <strong id="absentCount">—</strong> absent &nbsp;·&nbsp;
                    <strong id="unmarkedCount">—</strong> unmarked
                    <span class="saving-indicator" id="savingIndicator">Saving…</span>
                </div>
                <input type="text" id="searchInput" class="search-bar" placeholder="Filter by name…" oninput="filterRows()">
            </div>

            <% if (roster.length === 0) { %>
                <div style="text-align:center; padding: 48px 20px; color: var(--text-muted);">No campers in this session.</div>
            <% } else { %>
                <div id="rosterList">
                <% roster.forEach(function(c) { %>
                <% if (c.isSplit) { %>
                    <div class="camper-row" data-camperid="<%= c.CamperID %>" data-name="<%= ((c.PreferredName||c.FirstName)+' '+c.LastName).toLowerCase() %>" data-status="split-readonly" data-split="true">
                        <span class="tag SPLIT" style="font-size:0.65rem; padding:1px 7px; flex-shrink:0;">SPLIT</span>
                        <span class="camper-name">
                            <% if (c.fieldTripActive) { %>&#128652; <% } %><%= c.PreferredName || c.FirstName %> <%= c.LastName %>
                        </span>
                        <div class="camper-badges">
                            <span style="font-size:0.72rem; color:var(--text-muted); font-style:italic;">via Specialty AM</span>
                        </div>
                        <div class="toggle-wrap">
                            <% if (c.currentStatus === 'present' || c.currentStatus === 'late') { %>
                                <span style="font-size:0.8rem; font-weight:600; color:#16a34a; padding:4px 10px;">&#10003; Present</span>
                            <% } else if (c.currentStatus === 'absent') { %>
                                <span style="font-size:0.8rem; font-weight:600; color:#dc2626; padding:4px 10px;">&#10007; Absent</span>
                            <% } else { %>
                                <span style="font-size:0.8rem; color:var(--text-muted); padding:4px 10px;">Not checked in</span>
                            <% } %>
                        </div>
                    </div>
                <% } else { %>
                    <div class="camper-row" data-camperid="<%= c.CamperID %>" data-name="<%= ((c.PreferredName||c.FirstName)+' '+c.LastName).toLowerCase() %>" data-status="<%= c.currentStatus || '' %>">
                        <span class="tag <%= c.HomeGroupColor %>" style="font-size:0.65rem; padding:1px 7px; flex-shrink:0;"><%= c.HomeGroupColor %></span>
                        <span class="camper-name"><%= c.PreferredName || c.FirstName %> <%= c.LastName %></span>
                        <% if (c.BusRoute && (((sessionType === 'homegroup_am' || sessionType === 'specialty_am') && c.BusRidesAM) || ((sessionType === 'homegroup_pm' || sessionType === 'specialty_pm') && c.BusRidesPM))) { %>
                        <% const busDisplay = String(parseFloat(c.BusRoute) % 1 === 0 ? Math.trunc(parseFloat(c.BusRoute)) : c.BusRoute); %>
                        <span style="font-size:0.7rem; font-weight:600; background:#dbeafe; color:#1e40af; border-radius:4px; padding:1px 7px; white-space:nowrap;">&#128652; Bus <%= busDisplay %></span>
                        <% } %>
                        <% if (c.ExtendedHours && (((sessionType === 'homegroup_am' || sessionType === 'specialty_am') && (c.ExtendedHours === 'AM' || c.ExtendedHours === 'Both')) || ((sessionType === 'homegroup_pm' || sessionType === 'specialty_pm') && (c.ExtendedHours === 'PM' || c.ExtendedHours === 'Both')))) { %>
                        <span style="font-size:0.7rem; font-weight:600; background:#fef3c7; color:#92400e; border-radius:4px; padding:1px 7px; white-space:nowrap;">&#9200; Extended</span>
                        <% } %>
                        <div class="camper-badges">
                            <% if (c.campLunch === 'Yes') { %><span class="badge-lunch-camp">&#127857; Camp Lunch</span><% } else if (c.campLunch === 'Allergy') { %><span class="badge-lunch-allergy">&#9888; Allergy Meal</span><% } %>
                            <% if (c.shirtQty) { %>
                                <% if (c.shirtsReceived) { %>
                                <button type="button" class="badge-shirt-received" onclick="toggleShirtInfo(this)"
                                        data-size="<%= c.ShirtSize || 'Unknown size' %>" data-qty="<%= c.shirtQty %>" data-showing="false">
                                    &#128085; Shirts Received
                                </button>
                                <% } else { %>
                                <span class="badge-shirt-size">&#128085; <%= c.ShirtSize || 'Unknown size' %></span>
                                <span class="badge-shirt-qty">&times;<%= c.shirtQty %></span>
                                <% } %>
                            <% } %>
                            <% if (c.nurseAM) { %><span class="badge-absent-am" style="background:#fee2e2;color:#991b1b;">&#128137; In Nurse</span><% } else if (c.absentAM) { %><span class="badge-absent-am">&#9888; Absent AM</span><% } %>
                            <% if (c.caseLog) { %><span class="badge-absent-am" style="background:#ede9fe;color:#5b21b6;">&#128330;&#65039; With No&#235;l</span><% } %>
                            <% if (c.absentBusAM) { %><span class="badge-absent-bus">&#128652; Absent Bus AM</span><% } %>
                            <% if (c.dismissed) { %><span class="badge-dismissed">&#128663; Dismissed</span><% } %>
                            <% if (c.seenEarlier) { %><span class="badge-seen-earlier">&#10003; Seen Earlier</span><% } %>
                            <% if (c.scheduledPickup) { %>
                                <button class="badge-pickup"
                                    onclick="openPickup(<%- JSON.stringify(fmtPickupTime(c.scheduledPickup.pickupTime)) %>,<%- JSON.stringify(c.scheduledPickup.notes || '') %>,'<%= c.PreferredName || c.FirstName %> <%= c.LastName %>',<%- JSON.stringify(c.scheduledPickup.periodNumber || null) %>,<%- JSON.stringify(c.scheduledPickup.activityName || null) %>)"
                                    style="background:#fef3c7;color:#92400e;border:1px solid #fcd34d;border-radius:4px;padding:1px 7px;font-size:0.72rem;font-weight:600;cursor:pointer;font-family:inherit;">
                                    &#128663; Pickup <%= fmtPickupTime(c.scheduledPickup.pickupTime) %><% if (c.scheduledPickup.periodNumber) { %> &middot; P<%= c.scheduledPickup.periodNumber %><% } %>
                                </button>
                            <% } %>
                        </div>
                        <div class="toggle-wrap">
                            <button class="btn-present <%= (c.currentStatus === 'present' || c.currentStatus === 'late') ? 'active' : '' %>"
                                    onclick="mark(<%= c.CamperID %>, this, 'present')">Present</button>
                            <button class="btn-absent <%= (c.currentStatus === 'absent' || c.currentStatus === 'nurse') ? 'active' : '' %>"
                                    onclick="mark(<%= c.CamperID %>, this, 'absent')">Absent</button>
                            <% if (!c.dismissed) { %>
                                <button class="btn-dismiss" onclick="openDismiss(<%= c.CamperID %>, '<%= c.PreferredName || c.FirstName %> <%= c.LastName %>')">Dismiss</button>
                            <% } %>
                        </div>
                    </div>
                <% } %>
                <% }); %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Scheduled Pickup Info Modal -->
    <div class="dismiss-modal" id="pickupModal">
        <div class="dismiss-box">
            <h3>&#128663; Scheduled Pickup</h3>
            <p id="pickupModalName" style="margin:0 0 12px; font-weight:600;"></p>
            <p style="margin:0 0 6px;"><span style="color:var(--text-muted); font-size:0.85rem;">Pickup Time</span><br><strong id="pickupModalTime"></strong></p>
            <p id="pickupModalPeriodRow" style="margin:8px 0 0; display:none;"><span style="color:var(--text-muted); font-size:0.85rem;">During</span><br><span id="pickupModalPeriod"></span></p>
            <p style="margin:8px 0 0;"><span style="color:var(--text-muted); font-size:0.85rem;">Notes</span><br><span id="pickupModalNotes"></span></p>
            <div class="dismiss-actions" style="margin-top:18px;">
                <button type="button" class="btn-cancel" onclick="closePickup()">Close</button>
                <% if (viewMode === 'admin') { %>
                <a href="/dismissals" class="btn-dismiss-confirm" style="text-decoration:none; text-align:center;">Edit Pickup</a>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Early Dismissal Modal -->
    <div class="dismiss-modal" id="dismissModal">
        <div class="dismiss-box">
            <h3>Early Dismissal</h3>
            <p id="dismissName" style="margin:0 0 14px; font-weight:600;"></p>
            <form action="/attendance/early-dismissal" method="POST">
                <input type="hidden" name="date" value="<%= date %>">
                <input type="hidden" name="camperId" id="dismissCamperId">
                <input type="hidden" name="returnTo" value="<%= selfLink %>?date=<%= date %><%= (typeof half !== 'undefined' && half) ? '&half=' + half : '' %>">
                <div class="dismiss-field">
                    <label>Dismissal Time</label>
                    <input type="time" name="dismissalTime">
                </div>
                <div class="dismiss-field" style="margin-bottom:18px;">
                    <label>Notes (optional)</label>
                    <input type="text" name="notes" placeholder="e.g. parent picked up">
                </div>
                <div class="dismiss-actions">
                    <button type="button" class="btn-cancel" onclick="closeDismiss()">Cancel</button>
                    <button type="submit" class="btn-dismiss-confirm">Confirm Dismissal</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const SESSION_TYPE  = '<%= sessionType %>';
        const PERIOD_NUMBER = <%= periodNumber %>;
        const ACTIVITY_NAME = '<%= activityName.replace(/'/g, "\\'") %>';
        const DATE = '<%= date %>';

        function updateCounts() {
            let present = 0, absent = 0, unmarked = 0;
            document.querySelectorAll('.camper-row').forEach(r => {
                if (r.style.display === 'none') return;
                if (r.dataset.split === 'true') return; // SPLIT rows are read-only, not counted
                const s = r.dataset.status;
                if (s === 'absent') absent++;
                else if (s === 'present' || s === 'late') present++;
                else unmarked++;
            });
            document.getElementById('presentCount').textContent = present;
            document.getElementById('absentCount').textContent  = absent;
            document.getElementById('unmarkedCount').textContent = unmarked;
        }

        function mark(camperId, btn, newStatus) {
            const row = btn.closest('.camper-row');
            const indicator = document.getElementById('savingIndicator');

            // Optimistic UI update
            row.dataset.status = newStatus;
            row.querySelectorAll('.btn-present').forEach(b => b.classList.toggle('active', newStatus === 'present'));
            row.querySelectorAll('.btn-absent').forEach(b  => b.classList.toggle('active', newStatus === 'absent'));
            updateCounts();

            // Show saving indicator
            indicator.textContent = 'Saving…';
            indicator.classList.add('show');

            fetch('/attendance/mark', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    date: DATE, camperId, sessionType: SESSION_TYPE,
                    periodNumber: PERIOD_NUMBER, activityName: ACTIVITY_NAME,
                    status: newStatus
                })
            })
            .then(r => r.json())
            .then(data => {
                indicator.textContent = data.ok ? 'Saved' : 'Error';
                setTimeout(() => indicator.classList.remove('show'), 1200);
            })
            .catch(() => {
                indicator.textContent = 'Error — check connection';
            });
        }

        function filterRows() {
            const term = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('.camper-row').forEach(row => {
                row.style.display = row.dataset.name.includes(term) ? '' : 'none';
            });
            updateCounts();
        }

        function toggleShirtInfo(btn) {
            const showing = btn.dataset.showing === 'true';
            if (showing) {
                btn.innerHTML = '&#128085; Shirts Received';
                btn.dataset.showing = 'false';
            } else {
                btn.textContent = '\u{1F455} ' + btn.dataset.size + ' ×' + btn.dataset.qty;
                btn.dataset.showing = 'true';
            }
        }

        function openDismiss(camperId, name) {
            document.getElementById('dismissCamperId').value = camperId;
            document.getElementById('dismissName').textContent = name;
            document.getElementById('dismissModal').classList.add('open');
        }
        function closeDismiss() {
            document.getElementById('dismissModal').classList.remove('open');
        }
        document.getElementById('dismissModal').addEventListener('click', function(e) {
            if (e.target === this) closeDismiss();
        });

        function openPickup(time, notes, name, period, className) {
            document.getElementById('pickupModalName').textContent = name;
            document.getElementById('pickupModalTime').textContent = time;
            document.getElementById('pickupModalNotes').textContent = notes || '—';
            const periodRow = document.getElementById('pickupModalPeriodRow');
            if (period) {
                document.getElementById('pickupModalPeriod').textContent = 'Period ' + period + (className ? ' · ' + className : '');
                periodRow.style.display = '';
            } else {
                periodRow.style.display = 'none';
            }
            document.getElementById('pickupModal').classList.add('open');
        }
        function closePickup() {
            document.getElementById('pickupModal').classList.remove('open');
        }
        document.getElementById('pickupModal').addEventListener('click', function(e) {
            if (e.target === this) closePickup();
        });

        updateCounts();
    </script>
</body>
</html>
