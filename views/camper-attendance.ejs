<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Camper Attendance History | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
    <style>
        /* Autocomplete (same as nurse) */
        .camper-autocomplete { position: relative; min-width: 260px; flex: 1; max-width: 380px; }
        .camper-autocomplete input {
            width: 100%; padding: 9px 12px; border: 1px solid var(--border-color);
            border-radius: 8px; font-size: 0.9rem; font-family: inherit; box-sizing: border-box;
        }
        .camper-autocomplete input:focus { outline: none; border-color: var(--primary); }
        .ac-dropdown {
            position: absolute; top: calc(100% + 4px); left: 0; right: 0;
            background: white; border: 1px solid var(--border-color); border-radius: 8px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.08); z-index: 50;
            max-height: 240px; overflow-y: auto; display: none;
        }
        .ac-option { padding: 8px 14px; cursor: pointer; font-size: 0.88rem; display: flex; align-items: center; gap: 8px; }
        .ac-option:hover, .ac-option.active { background: #f1f5f9; }
        .ac-option .ac-color { font-size: 0.7rem; font-weight: 700; padding: 1px 6px; border-radius: 999px; background: #e2e8f0; color: #475569; flex-shrink: 0; }
        .ac-empty { padding: 10px 14px; font-size: 0.85rem; color: var(--text-muted); }

        /* Calendar grid */
        .week-section { margin-bottom: 20px; }
        .week-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 8px; flex-wrap: wrap; gap: 8px;
        }
        .week-title { font-size: 0.82rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .week-counts { display: flex; gap: 12px; font-size: 0.8rem; font-weight: 600; }
        .week-counts .cnt-present { color: #166534; }
        .week-counts .cnt-absent  { color: #991b1b; }

        .cal-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
        }
        .cal-cell {
            display: flex; flex-direction: column; align-items: center;
            gap: 5px; padding: 10px 6px;
            background: white; border: 1px solid var(--border-color);
            border-radius: 10px;
        }
        .cal-dow { font-size: 0.68rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .cal-date { font-size: 0.75rem; color: var(--text-muted); }
        .cal-dot {
            width: 36px; height: 36px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.65rem; font-weight: 700;
        }
        .cal-dot.green  { background: #dcfce7; color: #166534; border: 2px solid #86efac; }
        .cal-dot.red    { background: #fee2e2; color: #991b1b; border: 2px solid #fca5a5; }
        .cal-dot.yellow { background: #fef3c7; color: #92400e; border: 2px solid #fcd34d; }
        .cal-dot.none   { background: #f8fafc; color: #cbd5e1; border: 2px dashed #e2e8f0; }

        /* Legend */
        .legend { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
        .legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; color: var(--text-muted); }
        .legend-dot { width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0; }
        .legend-dot.green  { background: #86efac; border: 2px solid #86efac; }
        .legend-dot.red    { background: #fca5a5; border: 2px solid #fca5a5; }
        .legend-dot.yellow { background: #fcd34d; border: 2px solid #fcd34d; }
        .legend-dot.none   { background: #f8fafc; border: 2px dashed #e2e8f0; }

        /* Week filter chips */
        .week-chips { display: flex; gap: 6px; flex-wrap: wrap; }
        .week-chip { display: flex; align-items: center; gap: 4px; font-size: 0.82rem; }
        .week-chip input { margin: 0; }

        @media (max-width: 480px) {
            .cal-dot { width: 28px; height: 28px; font-size: 0.6rem; }
            .cal-cell { padding: 7px 3px; }
        }
    </style>
</head>
<body>
    <nav class="nav-bar">
        <a href="/admin" class="nav-btn primary">&#127968; Hub</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
    </nav>

    <div class="container">
        <header class="header-flex" style="margin-bottom:20px;">
            <div>
                <h1>&#128203; Camper Attendance History</h1>
                <p class="text-muted">View a camper's attendance across all weeks of the summer.</p>
            </div>
        </header>

        <%/* ── Search form ── */%>
        <div class="card" style="margin-bottom:20px;">
            <form method="GET" action="/camper-attendance" id="attForm">
                <div style="display:flex; gap:12px; align-items:flex-start; flex-wrap:wrap; margin-bottom:14px;">
                    <div class="camper-autocomplete" id="acWrap">
                        <input type="text" id="camperSearchAC" placeholder="Search camper…" autocomplete="off"
                               value="<%= camper ? (camper.LastName + ', ' + (camper.PreferredName || camper.FirstName)) : '' %>">
                        <input type="hidden" name="camperId" id="camperIdHidden" value="<%= camperId || '' %>">
                        <div class="ac-dropdown" id="acDropdown"></div>
                    </div>
                    <button type="submit" class="btn btn-primary" style="padding:9px 20px; white-space:nowrap;">View History</button>
                </div>
                <div style="margin-top:2px;">
                    <div style="font-size:0.78rem; font-weight:600; color:var(--text-muted); margin-bottom:6px;">Show weeks:</div>
                    <div class="week-chips">
                        <% sessions.forEach(function(s) { %>
                        <label class="week-chip">
                            <input type="checkbox" name="weeks" value="<%= s.weekNumber %>"
                                   <%= selectedWeeks.includes(s.weekNumber) ? 'checked' : '' %>>
                            <span><%= s.label || ('Week ' + s.weekNumber) %></span>
                        </label>
                        <% }); %>
                    </div>
                </div>
            </form>
        </div>

        <% if (camper) { %>

        <%/* ── Camper banner ── */%>
        <div style="margin-bottom:16px; display:flex; align-items:center; gap:10px;">
            <h2 style="margin:0; font-size:1.2rem;">
                <%= camper.PreferredName || camper.FirstName %> <%= camper.LastName %>
            </h2>
        </div>

        <%/* ── Legend ── */%>
        <div class="legend">
            <div class="legend-item"><div class="legend-dot green"></div> Present (at least one class)</div>
            <div class="legend-item"><div class="legend-dot red"></div> Absent (all day)</div>
            <div class="legend-item"><div class="legend-dot yellow"></div> Late arrival or early dismissal</div>
            <div class="legend-item"><div class="legend-dot none"></div> No data</div>
        </div>

        <% if (weekData.length === 0) { %>
        <div class="card" style="color:var(--text-muted);">No attendance data found for the selected weeks.</div>
        <% } %>

        <% weekData.forEach(function(week) { %>
        <div class="card week-section">
            <div class="week-header">
                <div class="week-title"><%= week.label || ('Week ' + week.weekNumber) %></div>
                <div class="week-counts">
                    <span class="cnt-present">&#10003; Present: <%= week.presentCount %></span>
                    <span class="cnt-absent">&#10007; Absent: <%= week.absentCount %></span>
                </div>
            </div>
            <div class="cal-grid">
                <% week.days.forEach(function(day) { %>
                <div class="cal-cell">
                    <div class="cal-dow"><%= day.dow %></div>
                    <div class="cal-dot <%= day.status %>">
                        <% if (day.status === 'green') { %>&#10003;
                        <% } else if (day.status === 'red') { %>&#10007;
                        <% } else if (day.status === 'yellow') { %>!
                        <% } else { %>&ndash;<% } %>
                    </div>
                    <div class="cal-date"><%= day.label %></div>
                </div>
                <% }); %>
            </div>
        </div>
        <% }); %>

        <% } else if (typeof camperId !== 'undefined' && camperId) { %>
        <div class="card" style="color:var(--text-muted);">Camper not found.</div>
        <% } %>
    </div>

    <script>
        // Week checkboxes: if none checked, check all on submit to avoid empty weeks param
        document.getElementById('attForm').addEventListener('submit', function(e) {
            const boxes = this.querySelectorAll('input[name="weeks"]');
            const anyChecked = Array.from(boxes).some(b => b.checked);
            if (!anyChecked) boxes.forEach(b => b.checked = true);
        });

        // Autocomplete
        const AC_CAMPERS = <%- JSON.stringify(campers.map(c => ({
            id: c.CamperID,
            label: c.LastName + ', ' + (c.PreferredName || c.FirstName)
        }))) %>;

        const acInput    = document.getElementById('camperSearchAC');
        const acDropdown = document.getElementById('acDropdown');
        const acHidden   = document.getElementById('camperIdHidden');
        let acActiveIdx  = -1;

        function renderAC(term) {
            const q = term.trim().toLowerCase();
            acDropdown.innerHTML = '';
            acActiveIdx = -1;
            if (!q) { acDropdown.style.display = 'none'; return; }
            const matches = AC_CAMPERS.filter(c => c.label.toLowerCase().includes(q)).slice(0, 40);
            if (!matches.length) {
                acDropdown.innerHTML = '<div class="ac-empty">No campers found</div>';
            } else {
                matches.forEach((c, i) => {
                    const div = document.createElement('div');
                    div.className = 'ac-option';
                    div.dataset.id = c.id;
                    div.textContent = c.label;
                    div.addEventListener('mousedown', e => { e.preventDefault(); selectCamper(c); });
                    acDropdown.appendChild(div);
                });
            }
            acDropdown.style.display = 'block';
        }

        function selectCamper(c) {
            acInput.value  = c.label;
            acHidden.value = c.id;
            acDropdown.style.display = 'none';
        }

        acInput.addEventListener('input', () => { acHidden.value = ''; renderAC(acInput.value); });
        acInput.addEventListener('keydown', e => {
            const opts = acDropdown.querySelectorAll('.ac-option');
            if (!opts.length) return;
            if (e.key === 'ArrowDown') {
                acActiveIdx = Math.min(acActiveIdx + 1, opts.length - 1);
            } else if (e.key === 'ArrowUp') {
                acActiveIdx = Math.max(acActiveIdx - 1, -1);
            } else if (e.key === 'Enter' && acActiveIdx >= 0) {
                e.preventDefault();
                const sel = AC_CAMPERS.filter(c => c.label.toLowerCase().includes(acInput.value.trim().toLowerCase())).slice(0, 40)[acActiveIdx];
                if (sel) selectCamper(sel);
                return;
            } else if (e.key === 'Escape') {
                acDropdown.style.display = 'none'; return;
            }
            opts.forEach((o, i) => o.classList.toggle('active', i === acActiveIdx));
        });
        document.addEventListener('click', e => {
            if (!document.getElementById('acWrap').contains(e.target))
                acDropdown.style.display = 'none';
        });
    </script>
</body>
</html>
