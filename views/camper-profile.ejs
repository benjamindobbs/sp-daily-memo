<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= camper.FirstName %> <%= camper.LastName %> | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>
<body>
    <% if (viewMode === 'admin') { %>
    <nav class="nav-bar">
        <a href="<%= viewMode === 'admin' ? '/admin' : '/staff' %>" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn primary">&#128269; Camper Lookup</a>
        <a href="/counselor-directory" class="nav-btn">&#128101; Staff Directory</a>
        <a href="/swap-tool" class="nav-btn">&#128260; Swap Tools</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="staff">
            <button class="nav-btn" style="cursor:pointer;">Staff View</button>
        </form>
    </nav>
    <% } else { %>
    <nav class="nav-bar">
        <a href="/staff" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn primary">&#128269; Camper Lookup</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <form action="/choose-view" method="POST" style="margin-left:auto;">
            <input type="hidden" name="view" value="admin">
            <button class="nav-btn" style="cursor:pointer;">&#128274; Admin View</button>
        </form>
    </nav>
    <% } %>

    <div class="container-md">

        <div class="page-header">
            <a href="/search" class="back-link">&#8592; Camper Lookup</a>
            <span class="pipe-sep">|</span>
            <div>
                <h1 style="margin:0;"><%= camper.FirstName %> <%= camper.LastName %></h1>
                <p class="text-muted" style="margin:2px 0 0;">
                    Grade <%= camper.Grade || '—' %> &nbsp;·&nbsp;
                    <span class="tag <%= camper.HomeGroupColor %>"><%= camper.HomeGroupColor %></span>
                </p>
            </div>
        </div>

        <% if (alertMessage) { %>
            <div class="alert" style="<%= alertMessage === 'Saved' ? '' : 'background:#fee2e2; color:#991b1b; border-color:#fca5a5;' %>">
                <% if (alertMessage === 'Saved') { %>&#10003; Changes saved successfully.<% } else { %><%= alertMessage %><% } %>
            </div>
        <% } %>

        <div class="roster-layout">

            <!-- Left column: editable info (admin only) -->
            <% if (viewMode === 'admin') { %>
            <div>
                <div class="card">
                    <h3 style="margin:0 0 20px;">Camper Details</h3>
                    <form action="/camper/<%= camper.CamperID %>/update" method="POST">

                        <div class="info-row">
                            <span class="info-label">Home Counselor</span>
                        </div>
                        <div style=”margin-bottom: 16px;”>
                            <select name=”homeGroupCounselorID” style=”width:100%; padding:9px 12px; border:1px solid var(--border-color); border-radius:8px; font-family:inherit; font-size:0.9rem; background:white; box-sizing:border-box;”>
                                <option value=””>— Unassigned —</option>
                                <% ['Red','Carolina','Green','Navy'].forEach(function(grp) {
                                   const gc = counselors.filter(c => c.HomeGroupColor === grp);
                                   if (!gc.length) return; %>
                                <optgroup label=”<%= grp %>”>
                                    <% gc.forEach(function(c) { %>
                                    <option value=”<%= c.CounselorID %>”
                                        <%= camper.ResolvedCounselorID === c.CounselorID ? 'selected' : '' %>>
                                        <%= c.FirstName %> <%= c.LastName %>
                                    </option>
                                    <% }); %>
                                </optgroup>
                                <% }); %>
                            </select>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Bus Route</span>
                        </div>
                        <div style="margin-bottom: 16px;">
                            <input type="text" name="busRoute" value="<%= (camper.BusRoute && camper.BusRoute.toLowerCase() !== 'null') ? camper.BusRoute : '' %>"
                                placeholder="e.g. Route 12"
                                style="width:100%; padding:9px 12px; border:1px solid var(--border-color); border-radius:8px; font-family:inherit; font-size:0.9rem; box-sizing:border-box;">
                        </div>

                        <div class="info-row">
                            <span class="info-label">Extended Hours</span>
                        </div>
                        <div style="margin-bottom: 16px;">
                            <select name="extendedHours" style="width:100%; padding:9px 12px; border:1px solid var(--border-color); border-radius:8px; font-family:inherit; font-size:0.9rem; background:white;">
                                <option value="" <%= (!camper.ExtendedHours || camper.ExtendedHours.toLowerCase() === 'null') ? 'selected' : '' %>>No</option>
                                <option value="AM"   <%= camper.ExtendedHours === 'AM'   ? 'selected' : '' %>>AM Only</option>
                                <option value="PM"   <%= camper.ExtendedHours === 'PM'   ? 'selected' : '' %>>PM Only</option>
                                <option value="Both" <%= camper.ExtendedHours === 'Both' ? 'selected' : '' %>>AM + PM (Both)</option>
                            </select>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Camp Lunch</span>
                        </div>
                        <div style="margin-bottom: 24px;">
                            <select name="campLunch" style="width:100%; padding:9px 12px; border:1px solid var(--border-color); border-radius:8px; font-family:inherit; font-size:0.9rem; background:white;">
                                <option value="No"      <%= camper.CampLunch === 'No'      ? 'selected' : '' %>>No (Packed)</option>
                                <option value="Yes"     <%= camper.CampLunch === 'Yes'     ? 'selected' : '' %>>Yes</option>
                                <option value="Allergy" <%= camper.CampLunch === 'Allergy' ? 'selected' : '' %>>Allergy Meal</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary" style="width:100%;">Save Changes</button>
                    </form>

                    <hr style="margin:20px 0; border:none; border-top:1px solid var(--border-color);">

                    <form action="/camper/<%= camper.CamperID %>/delete" method="POST"
                          onsubmit="return confirm('Permanently remove <%= camper.FirstName %> <%= camper.LastName %> from the roster? This cannot be undone.')">
                        <button type="submit" class="btn" style="width:100%; background:#fee2e2; color:#991b1b; border-color:#fca5a5;">
                            Remove Camper
                        </button>
                    </form>
                </div>
            </div>
            <% } else { %>
            <!-- Left column: read-only details (staff view) -->
            <div>
                <div class="card">
                    <h3 style="margin:0 0 20px;">Camper Details</h3>

                    <div class="info-row">
                        <span class="info-label">Home Counselor</span>
                        <span class="info-value">
                            <% if (camper.HomeCounselorName) { %>
                                &#128100; <%= camper.HomeCounselorName %>
                            <% } else { %>
                                <span class="text-muted" style="font-style:italic;">Unassigned</span>
                            <% } %>
                        </span>
                    </div>

                    <div class="info-row" style="margin-top:12px;">
                        <span class="info-label">Bus Route</span>
                        <span class="info-value">
                            <% var _br = camper.BusRoute; %>
                            <% if (_br && _br.toLowerCase() !== 'null') { %>
                                &#128652; <%= _br %>
                            <% } else { %>
                                <span class="text-muted">Parent Pickup</span>
                            <% } %>
                        </span>
                    </div>

                    <div class="info-row" style="margin-top:12px;">
                        <span class="info-label">Extended Hours</span>
                        <span class="info-value">
                            <% if (camper.ExtendedHours && camper.ExtendedHours.toLowerCase() !== 'null') { %>
                                &#9200; <%= camper.ExtendedHours %>
                            <% } else { %>
                                <span class="text-muted">No</span>
                            <% } %>
                        </span>
                    </div>

                    <div class="info-row" style="margin-top:12px;">
                        <span class="info-label">Camp Lunch</span>
                        <span class="info-value">
                            <% if (camper.CampLunch === 'Yes') { %>
                                &#127857; Yes
                            <% } else if (camper.CampLunch === 'Allergy') { %>
                                <span style="color:#b45309; font-weight:600;">&#9888; Allergy Meal</span>
                            <% } else { %>
                                <span class="text-muted">No (Packed)</span>
                            <% } %>
                        </span>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Right column: schedule -->
            <div>
                <div class="roster-card">
                    <div class="roster-card-header">
                        <h3>Daily Schedule</h3>
                    </div>

                    <% if (schedule.length === 0) { %>
                        <div style="text-align:center; padding:48px 20px; color:var(--text-muted);">
                            No schedule assigned.
                        </div>
                    <% } else { %>
                        <% schedule.forEach(function(s, idx) { %>
                            <div style="display:flex; align-items:center; gap:14px; padding:14px 20px; border-bottom:1px solid #f1f5f9; flex-wrap:wrap;">
                                <span class="period-badge" style="font-size:0.75rem; padding:4px 12px; white-space:nowrap;">
                                    Period <%= idx + 1 %>
                                </span>
                                <div style="flex:1; min-width:120px;">
                                    <div style="font-weight:600; font-size:0.92rem;"><%= s.ActivityName %></div>
                                    <% if (s.Location) { %>
                                        <div class="text-muted" style="font-size:0.78rem;">&#128205; <%= s.Location %></div>
                                    <% } %>
                                </div>
                                <% if (s.SideOfCamp) { %>
                                    <span class="side-pill <%= s.SideOfCamp === 'Sports' ? 'side-sports' : 'side-enrichment' %>">
                                        <%= s.SideOfCamp %>
                                    </span>
                                <% } %>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <% if (viewMode === 'admin') { %>
                <div class="card" style="margin-top:20px;">
                    <h4 style="margin:0 0 10px; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted);">Swap Schedule</h4>
                    <a href="/swap-tool?name=<%= encodeURIComponent(camper.FirstName + ' ' + camper.LastName) %>"
                       class="btn btn-primary" style="display:block; text-align:center;">
                        &#128260; Open Swap Tool
                    </a>
                </div>
                <% } %>
            </div>

        </div>
    </div>
</body>
</html>
