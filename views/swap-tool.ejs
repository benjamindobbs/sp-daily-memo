<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schedule Swap | Camp Hub</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/nav.js" defer></script>
</head>
<body>

    <nav class="nav-bar">
        <a href="<%= viewMode === 'admin' ? '/admin' : '/staff' %>" class="nav-btn">&#127968; Hub</a>
        <a href="/master-schedule" class="nav-btn">&#128197; Master Schedule</a>
        <a href="/search" class="nav-btn">&#128269; Camper Lookup</a>
        <a href="/swap-tool" class="nav-btn primary">&#128260; Swap Tools</a>
        <a href="/schedule-history" class="nav-btn">&#128203; Change History</a>
        <a href="/attendance" class="nav-btn">&#128203; Attendance</a>
        <a href="/dismissals" class="nav-btn">&#128663; Dismissals</a>
        <a href="/nurse" class="nav-btn">&#128137; Nurse</a>
    </nav>

    <div class="container">
        <header style="margin-bottom: 30px;">
            <h1>Camper Schedule Swapper</h1>
            <form action="/swap-tool" method="GET" class="search-bar-container" style="margin-top: 15px; position: relative;" id="swapSearchForm">
                <div class="camper-autocomplete" style="flex: 1;">
                    <input type="text" name="name" id="camperSearchAC" placeholder="Search Camper Name..."
                           value="<%= camper ? (camper.LastName + ', ' + (camper.PreferredName || camper.FirstName)) : (query || '') %>"
                           class="search-input" autocomplete="off">
                    <input type="hidden" name="camperId" id="camperIdHidden" value="<%= camper ? camper.CamperID : '' %>">
                    <div class="ac-dropdown" id="acDropdown"></div>
                </div>
                <button type="submit" class="btn btn-primary">Find Camper</button>
            </form>
        </header>

        <% if (camper) { %>
            <div class="swap-grid">
                <div class="sidebar">
                    <div class="card" style="margin-bottom: 20px;">
                        <span class="tag <%= camper.HomeGroupColor %>"><%= camper.HomeGroupColor %> Group</span>
                        <h2 style="margin: 10px 0 5px 0; display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                            <%= camper.FirstName %> <%= camper.LastName %>
                            <span style="font-size:0.75rem; font-weight:700; background:<%= swapCount >= 3 ? '#fef3c7' : '#f1f5f9' %>; color:<%= swapCount >= 3 ? '#92400e' : 'var(--text-muted)' %>; border:1px solid <%= swapCount >= 3 ? '#fcd34d' : 'var(--border-color)' %>; border-radius:20px; padding:2px 10px; white-space:nowrap;">
                                <%= swapCount %> swap<%= swapCount === 1 ? '' : 's' %> this week
                            </span>
                        </h2>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">Select a period to find a replacement activity.</p>
                    </div>

                    <% currentSchedule.forEach(p => { %>
                        <div class="card period-card" id="period-<%= p.PeriodNumber %>"
                             onclick="loadOptions('<%= camper.CamperID %>', '<%= p.PeriodNumber %>', this)">
                            <div>
                                <small style="text-transform: uppercase; color: var(--text-muted); font-weight: bold;">Period <%= p.PeriodNumber %></small>
                                <div style="font-weight: 600;" data-activity="<%= p.ActivityName %>"><%= p.ActivityName %></div>
                            </div>
                            <span style="color: var(--primary);">&#8594;</span>
                        </div>
                    <% }) %>
                </div>

                <div class="main-content">
                    <div id="controls-container" style="display: none;">
                        <div class="card" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                            <div id="side-indicator" style="font-weight: bold; color: var(--primary);"></div>
                            <input type="text" id="activitySearch" placeholder="Filter activities..."
                                   onkeyup="filterActivities()" class="search-bar" style="max-width: 250px;">
                        </div>
                        <div id="options-container"></div>
                    </div>
                    
                    <div id="placeholder-msg" class="card" style="text-align: center; padding: 100px; color: var(--text-muted);">
                        <span style="font-size: 3rem;">&#128072;</span>
                        <p>Select a period on the left to see available swaps.</p>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <script src="/js/camper-ac.js"></script>
    <script>
        initCamperAC({
            input:    'camperSearchAC',
            dropdown: 'acDropdown',
            hidden:   'camperIdHidden',
            campers:  <%- JSON.stringify(allCampers.map(c => ({
                id: c.CamperID,
                label: c.LastName + ', ' + (c.PreferredName || c.FirstName),
                color: c.HomeGroupColor
            }))) %>,
            onSelect: () => document.getElementById('swapSearchForm').submit()
        });

        let currentOptions = [];
        let activeCamperId = '<%= camper ? camper.CamperID : "" %>';
        let activeCamperName = '<%= camper ? camper.FirstName + " " + camper.LastName : "" %>';
        let activePeriod = null;
        let activeFromActivity = null;

        async function loadOptions(camperId, period, element) {
            // UI Updates
            document.querySelectorAll('.period-card').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
            document.getElementById('controls-container').style.display = 'block';
            document.getElementById('placeholder-msg').style.display = 'none';

            activeFromActivity = element.querySelector('[data-activity]')?.dataset.activity || element.querySelector('div > div:last-child')?.textContent.trim() || '';
            activePeriod = period;

            // Fetch
            const res = await fetch(`/get-options/${camperId}/${period}`);
            const data = await res.json();
            currentOptions = data.options;

            const side = data.sideOfCamp ? ` · ${data.sideOfCamp}` : '';
            document.getElementById('side-indicator').innerText = `Options for Period ${period} (${data.colorGroup} Group${side})`;
            renderList();
        }

        function confirmSwap(newActivity, isFull) {
            let msg = `Confirm swap for ${activeCamperName} (Period ${activePeriod}):\n\n  From: ${activeFromActivity}\n  To:   ${newActivity}`;
            if (isFull) msg += '\n\nThis class is FULL — camper will be added to the waitlist.';
            return confirm(msg);
        }

        function renderList() {
            const term = document.getElementById('activitySearch').value.toLowerCase();
            const container = document.getElementById('options-container');

            const filtered = currentOptions.filter(opt => opt.Name.toLowerCase().includes(term));

            container.innerHTML = filtered.map(opt => {
                const isFull = opt.CurrentEnrollment >= opt.MaxCapacity;
                const statusClass = isFull ? 'option-full' : 'option-open';

                return `
                    <a href="/process-swap?camperId=${activeCamperId}&period=${activePeriod}&newActivity=${encodeURIComponent(opt.Name)}"
                       class="option-link ${statusClass}"
                       onclick="return confirmSwap('${opt.Name.replace(/'/g, "\\'")}', ${isFull})">
                        <div class="option-inner">
                            <div>
                                <strong>${opt.Name}</strong>
                                ${isFull ? '<br><small class="waitlist-warning">Will trigger waitlist</small>' : ''}
                            </div>
                            <div class="capacity-pill">${opt.CurrentEnrollment} / ${opt.MaxCapacity}</div>
                        </div>
                    </a>
                `;
            }).join('') || '<p>No activities found.</p>';
        }

        function filterActivities() { renderList(); }
    </script>
</body>
</html>